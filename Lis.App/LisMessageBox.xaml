<Window FontFamily="Simplified Arabic" x:Class="Lis.App.LisMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="510"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled"
        KeyDown="Window_KeyDown">

    <Grid Margin="18">
        <Border x:Name="OuterCard"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="30" Opacity="0.7" ShadowDepth="6" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Top Accent Strip -->
                    <RowDefinition Height="4"/>
                    <!-- Header Bar -->
                    <RowDefinition Height="48"/>
                    <!-- Content Body -->
                    <RowDefinition Height="Auto"/>
                    <!-- Action Bar -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 0. Top Accent Color Strip -->
                <Border Grid.Row="0" x:Name="AccentLine" Background="{DynamicResource PrimaryBrush}"/>

                <!-- 1. Header Bar (Draggable) -->
                <Border Grid.Row="1" Background="{DynamicResource SidebarBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown" Padding="16,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHeaderIcon" Text="💬" FontSize="17" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TxtTitle" Text="رسالة تنبيه" FontWeight="Bold" FontSize="15.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Close Button (Top Left in RTL) -->
                        <Button x:Name="BtnClose" HorizontalAlignment="Left" VerticalAlignment="Center" 
                                Width="28" Height="28" Cursor="Hand" Click="BtnClose_Click" Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bdr" Background="Transparent" CornerRadius="14">
                                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bdr" Property="Background" Value="#33EF4444"/>
                                            <Setter Property="Foreground" Value="#EF4444"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Content Body -->
                <Grid Grid.Row="2" Margin="22,20,22,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status Icon Badge -->
                    <Border Grid.Column="0" x:Name="IconContainer" Width="52" Height="52" CornerRadius="26" 
                            Background="#162E44" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1.5"
                            VerticalAlignment="Top" Margin="0,2,16,0">
                        <TextBlock x:Name="TxtBodyIcon" Text="ℹ️" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Message Text -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" MaxHeight="280">
                        <TextBlock x:Name="TxtMessage" Text="نص الرسالة" 
                                   TextWrapping="Wrap" 
                                   FontSize="14.5" 
                                   LineHeight="24" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   VerticalAlignment="Center"/>
                    </ScrollViewer>
                </Grid>

                <!-- 3. Bottom Action Bar -->
                <Border Grid.Row="3" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,12">
                    <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="BtnYes" Content="نعم (Yes)" Style="{DynamicResource PrimaryButtonStyle}" MinWidth="100" Margin="0,0,8,0" Click="BtnYes_Click"/>
                        <Button x:Name="BtnNo" Content="لا (No)" Style="{DynamicResource OutlineButtonStyle}" MinWidth="100" Margin="0,0,8,0" Click="BtnNo_Click"/>
                        <Button x:Name="BtnOK" Content="موافق (OK)" Style="{DynamicResource PrimaryButtonStyle}" MinWidth="100" Margin="0,0,8,0" Click="BtnOK_Click"/>
                        <Button x:Name="BtnCancel" Content="إلغاء (Cancel)" Style="{DynamicResource OutlineButtonStyle}" MinWidth="100" Click="BtnCancel_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
