<Window x:Class="Lis.App.ReportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="معاينة التقرير الطبي A4 - Medical Report Preview" 
        Height="850" Width="950"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Report Document Viewer Scroll Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP TOOLBAR -->
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📄 معاينة تقرير النتائج المخبرية (A4 Medical Report)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtOrderBadge" Text="#1001" Foreground="White" FontWeight="Bold" FontSize="12.5"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnPrintDirect" Content="🖨️ طباعة التقرير (Print)" Style="{DynamicResource PrimaryButtonStyle}" Padding="16,8" FontSize="13.5" Margin="0,0,10,0" Click="BtnPrintDirect_Click"/>
                    <Button x:Name="BtnClose" Content="إغلاق (Close)" Style="{DynamicResource OutlineButtonStyle}" Padding="14,8" FontSize="13.5" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DOCUMENT SCROLL VIEWER -->
        <ScrollViewer Grid.Row="1" Background="#475569" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="20">
            <Border x:Name="BorderDocumentHost" HorizontalAlignment="Center" VerticalAlignment="Top" 
                    Background="White" Effect="{DynamicResource DropShadowEffect}" Margin="10,10,10,30">
                <!-- Report visual element inserted dynamically -->
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
