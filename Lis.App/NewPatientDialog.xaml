<Window FontFamily="{StaticResource AppFontFamily}" x:Class="Lis.App.NewPatientDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="580"
        WindowStartupLocation="CenterOwner"
        FlowDirection="LeftToRight"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled">

    <Grid Margin="18">
        <Border Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource PrimaryBrush}"
                BorderThickness="1.5"
                CornerRadius="14"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" Opacity="0.75" ShadowDepth="6" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Top Accent Strip -->
                    <RowDefinition Height="4"/>
                    <!-- Header Bar -->
                    <RowDefinition Height="50"/>
                    <!-- Content Body -->
                    <RowDefinition Height="Auto"/>
                    <!-- Action Bar -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 0. Accent Strip -->
                <Border Grid.Row="0" Background="{DynamicResource SuccessBrush}"/>

                <!-- 1. Header Bar -->
                <Border Grid.Row="1" Background="{DynamicResource SidebarBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown" Padding="18,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👤" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="تسجيل مراجع جديد — طلب فحص مخبري" FontWeight="Bold" FontSize="15.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="أدخل بيانات المراجع أو اختر مريضاً مسجلاً مسبقاً للطلب" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Close Button -->
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="30" Height="30" Cursor="Hand" Click="BtnCancel_Click" Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bdr" Background="Transparent" CornerRadius="15">
                                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bdr" Property="Background" Value="#33EF4444"/>
                                            <Setter Property="Foreground" Value="#EF4444"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Content Body -->
                <Border Grid.Row="2" Padding="20,16">
                    <StackPanel>

                        <!-- Search Existing Patient -->
                        <TextBlock Text="🔍 البحث عن مراجع مسجل مسبقاً (اختياري):" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Height="40" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="TxtPatientSearch" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13.5" VerticalContentAlignment="Center"
                                         TextChanged="TxtPatientSearch_TextChanged"/>
                                <Button Grid.Column="2" x:Name="BtnClearSearch" Content="✕" Width="28" Height="28" Cursor="Hand" Visibility="Collapsed" Click="BtnClearSearch_Click" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <TextBlock Text="✕" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Search Results List (Appears when search query entered) -->
                        <Border x:Name="BorderSearchResults" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" MaxHeight="140" Margin="0,0,0,10" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ListBox x:Name="ListSearchResults" SelectionChanged="ListSearchResults_SelectionChanged" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,6" Margin="2" Background="{DynamicResource CardBrush}" CornerRadius="6" Cursor="Hand">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding FullNameAr}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Phone, StringFormat='الهاتف: {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{DynamicResource PrimaryBrush}" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Mrn, StringFormat='MRN: {0}'}" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </Border>

                        <!-- Selected Existing Patient Banner -->
                        <Border x:Name="BorderSelectedPatientBanner" Background="{DynamicResource CardHoverBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1.2" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🟢 مراجع مسجل مسبقاً:" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SuccessBrush}"/>
                                        <TextBlock x:Name="TxtBannerName" Text="" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtBannerMrn" Text="" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="✕ إلغاء التحديد" Style="{DynamicResource SecondaryButtonStyle}" Padding="10,4" FontSize="12" Click="BtnUnselectPatient_Click" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Permanent MRN Field -->
                        <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="رقم الملف الدائم (P.ID / MRN):" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtAssignedMrn" Text="تلقائي جديد (Auto)" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" FontSize="13.5"/>
                            </Grid>
                        </Border>

                        <!-- Patient Full Name -->
                        <TextBlock Text="الاسم الكامل بالعربية (مطلوب):" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPatientNameAr" Height="36" Margin="0,0,0,12" FontSize="13.5"/>

                        <!-- Gender & Date of Birth -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="الجنس (Gender):" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbPatientSex" Height="36">
                                    <ComboBoxItem Content="ذكر (Male)" IsSelected="True"/>
                                    <ComboBoxItem Content="أنثى (Female)"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="تاريخ الميلاد (DOB):" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <DatePicker x:Name="DpDateOfBirth" Height="36" CalendarStyle="{StaticResource ModernCalendarStyle}" SelectedDateChanged="DpDateOfBirth_SelectedDateChanged"/>
                            </StackPanel>
                        </Grid>

                        <!-- Calculated Age Display -->
                        <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="العمر المحسوب (Calculated Age):" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCalculatedAge" Text="-- سنة" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" FontSize="13.5"/>
                            </Grid>
                        </Border>

                        <!-- Phone & Referring Doctor -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="رقم الهاتف (Phone):" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtPatientPhone" Height="36" FontSize="13.5"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="الطبيب المحول (Referring Doctor):" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtReferringDoctor" Height="36" FontSize="13.5"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- 3. Action Bar -->
                <Border Grid.Row="3" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="✕ إلغاء" Style="{DynamicResource SecondaryButtonStyle}" Height="38" Padding="20,0" FontSize="13" Click="BtnCancel_Click"/>

                        <Button Grid.Column="2" x:Name="BtnProceedToTests" Content="📋 متابعة وإضافة التحاليل للطلب ➔" Style="{DynamicResource SuccessButtonStyle}" Height="38" Padding="24,0" FontSize="13.5" FontWeight="Bold" Click="BtnProceedToTests_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
