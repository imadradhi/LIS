<Window x:Class="Lis.App.AddTestsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="Simplified Arabic"
        Title="إضافة التحاليل للطلب"
        Width="1020" Height="700"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        FlowDirection="LeftToRight"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header -->
            <RowDefinition Height="*"/>      <!-- Body -->
            <RowDefinition Height="Auto"/>   <!-- Footer actions -->
        </Grid.RowDefinitions>

        <!-- ══ HEADER ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="10" Background="{DynamicResource PrimaryBrush}" Margin="0,0,14,0">
                        <TextBlock Text="🧪" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtDialogTitle" Text="إضافة التحاليل — مريض جديد" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="TxtPatientSubtitle" Text="اختر التحاليل المطلوبة للطلب وحفظها للبدء بسحب العينات (المحاسبة لاحقاً من شاشة التفاصيل)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Content="✕ إغلاق" VerticalAlignment="Center"
                        Style="{DynamicResource OutlineButtonStyle}" Padding="16,7" FontSize="12.5"
                        Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- ══ BODY ══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="18,14,18,10">
            <Grid.ColumnDefinitions>
                <!-- Tests catalog (right in RTL, takes remaining space) -->
                <ColumnDefinition Width="*"/>
                <!-- Order summary & payment (left in RTL, fixed width) -->
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- ── RIGHT (Column 0 in RTL): Test Catalog ────────────────────── -->
            <Border Grid.Column="0" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Margin="0,0,14,0" Padding="0">
                <DockPanel>

                    <!-- Catalog Header + Search -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}"
                            CornerRadius="11,11,0,0" Padding="16,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🧪 كتالوج التحاليل المتاحة" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="{DynamicResource PrimaryBrush}" CornerRadius="8" Padding="12,3" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSelectedCount" Text="0 تحليل محدد" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>
                            </Grid>

                            <!-- Search -->
                            <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Height="40">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="TxtTestSearch" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalContentAlignment="Center"
                                             TextChanged="TxtTestSearch_TextChanged"/>
                                    <Button Grid.Column="2" x:Name="BtnClearTestSearch" Content="✕ مسح" Width="55" Cursor="Hand"
                                            Visibility="Collapsed" Click="BtnClearTestSearch_Click" VerticalAlignment="Center" Margin="0,0,6,0"
                                            Style="{DynamicResource OutlineButtonStyle}" Padding="0" Height="26" FontSize="11"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Tests DataGrid -->
                    <DataGrid x:Name="GridTests"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="False" SelectionMode="Single"
                              HeadersVisibility="Column" BorderThickness="0"
                              SelectionChanged="GridTests_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="تحديد" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                            <DataGridTextColumn Header="كود الفحص" Binding="{Binding TestCode}" IsReadOnly="True" FontWeight="Bold" Width="100"/>
                            <DataGridTextColumn Header="اسم التحليل" Binding="{Binding NameAr}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="نوع العينة / الأنبوب" Binding="{Binding SpecimenTypeName}" IsReadOnly="True" Width="140"/>
                            <DataGridTextColumn Header="السعر" Binding="{Binding FormattedPrice}" IsReadOnly="True" FontWeight="Bold" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                </DockPanel>
            </Border>

            <!-- ── LEFT (Column 1 in RTL): Order Summary + Payment ─────────── -->
            <Border Grid.Column="1" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="0">
                <DockPanel>

                    <!-- Summary Header -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource SidebarBrush}"
                            CornerRadius="11,11,0,0" Padding="16,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="📋 ملخص التحاليل المطلوبة" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
                        <StackPanel>

                            <!-- Selected Tests List -->
                            <TextBlock Text="التحاليل المختارة:" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <ItemsControl x:Name="ListSelectedTests">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding NameAr}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FormattedPrice}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty notice -->
                            <Border x:Name="BorderNoTests" Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                                <TextBlock Text="لم تُحدَّد أي تحاليل بعد" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                            </Border>

                            <!-- Separator -->
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,8,0,10"/>

                            <!-- Total -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="إجمالي التحاليل:" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="TxtTotal" Text="0 IQD" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Discount -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="الخصم (Discount):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="TxtDiscount" Text="0" Height="34" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="13" FontWeight="Bold" TextChanged="BillingInputs_Changed"/>
                            </Grid>

                            <!-- Net -->
                            <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="12,9" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="الصافي المطلوب:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtNet" Text="0 IQD" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Info Notice -->
                            <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="12,10" Margin="0,6,0,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="💡" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="ملاحظة المحاسبة:" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="يتم تسجيل وقبض الدفعات وطباعة وصل الكاشير لاحقاً من شاشة تفاصيل الطلب." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="17"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ══ FOOTER ACTIONS ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="❌ إلغاء الطلب" Style="{DynamicResource DangerButtonStyle}"
                        Padding="18,9" FontSize="13" Click="BtnCancel_Click"/>

                <TextBlock Grid.Column="1" x:Name="TxtStatusMsg" Text="" FontSize="12.5" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="16,0"/>

                <Button Grid.Column="2" x:Name="BtnSaveOrder" Content="✅ حفظ الطلب وإضافة التحاليل"
                        Style="{DynamicResource SuccessButtonStyle}" Padding="24,9" FontSize="14" FontWeight="Bold"
                        Click="BtnSaveOrder_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
