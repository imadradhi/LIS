<Window FontFamily="{StaticResource AppFontFamily}" x:Class="Lis.App.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="490"
        WindowStartupLocation="CenterOwner"
        FlowDirection="LeftToRight"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled"
        KeyDown="Window_KeyDown">

    <Grid Margin="18">
        <Border Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource PrimaryBrush}"
                BorderThickness="1.5"
                CornerRadius="14"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" Opacity="0.7" ShadowDepth="6" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Top Accent Strip -->
                    <RowDefinition Height="4"/>
                    <!-- Header Bar -->
                    <RowDefinition Height="48"/>
                    <!-- Content Body -->
                    <RowDefinition Height="Auto"/>
                    <!-- Action Bar -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 0. Accent Strip -->
                <Border Grid.Row="0" Background="{DynamicResource SuccessBrush}"/>

                <!-- 1. Header Bar -->
                <Border Grid.Row="1" Background="{DynamicResource SidebarBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown" Padding="16,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💳" FontSize="17" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TxtTitle" Text="قبض دفعة مالية - قاصة الكاشير" FontWeight="Bold" FontSize="15.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Close Button -->
                        <Button HorizontalAlignment="Left" VerticalAlignment="Center" Width="28" Height="28" Cursor="Hand" Click="BtnCancel_Click" Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bdr" Background="Transparent" CornerRadius="14">
                                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bdr" Property="Background" Value="#33EF4444"/>
                                            <Setter Property="Foreground" Value="#EF4444"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Content Body -->
                <StackPanel Grid.Row="2" Margin="20,18,20,16">
                    <!-- Invoice & Patient Info Summary -->
                    <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TxtInvoiceInfo" Grid.Row="0" Text="فاتورة رقم: #1001" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock x:Name="TxtPatientInfo" Grid.Row="1" Text="المريض: محمد أحمد | المتبقي بذمته: 25,000 IQD" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Amount To Pay -->
                    <TextBlock Text="المبلغ المراد قبضه وتسجيله في القاصة (IQD):" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Height="44" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="💰" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TxtAmount" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" FontSize="17" FontWeight="Bold" VerticalContentAlignment="Center" Margin="4,0"/>
                            <TextBlock Grid.Column="2" Text="د.ع (IQD)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        </Grid>
                    </Border>

                    <!-- Payment Method: Cash or Card -->
                    <TextBlock Text="طريقة الدفع (Payment Method):" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cash Option -->
                        <RadioButton x:Name="RbCash" Grid.Column="0" GroupName="PaymentMethodGroup" IsChecked="True"
                                     Margin="0,0,6,0" Cursor="Hand" Checked="RbCash_Checked">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="bdr" Background="#162E2A" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="2" CornerRadius="8" Padding="14,10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="💵" FontSize="17" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="نقداً (Cash)" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="bdr" Property="Background" Value="{DynamicResource InputBrush}"/>
                                            <Setter TargetName="bdr" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                            <Setter TargetName="bdr" Property="BorderThickness" Value="1"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bdr" Property="Background" Value="#1A10B981"/>
                                            <Setter TargetName="bdr" Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                            <Setter TargetName="bdr" Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bdr" Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Card Option -->
                        <RadioButton x:Name="RbCard" Grid.Column="1" GroupName="PaymentMethodGroup" IsChecked="False"
                                     Margin="6,0,0,0" Cursor="Hand" Checked="RbCard_Checked">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="bdr" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="💳" FontSize="17" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="كارت (Card)" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bdr" Property="Background" Value="#1A38BDF8"/>
                                            <Setter TargetName="bdr" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="bdr" Property="BorderThickness" Value="2"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bdr" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </Grid>

                    <!-- Cashier Till Notice -->
                    <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💼 القاصة المستلمة:" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtCashierTill" Text="قاصة المدير (admin)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBlock Text="• سيتم إصدار وصل 8 سم تلقائياً" FontSize="12.5" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 3. Bottom Action Bar -->
                <Border Grid.Row="3" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="BtnConfirm" Content="تأكيد الدفع وطباعة الوصل 🧾" Style="{DynamicResource SuccessButtonStyle}" MinWidth="200" Padding="16,9" FontSize="14" Margin="0,0,10,0" Click="BtnConfirm_Click"/>
                        <Button Content="إلغاء (Cancel)" Style="{DynamicResource OutlineButtonStyle}" MinWidth="95" Padding="14,9" FontSize="14" Click="BtnCancel_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

