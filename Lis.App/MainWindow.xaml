                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="اسم الجهاز (Name):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtInstName" Height="34"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Protocol + Mode -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="البروتوكول (Protocol):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="CmbInstProtocol" Height="34">
                                                <ComboBoxItem Content="ASTM" IsSelected="True"/>
                                                <ComboBoxItem Content="HL7"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="نمط التشغيل (Mode):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="CmbInstOperatingMode" Height="34">
                                                <ComboBoxItem Content="Bidirectional" IsSelected="True"/>
                                                <ComboBoxItem Content="ResultsOnly"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Connection Type Selector -->
                                    <TextBlock Text="نوع الاتصال الفعلي (Connection Type):" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RbConnTcp" Content="🌐 شبكة TCP/IP" IsChecked="True" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,24,0" Checked="RbConnType_Checked"/>
                                            <RadioButton x:Name="RbConnSerial" Content="🔌 منفذ RS-232 Serial" Foreground="#FFFFFF" FontWeight="SemiBold" Checked="RbConnType_Checked"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- PANEL A: TCP/IP Settings -->
                                    <Border x:Name="PanelTcpSettings" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="🌐 معلمات شبكة TCP/IP" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="وضع الاتصال (Mode):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="CmbInstTcpMode" Height="34">
                                                        <ComboBoxItem Content="Server" IsSelected="True"/>
                                                        <ComboBoxItem Content="Client"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="المنفذ (Port):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <TextBox x:Name="TxtInstPort" Text="5100" Height="34"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="عنوان IP (Host IP):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtInstHost" Text="0.0.0.0" Height="34"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- PANEL B: RS-232 Serial Settings -->
                                    <Border x:Name="PanelSerialSettings" Visibility="Collapsed" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="🔌 معلمات المنفذ التسلسلي RS-232" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,8"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <TextBlock Text="منفذ COM Port:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <TextBox x:Name="TxtInstComPort" Text="COM1" Height="34"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                    <TextBlock Text="معدل النقل (Baud Rate):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="CmbInstBaud" Height="34">
                                                        <ComboBoxItem Content="9600" IsSelected="True"/>
                                                        <ComboBoxItem Content="19200"/>
                                                        <ComboBoxItem Content="38400"/>
                                                        <ComboBoxItem Content="115200"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                    <TextBlock Text="Data Bits:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <TextBox x:Name="TxtInstDataBits" Text="8" Height="34"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                                    <TextBlock Text="Parity:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="CmbInstParity" Height="34">
                                                        <ComboBoxItem Content="None" IsSelected="True"/>
                                                        <ComboBoxItem Content="Even"/>
                                                        <ComboBoxItem Content="Odd"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                                    <TextBlock Text="Stop Bits:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="CmbInstStopBits" Height="34">
                                                        <ComboBoxItem Content="One" IsSelected="True"/>
                                                        <ComboBoxItem Content="Two"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="Flow Control:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="CmbInstFlowControl" Height="34">
                                                <ComboBoxItem Content="None" IsSelected="True"/>
                                                <ComboBoxItem Content="RequestToSend"/>
                                                <ComboBoxItem Content="XOnXOff"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Border>

                                    <CheckBox x:Name="ChkInstActive" Content="✅ الجهاز مفعل (Active)" IsChecked="True" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,0,0,14"/>

                                    <!-- Test, Save & Delete Buttons -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="🔌 اختبار الاتصال (Test)" Style="{DynamicResource OutlineButtonStyle}" Height="40" Margin="0,0,6,0" Click="BtnTestInstrumentConnection_Click"/>
                                        <Button Grid.Column="1" Content="💾 حفظ الإعدادات (Save)" Style="{DynamicResource PrimaryButtonStyle}" Height="40" Margin="0,0,6,0" Click="BtnSaveInstrument_Click"/>
                                        <Button Grid.Column="2" x:Name="BtnDeleteInstrument" Content="🗑️ حذف الجهاز" Style="{DynamicResource DangerButtonStyle}" Height="40" Padding="14,0" Click="BtnDeleteInstrument_Click" ToolTip="حذف الجهاز المحدد نهائياً من النظام"/>
                                    </Grid>

                                    <!-- Live Test Connection Banner -->
                                    <Border x:Name="BorderTestResult" Visibility="Collapsed" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                                        <TextBlock x:Name="TxtTestResult" FontSize="12" FontWeight="Bold" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>


