                        <!-- BOTTOM: Three columns -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ═══ TOP: Page Header ══════════════════════════════════════════════════ -->
                    <!-- ═══ TOP: Page Header ══════════════════════════════════════════════════ -->
