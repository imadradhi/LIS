                                        <DataGridTextColumn Header="اسم الجهاز" Binding="{Binding name}" Width="*"/>
                                        <DataGridTextColumn Header="نوع الاتصال" Binding="{Binding connection_type}" Width="95"/>
                                        <DataGridTextColumn Header="المنفذ" Binding="{Binding port_display}" Width="95"/>
                                        <DataGridTextColumn Header="الحالة" Binding="{Binding status_text}" FontWeight="Bold" Width="85"/>
