<Window x:Class="Lis.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="نظام إدارة المختبرات الطبية - Laboratory Information System (LIS Interface)" 
        Icon="Assets/app_icon.ico"
        Height="900" Width="1440"
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="LeftToRight"
        FontFamily="Simplified Arabic"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Bar -->
            <RowDefinition Height="68"/>
            <!-- Main Work Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP APP BAR -->
        <Border Grid.Row="0" Background="{DynamicResource TopBarBrush}" BorderBrush="{DynamicResource TopBarBorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Lab Logo & Branding -->
                    <ColumnDefinition Width="Auto" MinWidth="280"/>
                    <!-- Center: Quick Scan Barcode -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right: User Profile & Status -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 1. Lab Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="11" Background="#0B132B" BorderBrush="#0284C7" BorderThickness="1.2" Margin="0,0,14,0" ClipToBounds="True">
                        <Image Source="Assets/logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="2"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHeaderLabName" Text="مختبر التحليلات الطبية التخصصي (Medical Lab)" FontWeight="Bold" FontSize="16.5" Foreground="{DynamicResource TopBarTextPrimaryBrush}"/>
                        <TextBlock Text="Laboratory Information System (LIS Interface)" FontSize="12.5" Foreground="{DynamicResource TopBarTextSecondaryBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <!-- 2. Quick Scan Barcode Input (Scanner / Keyboard) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="{DynamicResource TopBarCardBrush}" CornerRadius="8" Padding="12,5" BorderBrush="{DynamicResource TopBarBorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📷 مسح الباركود (Scan Barcode):" Foreground="{DynamicResource TopBarTextSecondaryBrush}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="TxtQuickScan" Width="160" Height="36" FontSize="16" FontWeight="Bold" 
                                     Background="{DynamicResource InputBrush}" Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     ToolTip="امسح باركود العينة المكون من 6 أرقام بالماسح الضوئي أو اكتب واضغط Enter"
                                     KeyDown="TxtQuickScan_KeyDown"/>
                            <Button Content="بحث (Search)" Style="{DynamicResource PrimaryButtonStyle}" Height="36" Padding="14,2" Margin="8,0,0,0" Click="BtnQuickScan_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 3. User Profile, Theme & Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Theme Selector Toggle -->
                    <Border Background="{DynamicResource TopBarCardBrush}" BorderBrush="{DynamicResource TopBarBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,2" Margin="0,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎨" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbTopTheme" Width="210" Height="34" FontSize="13" SelectionChanged="CmbTopTheme_SelectionChanged">
                                <ComboBoxItem Tag="BiotechDark"  Content="🧬 Biotech Dark Mode" IsSelected="True"/>
                                <ComboBoxItem Tag="CleanWhite"   Content="🏥 Medical Clean White"/>
                                <ComboBoxItem Tag="RoyalBlue"    Content="💎 Clinical Royal Blue"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0" HorizontalAlignment="Right">
                        <TextBlock x:Name="TxtCurrentUserName" Text="مدير النظام (Admin)" FontWeight="Bold" Foreground="{DynamicResource TopBarTextPrimaryBrush}" FontSize="14.5" HorizontalAlignment="Right"/>
                        <TextBlock Text="متصل (Connected) - PostgreSQL" FontSize="12" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Button Content="خروج (Logout)" Style="{DynamicResource DangerButtonStyle}" Padding="13,7" FontSize="13" Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN WORK AREA -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Navigation Sidebar (Left) -->
                <ColumnDefinition Width="250" MinWidth="210"/>
                <!-- Content Area (Right) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- NAVIGATION SIDEBAR -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="14,18">
                <DockPanel>
                    <!-- Nav Items -->
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="القائمة الرئيسية (Navigation)" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,12"/>
                        <RadioButton x:Name="NavRegistration" Style="{DynamicResource NavButtonStyle}" Content="📝  تسجيل طلب (New Order)" IsChecked="True" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavWorklist" Style="{DynamicResource NavButtonStyle}" Content="🔬  قائمة العمل (Worklist)" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavResults" Style="{DynamicResource NavButtonStyle}" Content="📊  النتائج والتقارير (Results)" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavTests" Style="{DynamicResource NavButtonStyle}" Content="🧪  التحليلات (Tests Catalog)" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavBilling" Style="{DynamicResource NavButtonStyle}" Content="💰  المالية واليومية (Billing)" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavInstruments" Style="{DynamicResource NavButtonStyle}" Content="📡  أجهزة التحليل (Instruments)" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSettings" Style="{DynamicResource NavButtonStyle}" Content="⚙️  إعدادات المختبر (Settings)" Checked="Nav_Checked"/>
                    </StackPanel>

                    <!-- Footer Info in Sidebar -->
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="العملة المعتمدة (Currency):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TxtCurrencyBadge" Text="دينار عراقي (IQD)" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FontSize="14" Margin="0,3,0,0"/>
                            <TextBlock Text="إصدار النظام: LIS v1.0.0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- CONTENT VIEWS -->
            <Grid Grid.Column="1" Margin="20">

                                <!-- ========================================================================= -->
                <!-- 1. VIEW: RECEPTION (الاستقبال - بيانات المريض + سجل الطلبات)               -->
                <!-- ========================================================================= -->
                <Grid x:Name="ViewRegistration" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.38*" MinWidth="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ═══ LEFT: Patient Search / New Form ═══════════════════════════════ -->
                    <Grid Grid.Column="0" Margin="0,0,14,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12,12,0,0" Padding="16,12" Margin="0,0,0,2">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="👤" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="استقبال المراجعين" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="ابحث عن مريض أو سجّل مراجعاً جديداً" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button x:Name="BtnNewPatient" Content="➕ مراجع جديد" Style="{DynamicResource SuccessButtonStyle}" HorizontalAlignment="Right" Padding="14,6" FontSize="13" Click="BtnNewPatient_Click"/>
                            </Grid>
                        </Border>

                        <!-- Scrollable Form -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,1,1" CornerRadius="0,0,12,12" Padding="16,14">
                                <StackPanel>

                                    <!-- Search Bar -->
                                    <TextBlock Text="🔍 البحث بالاسم أو الباركود أو الهاتف" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                    <Border x:Name="PatientSearchBoxBorder" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="10" Height="44" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="36"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🔍" FontSize="16" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" x:Name="TxtSearchWatermark" Text="ابحث بالاسم أو الهاتف أو الباركود..." FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False"/>
                                            <TextBox Grid.Column="1" x:Name="TxtPatientSearch" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" VerticalContentAlignment="Center" Margin="2,0,0,0"
                                                     TextChanged="TxtPatientSearch_TextChanged" PreviewKeyDown="TxtPatientSearch_PreviewKeyDown" GotFocus="TxtPatientSearch_GotFocus" LostFocus="TxtPatientSearch_LostFocus"/>
                                            <Button Grid.Column="2" x:Name="BtnClearSearch" Content="✕" Width="24" Height="24" Cursor="Hand" Visibility="Collapsed" Click="BtnClearSearch_Click" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="مسح البحث">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bdr" Background="Transparent" CornerRadius="12">
                                                            <TextBlock Text="{TemplateBinding Content}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bdr" Property="Background" Value="#33FFFFFF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Grid.Column="3" x:Name="BtnTogglePatientDropdown" Width="36" Height="42" Cursor="Hand" Click="BtnTogglePatientDropdown_Click" ToolTip="عرض القائمة">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bdr" Background="Transparent" CornerRadius="0,9,9,0">
                                                            <TextBlock Text="▼" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bdr" Property="Background" Value="#2238BDF8"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Dropdown Popup -->
                                    <Popup x:Name="PopupPatientSearch" PlacementTarget="{Binding ElementName=PatientSearchBoxBorder}" Placement="Bottom" IsOpen="False" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1.5" CornerRadius="10" Width="420" MaxHeight="340" Margin="0,4,0,0">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="24" Opacity="0.75" ShadowDepth="6" Direction="270"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" Background="{DynamicResource SidebarBrush}" Padding="12,8" CornerRadius="9,9,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="👥 المرضى المسجلون" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="8" Padding="7,2" Margin="8,0,0,0">
                                                                <TextBlock x:Name="TxtPatientCountBadge" Text="0 مريض" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="اختر بالضغط أو الأسهم" HorizontalAlignment="Right" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="240" Padding="8">
                                                    <StackPanel>
                                                        <Border x:Name="BorderEmptyPatients" Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="14,12" Visibility="Collapsed" Margin="0,4">
                                                            <StackPanel HorizontalAlignment="Center">
                                                                <TextBlock Text="🔍 لا توجد نتائج مطابقة" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="يمكنك تسجيل مراجع جديد أو تعديل البحث" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <ListBox x:Name="ListPatientDropdown" SelectionChanged="ListPatientDropdown_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                            <ListBox.ItemContainerStyle>
                                                                <Style TargetType="ListBoxItem">
                                                                    <Setter Property="Padding" Value="0"/>
                                                                    <Setter Property="Margin" Value="0"/>
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                                <Border x:Name="itemBorder" Background="Transparent" CornerRadius="8">
                                                                                    <ContentPresenter/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="itemBorder" Property="Background" Value="#1A38BDF8"/>
                                                                                    </Trigger>
                                                                                    <Trigger Property="IsSelected" Value="True">
                                                                                        <Setter TargetName="itemBorder" Property="Background" Value="#2E0284C7"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </ListBox.ItemContainerStyle>
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6" Cursor="Hand">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="{Binding GenderBadgeBg}" BorderBrush="{Binding GenderBadgeBorder}" BorderThickness="1.5" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                                <TextBlock Text="{Binding GenderEmoji}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding FullNameAr}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                                <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                                            </StackPanel>
                                                                            <Border Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="8,3" VerticalAlignment="Center" Margin="6,0,0,0">
                                                                                <TextBlock Text="{Binding Mrn, StringFormat='P.ID: {0}'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </StackPanel>
                                                </ScrollViewer>
                                                <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}" Padding="10,6" CornerRadius="0,0,9,9" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                                                    <Button Content="➕ تسجيل مراجع جديد" Style="{DynamicResource OutlineButtonStyle}" HorizontalAlignment="Stretch" Padding="8,5" FontSize="12.5" Click="BtnNewPatient_Click"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Popup>

                                    <!-- Selected Patient Banner -->
                                    <Border x:Name="BorderSelectedPatientBanner" Background="{DynamicResource CardHoverBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,4,0,10" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🟢 مريض مسجل:" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource SuccessBrush}"/>
                                                    <TextBlock x:Name="TxtSelectedPatientName" Text="" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtSelectedPatientMrn" Text="" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="✕ إلغاء" Style="{DynamicResource OutlineButtonStyle}" Padding="8,4" FontSize="12" Click="BtnUnselectPatient_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- MRN -->
                                    <Border Background="{DynamicResource InputBrush}" CornerRadius="6" Padding="10,7" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="رقم الملف الدائم (P.ID / MRN):" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtAssignedMrn" Text="تلقائي جديد (Auto)" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" FontSize="13.5"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="الاسم الكامل بالعربية:" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBox x:Name="TxtPatientNameAr" Margin="0,4,0,10"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="الجنس (Gender):" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <ComboBox x:Name="CmbPatientSex" Margin="0,4,0,0">
                                                <ComboBoxItem Content="ذكر (Male)" IsSelected="True"/>
                                                <ComboBoxItem Content="أنثى (Female)"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="تاريخ الميلاد (DOB):" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <DatePicker x:Name="DpDateOfBirth" Margin="0,4,0,0" CalendarStyle="{StaticResource ModernCalendarStyle}" SelectedDateChanged="DpDateOfBirth_SelectedDateChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="{DynamicResource InputBrush}" CornerRadius="6" Padding="10,7" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="العمر المحسوب (Age):" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtCalculatedAge" Text="-- سنة" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" FontSize="13.5"/>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="BorderDuplicateWarning" Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10" Visibility="Collapsed">
                                        <TextBlock Text="⚠️ مريض محتمل مسجل مسبقاً بنفس الاسم وتاريخ الميلاد" Foreground="#FCA5A5" FontSize="12.5" TextWrapping="Wrap"/>
                                    </Border>

                                    <TextBlock Text="رقم الهاتف (Phone):" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBox x:Name="TxtPatientPhone" Margin="0,4,0,10"/>

                                    <TextBlock Text="الطبيب المحول (Referring Doctor):" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBox x:Name="TxtReferringDoctor" Margin="0,4,0,16"/>

                                    <!-- PRIMARY ACTION -->
                                    <Button x:Name="BtnCreateOrder" Content="📋 تسجيل الطلب وإضافة التحاليل" Style="{DynamicResource SuccessButtonStyle}" Height="48" FontSize="15" FontWeight="Bold" Click="BtnCreateOrder_Click"/>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>

                    <!-- ═══ RIGHT: Orders List ════════════════════════════════════════════ -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Filter Bar -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="145"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="بحث:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                                <Border Grid.Column="1" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Height="34">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="TxtOrdersSearch" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13.5" VerticalContentAlignment="Center" ToolTip="ابحث برقم الطلب أو اسم المريض..." TextChanged="TxtOrdersFilter_Changed"/>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Column="2" Text="الحالة:" VerticalAlignment="Center" Margin="10,0,8,0" FontWeight="SemiBold"/>
                                <ComboBox Grid.Column="3" x:Name="CmbOrdersStatusFilter" SelectionChanged="CmbOrdersStatusFilter_Changed">
                                    <ComboBoxItem Content="الكل (All)" IsSelected="True"/>
                                    <ComboBoxItem Content="Ordered"/>
                                    <ComboBoxItem Content="Collected"/>
                                    <ComboBoxItem Content="InProgress"/>
                                    <ComboBoxItem Content="Validated"/>
                                </ComboBox>
                                <TextBlock Grid.Column="4" Text="التاريخ:" VerticalAlignment="Center" Margin="10,0,8,0" FontWeight="SemiBold"/>
                                <DatePicker Grid.Column="5" x:Name="DpOrdersDateFilter" CalendarStyle="{StaticResource ModernCalendarStyle}" SelectedDateChanged="DpOrdersDateFilter_SelectedDateChanged"/>
                                <Button Grid.Column="7" Content="🔄 تحديث" Style="{DynamicResource OutlineButtonStyle}" Padding="13,6" FontSize="13" Click="BtnRefreshOrders_Click"/>
                            </Grid>
                        </Border>

                        <!-- Orders DataGrid -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="0">
                            <DataGrid x:Name="GridOrders" AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                                      BorderThickness="0"
                                      MouseDoubleClick="GridOrders_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding id}" Width="55"/>
                                    <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding order_datetime, StringFormat='dd/MM/yyyy HH:mm'}" Width="145"/>
                                    <DataGridTextColumn Header="اسم المريض" Binding="{Binding full_name_ar}" Width="190"/>
                                    <DataGridTextColumn Header="P.ID" Binding="{Binding mrn}" Width="80"/>
                                    <DataGridTextColumn Header="الهاتف" Binding="{Binding phone}" Width="110"/>
                                    <DataGridTextColumn Header="الحالة" Binding="{Binding status}" FontWeight="Bold" Width="105"/>
                                    <DataGridTextColumn Header="أنابيب" Binding="{Binding specimen_count}" Width="65"/>
                                    <DataGridTextColumn Header="المبلغ" Binding="{Binding total_amount, StringFormat='#,##0'}" FontWeight="Bold" Width="105"/>
                                    <DataGridTextColumn Header="الفاتورة" Binding="{Binding invoice_status}" Width="90"/>
                                    <DataGridTemplateColumn Header="الإجراءات" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="📋 فتح" Style="{DynamicResource OutlineButtonStyle}" Padding="9,4" FontSize="12" Margin="0,0,4,0" Click="BtnViewOrderDetails_Click" ToolTip="تفاصيل الطلب والحسابات"/>
                                                    <Button Content="📊 النتائج" Style="{DynamicResource PrimaryButtonStyle}" Padding="9,4" FontSize="12" Click="BtnOrderViewResults_Click" ToolTip="عرض واعتماد نتائج التحاليل والتقرير"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Grid>


                <!-- 3. VIEW: WORKLIST (قائمة عمل الأقسام)                                     -->
                <!-- ========================================================================= -->
                <Grid x:Name="ViewWorklist" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Bar -->
                    <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Margin="0,0,0,14" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="القسم (Department):" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                            <ComboBox Grid.Column="1" x:Name="CmbWorklistDept" Height="36" SelectionChanged="CmbWorklistFilter_Changed">
                                <ComboBoxItem Content="جميع الأقسام (All)" IsSelected="True"/>
                                <ComboBoxItem Content="Hematology (أمراض الدم)"/>
                            </ComboBox>

                            <TextBlock Grid.Column="2" Text="حالة الأنبوب (Status):" VerticalAlignment="Center" Margin="16,0,8,0" FontWeight="SemiBold"/>
                            <ComboBox Grid.Column="3" x:Name="CmbWorklistStatus" Height="36" SelectionChanged="CmbWorklistFilter_Changed">
                                <ComboBoxItem Tag="" Content="جميع الحالات (All)" IsSelected="True"/>
                                <ComboBoxItem Tag="Ordered" Content="بانتظار الاستلام (Ordered)"/>
                                <ComboBoxItem Tag="Collected" Content="تم الاستلام (Collected)"/>
                                <ComboBoxItem Tag="InProgress" Content="قيد الفحص (InProgress)"/>
                                <ComboBoxItem Tag="ResultReceived" Content="تم استلام النتائج (ResultReceived)"/>
                                <ComboBoxItem Tag="Validated" Content="معتمدة (Validated)"/>
                                <ComboBoxItem Tag="Rejected" Content="مرفوضة (Rejected)"/>
                            </ComboBox>

                            <Button Grid.Column="5" Content="تحديث القائمة (Refresh 🔄)" Style="{DynamicResource SecondaryButtonStyle}" Height="36" Padding="14,0" FontSize="13" Click="BtnRefreshWorklist_Click"/>
                        </Grid>
                    </Border>

                    <!-- Worklist DataGrid (No Horizontal or Side Scrollbars, Smooth Mouse Wheel Scroll) -->
                    <DataGrid Grid.Row="1" x:Name="GridWorklist" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="باركود الأنبوب (Accession)" Binding="{Binding accession_no}" FontWeight="Bold" Width="140"/>
                            <DataGridTextColumn Header="نوع الأنبوب (Tube Type)" Binding="{Binding specimen_type_name}" Width="130"/>
                            <DataGridTextColumn Header="الفحوصات المطلوبة (Tests)" Binding="{Binding test_names}" FontWeight="SemiBold" Width="2*"/>
                            <DataGridTextColumn Header="اسم المريض (Patient Name)" Binding="{Binding full_name_ar}" Width="170"/>
                            <DataGridTextColumn Header="MRN" Binding="{Binding mrn}" Width="85"/>
                            <DataGridTextColumn Header="الحالة (Status)" Binding="{Binding specimen_status}" FontWeight="Bold" Width="120"/>
                            <DataGridTextColumn Header="وقت الاستلام (Collected At)" Binding="{Binding collected_at, StringFormat='dd/MM/yyyy HH:mm'}" Width="135"/>
                            <DataGridTemplateColumn Header="إجراء سريع" Width="165">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Receive / Collect -->
                                            <Button Content="📥" ToolTip="استلام العينة (Collect)" Style="{DynamicResource SecondaryButtonStyle}" Width="34" Height="30" FontSize="13" Padding="0" Margin="0,0,5,0" Click="BtnWorklistCollect_Click"/>
                                            <!-- Print Barcode -->
                                            <Button Content="🖨️" ToolTip="طباعة باركود الأنبوب (Print Barcode)" Style="{DynamicResource SecondaryButtonStyle}" Width="34" Height="30" FontSize="13" Padding="0" Margin="0,0,5,0" Click="BtnWorklistPrintLabel_Click"/>
                                            <!-- Reject -->
                                            <Button Content="✕" ToolTip="رفض العينة (Reject)" Style="{DynamicResource SecondaryButtonStyle}" Width="34" Height="30" FontSize="13" FontWeight="Bold" Padding="0" Margin="0,0,5,0" Click="BtnWorklistReject_Click"/>
                                            <!-- Results -->
                                            <Button Content="📊" ToolTip="عرض وإدخال النتائج (Results)" Style="{DynamicResource SecondaryButtonStyle}" Width="34" Height="30" FontSize="13" Padding="0" Click="BtnWorklistViewResults_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ========================================================================= -->
                <!-- VIEW: RESULTS, VALIDATION & REPORTS (النتائج والاعتماد والتقارير الطبية)     -->
                <!-- ========================================================================= -->
                <Grid x:Name="ViewResults" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <!-- Left Panel: Orders List (Master) -->
                        <ColumnDefinition Width="380" MinWidth="320"/>
                        <!-- Right Panel: Results & Actions (Detail) -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ═══ LEFT PANEL: ORDERS LIST ════════════════════════════════════════ -->
                    <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Margin="0,0,14,0" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Title & Refresh -->
                                <RowDefinition Height="Auto"/> <!-- Search & Filter -->
                                <RowDefinition Height="*"/>    <!-- DataGrid -->
                            </Grid.RowDefinitions>

                            <!-- Title -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="📋 طلبات الفحص والنتائج" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="🔄 تحديث" Style="{DynamicResource OutlineButtonStyle}" Padding="10,4" FontSize="12" Click="BtnRefreshResultsOrders_Click" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <!-- Filters -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                <TextBox x:Name="TxtResultsOrderSearch" Height="36" Style="{DynamicResource SearchTextBoxStyle}" 
                                         Tag="بحث باسم المريض أو MRN أو رقم الطلب أو الباركود..." TextChanged="TxtResultsOrderSearch_TextChanged" Margin="0,0,0,8"/>
                                <ComboBox x:Name="CmbResultsStatusFilter" Height="34" SelectionChanged="CmbResultsStatusFilter_SelectionChanged">
                                    <ComboBoxItem Tag="" Content="جميع الحالات (All)" IsSelected="True"/>
                                    <ComboBoxItem Tag="ResultReceived" Content="📊 تم استلام النتيجة (ResultReceived)"/>
                                    <ComboBoxItem Tag="Validated" Content="✅ معتمدة (Validated)"/>
                                    <ComboBoxItem Tag="Collected" Content="🧪 تم الاستلام (Collected)"/>
                                    <ComboBoxItem Tag="InProgress" Content="⚙️ قيد الفحص (InProgress)"/>
                                    <ComboBoxItem Tag="Ordered" Content="⏳ مطلوبة (Ordered)"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Orders Grid -->
                            <DataGrid Grid.Row="2" x:Name="GridResultsOrders" AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                                      SelectionChanged="GridResultsOrders_SelectionChanged" RowHeight="56">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="المريض / الطلب" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center" Margin="4,0">
                                                    <TextBlock Text="{Binding PatientName}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding OrderId, StringFormat='طلب #{0}'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                                        <TextBlock Text=" | " FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                        <TextBlock Text="{Binding Mrn, StringFormat='P.ID: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text=" | " FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                        <TextBlock Text="{Binding TestsSummary}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="الحالة" Width="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StatusBadgeBrush}" CornerRadius="4" Padding="6,3" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="11" Foreground="White"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- ═══ RIGHT PANEL: RESULTS & ACTION DETAILS ══════════════════════════ -->
                    <Grid Grid.Column="1">
                        <!-- Placeholder when no order selected -->
                        <Border x:Name="PanelNoOrderSelected" Style="{DynamicResource CardStyle}" Visibility="Visible">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🔬" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <TextBlock Text="يرجى اختيار طلب من القائمة لعرض وإدخال النتائج الطبية" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="يمكنك البحث برقم الطلب، اسم المريض، أو مسح الباركود مباشرة" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Order Details & Results Panel -->
                        <Grid x:Name="PanelOrderResults" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Patient Card -->
                                <RowDefinition Height="Auto"/> <!-- Actions Bar -->
                                <RowDefinition Height="*"/>    <!-- Results DataGrid -->
                            </Grid.RowDefinitions>

                            <!-- Patient Info Card -->
                            <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Margin="0,0,0,12" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtResPatientName" Text="محمد أحمد علي" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                            <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0">
                                                <TextBlock x:Name="TxtResMrn" Text="P.ID: 100025" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4" Padding="8,2" Margin="6,0,0,0">
                                                <TextBlock x:Name="TxtResOrderId" Text="طلب #1001" FontSize="12.5" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock x:Name="TxtResAgeGender" Text="العمر: 35 سنة | الجنس: ذكر" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="  •  " Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock x:Name="TxtResDoctor" Text="الطبيب: د. خالد إبراهيم" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="  •  " Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock x:Name="TxtResDate" Text="التاريخ: 25/10/2026 10:30" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Status Badge -->
                                    <Border Grid.Column="1" x:Name="BorderResStatus" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,6" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtResStatus" Text="ResultReceived" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Actions Bar -->
                            <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <Button x:Name="BtnSaveManualResults" Content="💾 حفظ النتائج (Save)" Style="{DynamicResource PrimaryButtonStyle}" Padding="16,8" FontSize="13.5" FontWeight="Bold" Margin="0,0,8,0" Click="BtnSaveManualResults_Click"/>
                                        <Button x:Name="BtnValidateResults" Content="✅ اعتماد النتائج (Validate)" Style="{DynamicResource SuccessButtonStyle}" Padding="16,8" FontSize="13.5" FontWeight="Bold" Margin="0,0,8,0" Click="BtnValidateResults_Click"/>
                                        <Button x:Name="BtnUnvalidateResults" Content="↩️ فك الاعتماد" Style="{DynamicResource OutlineButtonStyle}" Padding="12,8" FontSize="13" Margin="0,0,8,0" Click="BtnUnvalidateResults_Click"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <Button x:Name="BtnPreviewReport" Content="👁️ معاينة التقرير A4" Style="{DynamicResource OutlineButtonStyle}" Padding="14,8" FontSize="13" Margin="0,0,8,0" Click="BtnPreviewReport_Click"/>
                                        <Button x:Name="BtnPrintReportDirect" Content="🖨️ طباعة تقرير المريض A4" Style="{DynamicResource SuccessButtonStyle}" Padding="16,8" FontSize="13.5" FontWeight="Bold" Click="BtnPrintReportDirect_Click"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Results DataGrid -->
                            <DataGrid Grid.Row="2" x:Name="GridOrderResults" AutoGenerateColumns="False" CanUserAddRows="False"
                                      HeadersVisibility="Column" SelectionMode="Single" RowHeight="42">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="التحليل الأساسي (Test)" Binding="{Binding DisplayTestName}" FontWeight="Bold" Width="200" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="المكون (Component)" Binding="{Binding DisplayComponentName}" FontWeight="SemiBold" Width="200" IsReadOnly="True"/>
                                    
                                    <!-- Editable Result Value -->
                                    <DataGridTemplateColumn Header="النتيجة (Result Value)" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" 
                                                         FontWeight="Bold" FontSize="14" Padding="6,3"
                                                         Background="{DynamicResource InputBrush}"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         BorderBrush="{DynamicResource BorderBrush}"
                                                         BorderThickness="1"
                                                         TextChanged="TxtResultValue_TextChanged"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Flag Badge -->
                                    <DataGridTemplateColumn Header="التنبيه (Flag)" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding FlagBadgeBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding FlagDisplayText}" FontWeight="Bold" FontSize="11.5" Foreground="White"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="الوحدة (Unit)" Binding="{Binding Unit}" Width="100" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="المعدل الطبيعي (Reference Range)" Binding="{Binding ReferenceRangeText}" FontWeight="SemiBold" Width="170" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="جهاز التحليل (Instrument)" Binding="{Binding InstrumentName}" Width="150" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="باركود العينة" Binding="{Binding AccessionNo}" Width="110" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ========================================================================= -->
                <!-- 3. VIEW: TESTS CATALOG & PARAMETERS (دليل الفحوصات الطبية والباراميترات)  -->
                <!-- ========================================================================= -->
                <!-- Layout: TOP full-width header+filter, BOTTOM master/detail split -->
                <Grid x:Name="ViewTests" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <!-- TOP: Page Header + Action -->
                        <RowDefinition Height="Auto"/>
                        <!-- BOTTOM: DataGrid (left) + Form Panel (right) -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ═══ TOP: Full-width header with title, filters and action button ══════ -->
                    <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Title Row -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🧪" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="دليل التحاليل الطبية والأسعار" FontSize="17.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                            <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Tests Catalog" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="إدارة الفحوصات المخبرية، تحديد الأسعار بالدينار، ضبط أنابيب السحب والأقسام وإدارة البارامترات والقيم الطبيعية." FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnCatStartNewTest" Content="➕ فحص جديد (New Test)" Style="{DynamicResource SuccessButtonStyle}" Padding="16,10" FontSize="14" FontWeight="Bold" Click="BtnCatStartNewTest_Click" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Filter Row -->
                            <Border Grid.Row="1" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*" MinWidth="160"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="🔍 بحث:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" FontSize="13.5"/>
                                    <Border Grid.Column="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Height="36">
                                        <TextBox x:Name="TxtCatSearch" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13.5" VerticalContentAlignment="Center" Padding="8,0"
                                                 ToolTip="ابحث باسم التحليل أو الكود الفريد..." TextChanged="TxtCatSearch_TextChanged"/>
                                    </Border>

                                    <TextBlock Grid.Column="2" Text="القسم:" VerticalAlignment="Center" Margin="14,0,8,0" FontWeight="SemiBold" FontSize="13.5"/>
                                    <ComboBox Grid.Column="3" x:Name="CmbCatDeptFilter" Height="36" FontSize="13.5" SelectionChanged="CmbCatDeptFilter_SelectionChanged"/>

                                    <TextBlock Grid.Column="4" Text="الحالة:" VerticalAlignment="Center" Margin="14,0,8,0" FontWeight="SemiBold" FontSize="13.5"/>
                                    <ComboBox Grid.Column="5" x:Name="CmbCatStatusFilter" Height="36" FontSize="13.5" SelectionChanged="CmbCatStatusFilter_SelectionChanged">
                                        <ComboBoxItem Content="جميع التحاليل" IsSelected="True"/>
                                        <ComboBoxItem Content="المفعلة فقط 🟢"/>
                                        <ComboBoxItem Content="المعطلة فقط 🔴"/>
                                    </ComboBox>

                                    <TextBlock Grid.Column="7" x:Name="TxtCatCountBadge" Text="0 فحص" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ═══ BOTTOM: Master (DataGrid) + Detail (Form Panel) ═══════════════════ -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <!-- Left: Tests DataGrid -->
                            <ColumnDefinition Width="*" MinWidth="480"/>
                            <!-- Right: Add/Edit Form + Parameters -->
                            <ColumnDefinition Width="380" MinWidth="340"/>
                        </Grid.ColumnDefinitions>

                        <!-- ═══ LEFT: Tests DataGrid ════════════════════════════════════════ -->
                        <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Margin="0,0,12,0" Padding="0">
                            <DataGrid x:Name="GridCatalogTests" AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                                      BorderThickness="0" SelectionChanged="GridCatalogTests_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="كود التحليل" Binding="{Binding TestCode}" FontWeight="Bold" Width="105"/>
                                    <DataGridTextColumn Header="الاسم بالعربية" Binding="{Binding NameAr}" Width="220"/>
                                    <DataGridTextColumn Header="الاسم بالإنجليزية" Binding="{Binding NameEn}" Width="220"/>
                                    <DataGridTextColumn Header="القسم" Binding="{Binding DepartmentName}" Width="150"/>
                                    <DataGridTextColumn Header="نوع الأنبوب" Binding="{Binding SpecimenTypeName}" Width="150"/>
                                    <DataGridTextColumn Header="السعر" Binding="{Binding FormattedPrice}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Width="95"/>
                                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusDisplay}" Width="100"/>
                                    <DataGridTemplateColumn Header="إجراءات" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="🗑️" Style="{DynamicResource DangerButtonStyle}" Padding="6,2" Width="36" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Click="BtnCatDeleteTest_Click" ToolTip="حذف التحليل"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- ═══ RIGHT: Add/Edit Form + Parameters ════════════════════════════ -->
                        <Border Grid.Column="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="0">
                            <DockPanel>
                                <!-- Tab Bar Header (Segmented Switcher) -->
                                <Border DockPanel.Dock="Top" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" Padding="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="RbCatTabInfo" Grid.Column="0" Content="📝 بيانات الفحص" IsChecked="True"
                                                     GroupName="CatDetailTabs" Style="{DynamicResource SegmentedTabRadioStyle}" Height="36" Margin="0,0,3,0" Checked="CatTab_Checked"/>
                                        <RadioButton x:Name="RbCatTabComponents" Grid.Column="1" Content="🔬 الباراميترات (0)"
                                                     GroupName="CatDetailTabs" Style="{DynamicResource SegmentedTabRadioStyle}" Height="36" Margin="3,0,0,0" Checked="CatTab_Checked"/>
                                    </Grid>
                                </Border>

                                <!-- Tab 1: Test Form -->
                                <ScrollViewer x:Name="PanelCatTestForm" VerticalScrollBarVisibility="Auto" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtCatFormTitle" Text="➕ إضافة فحص جديد (New Test)" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>

                                        <Button x:Name="BtnCatOpenComponentsQuick" Content="🔬 إدارة بارامترات هذا الفحص والقيم المرجعية" Style="{DynamicResource PrimaryButtonStyle}" Height="38" Margin="0,0,0,12" Click="BtnCatOpenComponentsQuick_Click" Visibility="Collapsed"/>

                                        <!-- Code + Price in one row -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="كود التحليل (Test Code):" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox x:Name="TxtCatFormTestCode" Height="36" CharacterCasing="Upper" ToolTip="مثال: T_CBC, T_TSH"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="السعر (IQD):" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox x:Name="TxtCatFormPrice" Text="0" Height="36"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Arabic Name -->
                                        <TextBlock Text="اسم التحليل بالعربية (Arabic Name):" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtCatFormNameAr" Height="36" Margin="0,0,0,10"/>

                                        <!-- English Name -->
                                        <TextBlock Text="اسم التحليل بالإنجليزية (English Name):" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtCatFormNameEn" Height="36" Margin="0,0,0,10"/>

                                        <!-- Department + Specimen Type in one row -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                <TextBlock Text="القسم (Department):" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="CmbCatFormDepartment" Height="36" DisplayMemberPath="DisplayName" SelectedValuePath="Id"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="نوع الأنبوب (Tube):" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="CmbCatFormSpecimenType" Height="36" DisplayMemberPath="DisplayName" SelectedValuePath="Id"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Active Toggle -->
                                        <CheckBox x:Name="ChkCatFormActive" Content="فحص مفعل ومتاح للاختيار في الاستقبال" IsChecked="True" Margin="0,2,0,14" FontSize="13.5"/>

                                        <!-- Action Buttons -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="💾 حفظ الفحص (Save)" Style="{DynamicResource SuccessButtonStyle}" Height="42" Margin="0,0,5,0" Click="BtnCatSaveTest_Click"/>
                                            <Button Grid.Column="1" Content="↩ إلغاء / تفريغ" Style="{DynamicResource OutlineButtonStyle}" Height="42" Margin="5,0,0,0" Click="BtnCatClearForm_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Tab 2: Parameters Quick View -->
                                <Grid x:Name="PanelCatComponents" Visibility="Collapsed" Margin="14,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                        <TextBlock x:Name="TxtCatSelectedTestName" Text="التحليل: غير محدد" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="قائمة الباراميترات والمكونات المسجلة لهذا التحليل مع وحداتها:" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <DataGrid Grid.Row="1" x:Name="GridCatComponentsQuickView" AutoGenerateColumns="False" CanUserAddRows="False"
                                              IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" BorderThickness="1"
                                              BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,10">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding SortOrder}" Width="32"/>
                                            <DataGridTextColumn Header="الرمز" Binding="{Binding DisplayCode}" FontWeight="Bold" Width="70"/>
                                            <DataGridTextColumn Header="اسم البارامتر" Binding="{Binding NameEn}" Width="*"/>
                                            <DataGridTextColumn Header="الوحدة" Binding="{Binding Unit}" Width="70"/>
                                            <DataGridTextColumn Header="المدى" Binding="{Binding RangesCount}" Width="50"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Button Grid.Row="2" Content="🔬 فتح شاشة إدارة وتعديل كافة البارامترات والقيم الطبيعية"
                                            Style="{DynamicResource PrimaryButtonStyle}" Height="42" FontSize="13.5"
                                            Click="BtnCatOpenComponentsQuick_Click"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ========================================================================= -->
                <!-- 4. VIEW: BILLING & DAILY CASH REPORT (المالية وقاصة الحسابات)            -->
                <!-- ========================================================================= -->
                <Grid x:Name="ViewBilling" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Date Filter -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 1: Current User Till (قاصة الحساب الحالي) -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 2: KPI Cards -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 3: Grids -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Date Filter -->
                    <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="تاريخ تقرير اليومية (Report Date):" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                            <DatePicker Grid.Column="1" x:Name="DpCashReportDate" CalendarStyle="{StaticResource ModernCalendarStyle}" SelectedDateChanged="DpCashReportDate_SelectedDateChanged"/>
                            <Button Grid.Column="3" Content="تحديث التقرير (Refresh 🔄)" Style="{DynamicResource OutlineButtonStyle}" Padding="14,6" FontSize="13" Click="BtnRefreshCashReport_Click"/>
                        </Grid>
                    </Border>

                    <!-- Row 1: Current User Cash Drawer (قاصة الحساب الحالي) -->
                    <Border Grid.Row="1" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Till Header & User -->
                                <ColumnDefinition Width="260"/>
                                <!-- Cash Till -->
                                <ColumnDefinition Width="*"/>
                                <!-- Card Till -->
                                <ColumnDefinition Width="*"/>
                                <!-- Total Till -->
                                <ColumnDefinition Width="*"/>
                                <!-- Till Tx Count & Print Till Button -->
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="💼 قاصة الحساب الحالي" FontWeight="Bold" FontSize="15.5" Foreground="{DynamicResource AccentBrush}"/>
                                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Cash Drawer" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="TxtCurrentTillUser" Text="الموظف: مدير النظام (Admin)" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Cash in Till -->
                            <Border Grid.Column="1" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="💵 نقد في القاصة (Cash)" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="TxtCurrentTillCash" Text="0 IQD" FontSize="17.5" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card in Till -->
                            <Border Grid.Column="2" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="💳 دفع إلكتروني كارت (Card)" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="TxtCurrentTillCard" Text="0 IQD" FontSize="17.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Total Drawer Till -->
                            <Border Grid.Column="3" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="💰 إجمالي دخل القاصة (Total)" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="TxtCurrentTillTotal" Text="0 IQD" FontSize="17.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Count & Print -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,8,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🧾 العمليات" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtCurrentTillCount" Text="0 عملية" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Button x:Name="BtnPrintTillReport" Content="🖨️ كشف القاصة 80 مم" Style="{DynamicResource PrimaryButtonStyle}" Padding="13,8" FontSize="13" Click="BtnPrintTillReport_Click" ToolTip="طباعة إيصال كشف حركة القاصة الحراري 80 مم لهذا الحساب"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 2: KPI Cards (Financial Summary) -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Total Invoiced -->
                        <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Margin="0,0,8,0" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="إجمالي الفواتير" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="TxtKpiInvoiced" Text="0 IQD" FontSize="16.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Discounts -->
                        <Border Grid.Column="1" Style="{DynamicResource CardStyle}" Margin="0,0,8,0" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="الخصومات" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="TxtKpiDiscount" Text="0 IQD" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Net Invoiced -->
                        <Border Grid.Column="2" Style="{DynamicResource CardStyle}" Margin="0,0,8,0" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="الصافي المطلوب" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="TxtKpiNet" Text="0 IQD" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Cash Collected -->
                        <Border Grid.Column="3" Style="{DynamicResource CardStyle}" Margin="0,0,8,0" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="💵 نقداً (Cash)" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="TxtKpiCash" Text="0 IQD" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card Collected -->
                        <Border Grid.Column="4" Style="{DynamicResource CardStyle}" Margin="0,0,8,0" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="💳 كارت (Card)" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="TxtKpiCard" Text="0 IQD" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Total Collected -->
                        <Border Grid.Column="5" Style="{DynamicResource CardStyle}" Margin="0,0,8,0" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="المقبوض الكلي" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="TxtKpiCollected" Text="0 IQD" FontSize="16.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Balance Due -->
                        <Border Grid.Column="6" Style="{DynamicResource CardStyle}" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="الديون المتبقية" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="TxtKpiBalance" Text="0 IQD" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 3: Bottom Grids: Users Summary & Unpaid Invoices -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="480"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- User Collections Summary (القاصات حسب الموظفين) -->
                        <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Margin="0,0,14,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="👥 قاصة كل حساب وموظف (Account Cash Drawers)" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                                <DataGrid x:Name="GridUserCashSummary" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="الموظف / الحساب" Binding="{Binding FullName}" Width="*"/>
                                        <DataGridTextColumn Header="💵 نقد (Cash)" Binding="{Binding FormattedCash}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Width="100"/>
                                        <DataGridTextColumn Header="💳 كارت (Card)" Binding="{Binding FormattedCard}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Width="100"/>
                                        <DataGridTextColumn Header="💰 إجمالي القاصة" Binding="{Binding FormattedTotal}" FontWeight="Bold" Foreground="#FFFFFF" Width="105"/>
                                        <DataGridTextColumn Header="عمليات" Binding="{Binding FormattedTxCount}" Width="65"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <!-- Unpaid Invoices List -->
                        <Border Grid.Column="1" Style="{DynamicResource CardStyle}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="⚠️ الفواتير غير المسددة (Unpaid Invoices)" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,10"/>
                                <DataGrid x:Name="GridUnpaidInvoices" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="فاتورة (Inv #)" Binding="{Binding invoice_no}" Width="90"/>
                                        <DataGridTextColumn Header="طلب (Order #)" Binding="{Binding order_id}" Width="90"/>
                                        <DataGridTextColumn Header="المريض (Patient)" Binding="{Binding full_name_ar}" Width="*"/>
                                        <DataGridTextColumn Header="الهاتف (Phone)" Binding="{Binding phone}" Width="110"/>
                                        <DataGridTextColumn Header="الصافي (Net)" Binding="{Binding net, StringFormat='#,##0'}" Width="85"/>
                                        <DataGridTextColumn Header="المدفوع (Paid)" Binding="{Binding paid, StringFormat='#,##0'}" Width="85"/>
                                        <DataGridTextColumn Header="المتبقي (Balance)" Binding="{Binding balance, StringFormat='#,##0'}" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Width="95"/>
                                        <DataGridTemplateColumn Header="إجراء (Action)" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="قبض دفعة 💳" Style="{DynamicResource SuccessButtonStyle}" Padding="10,4" FontSize="12.5" Click="BtnPayInvoice_Click"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ========================================================================= -->
                <!-- 5. VIEW: LAB SETTINGS & HEADER PREVIEW (إعدادات المختبر والترويسة)        -->
                <!-- ========================================================================= -->
                <!-- Settings page uses full content width with a vertical layout:
                     TOP: Lab info fields (full width, 2-col grid)
                     BOTTOM: Left=Settings controls  Right=Live Preview -->
                <Grid x:Name="ViewSettings" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <!-- TOP: Lab Info Fields Section -->
                        <RowDefinition Height="Auto"/>
                        <!-- BOTTOM: Printers/Tools (left) + Live Preview (right) -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ═══ TOP ROW: Lab Information Fields (Full Width) ══════════════════ -->
                    <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <!-- Header -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🏢" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="إعدادات المختبر والترويسة (Lab Settings &amp; Header)" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="بيانات المختبر الأساسية التي تظهر في رأس التقارير والوصولات" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Content="💾 حفظ الإعدادات (Save Settings)" Style="{DynamicResource PrimaryButtonStyle}" Height="40" Padding="18,0" FontSize="14" FontWeight="Bold" Click="BtnSaveSettings_Click"/>
                            </Grid>

                            <!-- Row 1: Lab Name Arabic + Lab Name English -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="اسم المختبر بالعربية (Lab Name - Arabic):" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtSettingsLabNameAr" Height="36" TextChanged="SettingsInputs_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                    <TextBlock Text="اسم المختبر بالإنجليزية (Lab Name - English):" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtSettingsLabNameEn" Height="36" TextChanged="SettingsInputs_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0,8,0">
                                    <TextBlock Text="العنوان (Address):" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtSettingsAddress" Height="36" TextChanged="SettingsInputs_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                    <TextBlock Text="أرقام الهواتف (Phone Numbers):" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtSettingsPhones" Height="36" TextChanged="SettingsInputs_Changed"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Email + Header Text + Manager + Title + Footer -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="البريد الإلكتروني (Email):" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
