                                    </Grid>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- RIGHT: LIVE PREVIEW OF REPORT HEADER -->
                        <Border Grid.Column="1" Style="{DynamicResource CardStyle}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="👁️ المعاينة الحية لترويسة التقارير والوصولات (Live Report Preview)" FontWeight="Bold" FontSize="15.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,14"/>

