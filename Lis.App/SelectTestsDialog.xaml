<Window FontFamily="{StaticResource AppFontFamily}" x:Class="Lis.App.SelectTestsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="اختيار وتحديد التحاليل للإضافة إلى الطلب"
        Icon="Assets/app_icon.ico"
        Height="640" Width="920"
        MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        FlowDirection="LeftToRight"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & Search -->
            <RowDefinition Height="*"/>    <!-- Tests List -->
            <RowDefinition Height="Auto"/> <!-- Footer & Actions -->
        </Grid.RowDefinitions>

        <!-- Header & Search Box -->
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="🧪 كتالوج الفحوصات الطبية" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="ابحث وحدد فحصاً أو عدة فحوصات لإضافتها للطلب الحالي" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Search Input -->
                <Border Grid.Column="1" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Height="40" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox Grid.Column="1" x:Name="TxtSearch" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="14" TextChanged="TxtSearch_TextChanged"/>
                        <Button Grid.Column="2" x:Name="BtnClearSearch" Content="✕" Style="{DynamicResource GhostButtonStyle}" Width="28" Height="28" Padding="0" Margin="0,0,4,0" Visibility="Collapsed" Click="BtnClearSearch_Click"/>
                    </Grid>
                </Border>

                <!-- Quick Select Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="تحديد الكل" Style="{DynamicResource OutlineButtonStyle}" Padding="12,7" FontSize="13" Margin="0,0,6,0" Click="BtnSelectAll_Click"/>
                    <Button Content="إلغاء التحديد" Style="{DynamicResource OutlineButtonStyle}" Padding="12,7" FontSize="13" Click="BtnDeselectAll_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tests DataGrid -->
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="0" Margin="0,0,0,12">
            <DataGrid x:Name="GridCatalogTests" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" RowHeight="44" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="تحديد" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                    <DataGridTextColumn Header="كود الفحص" Binding="{Binding TestCode}" IsReadOnly="True" FontWeight="Bold" Width="110"/>
                    <DataGridTextColumn Header="اسم التحليل" Binding="{Binding DisplayName}" IsReadOnly="True" FontWeight="SemiBold" Width="*"/>
                    <DataGridTextColumn Header="القسم" Binding="{Binding DepartmentName}" IsReadOnly="True" Width="145"/>
                    <DataGridTextColumn Header="نوع العينة" Binding="{Binding SpecimenTypeName}" IsReadOnly="True" Width="155"/>
                    <DataGridTextColumn Header="السعر" Binding="{Binding FormattedPrice}" IsReadOnly="True" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSelectionSummary" Text="المحدد: 0 فحوصات | إجمالي القيمة: 0 IQD" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnConfirm" Content="➕ إضافة الفحوصات المحددة للطلب" Style="{DynamicResource PrimaryButtonStyle}" Padding="16,9" FontSize="14" FontWeight="Bold" Margin="0,0,8,0" Click="BtnConfirm_Click"/>
                    <Button Content="إلغاء" Style="{DynamicResource OutlineButtonStyle}" Padding="14,9" FontSize="14" Click="BtnCancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
