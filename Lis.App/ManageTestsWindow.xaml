<Window FontFamily="Simplified Arabic" x:Class="Lis.App.ManageTestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة دليل الفحوصات الطبية والأسعار - Laboratory Tests &amp; Pricing Catalog" 
        Height="740" Width="1190"
        WindowStartupLocation="CenterOwner"
        FlowDirection="LeftToRight"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content (Grid & Edit Form) -->
            <RowDefinition Height="*"/>
            <!-- Footer Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧪 دليل الفحوصات الطبية والأسعار" FontSize="19.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="6" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Tests Catalog" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="إضافة وتعديل الفحوصات المخبرية، تحديد أسعارها بالدينار العراقي، ونوع أنبوب سحب العينة والقسم الطبي." FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="➕ فحص جديد (New Test)" Style="{DynamicResource SuccessButtonStyle}" Padding="15,9" FontSize="14" Click="BtnStartNewTest_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <!-- Left: Tests List & Search -->
                <ColumnDefinition Width="*"/>
                <!-- Right: Add / Edit Form -->
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: TESTS LIST -->
            <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Margin="0,0,14,0">
                <DockPanel>
                    <!-- Search Filter Bar -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Height="42" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TxtSearchTests" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" VerticalContentAlignment="Center"
                                     ToolTip="ابحث باسم الفحص أو الكود..." TextChanged="TxtSearchTests_TextChanged"/>
                            <TextBlock Grid.Column="2" x:Name="TxtTestsCountBadge" Text="0 فحص" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        </Grid>
                    </Border>

                    <!-- Tests DataGrid -->
                    <DataGrid x:Name="GridCatalogTests" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" RowHeight="42"
                              SelectionChanged="GridCatalogTests_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="كود (Code)" Binding="{Binding TestCode}" FontWeight="Bold" Width="105"/>
                            <DataGridTextColumn Header="الاسم بالعربية (Name Ar)" Binding="{Binding NameAr}" Width="165"/>
                            <DataGridTextColumn Header="الاسم بالإنجليزية (Name En)" Binding="{Binding NameEn}" Width="*"/>
                            <DataGridTextColumn Header="القسم (Dept)" Binding="{Binding DepartmentName}" Width="115"/>
                            <DataGridTextColumn Header="الأنبوب (Tube)" Binding="{Binding SpecimenTypeName}" Width="125"/>
                            <DataGridTextColumn Header="السعر (Price)" Binding="{Binding FormattedPrice}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Width="110"/>
                            <DataGridTextColumn Header="الحالة (Status)" Binding="{Binding StatusDisplay}" Width="115"/>
                            <DataGridTemplateColumn Header="إجراءات" Width="235">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="🔬 البارامترات" Style="{DynamicResource PrimaryButtonStyle}" Padding="8,4" FontSize="12.5" Margin="0,0,4,0" Click="BtnManageComponents_Click" ToolTip="عرض وإضافة بارامترات ومكونات التحليل والقيم الطبيعية"/>
                                            <Button Content="تعديل ✏️" Style="{DynamicResource OutlineButtonStyle}" Padding="8,4" FontSize="12.5" Margin="0,0,4,0" Click="BtnEditTest_Click"/>
                                            <Button Content="حذف 🗑️" Style="{DynamicResource DangerButtonStyle}" Padding="8,4" FontSize="12.5" Click="BtnDeleteTest_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- RIGHT: ADD / EDIT FORM -->
            <Border Grid.Column="1" Style="{DynamicResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="TxtFormTitle" Text="➕ إضافة فحص جديد (New Test)" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>

                        <!-- Manage Components Button for selected test -->
                        <Button x:Name="BtnFormManageComponents" Content="🔬 إدارة بارامترات هذا التحليل (Parameters)" Style="{DynamicResource PrimaryButtonStyle}" Height="38" FontSize="13.5" Margin="0,0,0,12" Click="BtnFormManageComponents_Click" Visibility="Collapsed"/>

                        <!-- Test Code -->
                        <TextBlock Text="كود التحليل الفريد (Test Code - مثال: T_CBC, T_TSH):" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="TxtFormTestCode" Margin="0,4,0,10" CharacterCasing="Upper"/>

                        <!-- Arabic Name -->
                        <TextBlock Text="اسم التحليل بالعربية (Arabic Name):" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="TxtFormNameAr" Margin="0,4,0,10"/>

                        <!-- English Name -->
                        <TextBlock Text="اسم التحليل بالإنجليزية (English Name):" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="TxtFormNameEn" Margin="0,4,0,10"/>

                        <!-- Price -->
                        <TextBlock Text="سعر التحليل بالدينار (Price IQD):" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="TxtFormPrice" Text="0" Margin="0,4,0,10"/>

                        <!-- Department -->
                        <TextBlock Text="القسم الطبي المخبري (Department):" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="CmbFormDepartment" Margin="0,4,0,10" DisplayMemberPath="DisplayName" SelectedValuePath="Id"/>

                        <!-- Specimen Type / Tube -->
                        <TextBlock Text="نوع الأنبوب والعينة (Specimen Type / Tube):" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="CmbFormSpecimenType" Margin="0,4,0,10" DisplayMemberPath="DisplayName" SelectedValuePath="Id"/>

                        <!-- Active Toggle -->
                        <CheckBox x:Name="ChkFormActive" Content="فحص مفعل ومتاح للاختيار (Active Test)" IsChecked="True" Margin="0,4,0,16" FontSize="13.5"/>

                        <!-- Action Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="💾 حفظ التحليل (Save)" Style="{DynamicResource SuccessButtonStyle}" Height="42" FontSize="14" Margin="0,0,4,0" Click="BtnSaveTest_Click"/>
                            <Button Grid.Column="1" Content="إلغاء / مسح (Clear)" Style="{DynamicResource OutlineButtonStyle}" Height="42" FontSize="14" Margin="4,0,0,0" Click="BtnClearForm_Click"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- FOOTER ACTIONS -->
        <Border Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="إغلاق النافذة (Close)" Style="{DynamicResource OutlineButtonStyle}" Padding="16,9" FontSize="14" Click="BtnClose_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
