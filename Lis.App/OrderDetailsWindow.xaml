<Window FontFamily="Simplified Arabic" x:Class="Lis.App.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تفاصيل الطلب والتحاليل والحسابات - Order Details &amp; Billing" 
        Icon="Assets/app_icon.ico"
        Height="750" Width="1090"
        MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        FlowDirection="LeftToRight"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Financial Summary -->
            <RowDefinition Height="*"/>    <!-- Ordered Tests Management -->
            <RowDefinition Height="Auto"/> <!-- Notice banner -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- ══ 1. HEADER ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtOrderTitle" Text="طلب رقم #1001 (زيارة رقم 1)" FontSize="19.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="TxtPatientInfo" Text="المريض: محمد أحمد علي | P.ID: 100025 | العمر: 35 سنة | الجنس: ذكر" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" x:Name="BorderOrderStatus" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,6" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtOrderStatus" Text="Ordered" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FontSize="14"/>
                </Border>
            </Grid>
        </Border>

        <!-- ══ 2. FINANCIAL SUMMARY & PAYMENT ═════════════════════════════════ -->
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="إجمالي الفاتورة (Total):" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtTotal" Text="0 IQD" FontWeight="Bold" FontSize="17.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="الخصم (Discount):" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtDiscount" Text="0 IQD" FontWeight="Bold" FontSize="17.5" Foreground="{DynamicResource WarningBrush}" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="الصافي (Net Total):" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtNet" Text="0 IQD" FontWeight="Bold" FontSize="17.5" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="المسدد (Paid):" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtPaid" Text="0 IQD" FontWeight="Bold" FontSize="17.5" Foreground="{DynamicResource SuccessBrush}" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="المتبقي (Balance Due):" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtBalance" Text="0 IQD" FontWeight="Bold" FontSize="17.5" Foreground="{DynamicResource DangerBrush}" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnPay" Content="تسديد دفعة (Pay 💳)" Style="{DynamicResource SuccessButtonStyle}" Padding="16,9" FontSize="14" FontWeight="Bold" Margin="0,0,8,0" Click="BtnPay_Click"/>
                    <Button Content="🧾 وصل 80 مم" Style="{DynamicResource PrimaryButtonStyle}" Padding="14,9" FontSize="14" Click="BtnPrintReceipt_Click" ToolTip="طباعة وصل كاشير على طابعة الإيصالات الحرارية 80 مم"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ 3. ORDERED TESTS MANAGEMENT (ADD / DELETE) ═════════════════════ -->
        <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Margin="0,0,0,12" Padding="14">
            <DockPanel>
                <!-- Tests Toolbar & Add Test Section -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📋 قائمة التحاليل المطلوبة لهذا الطلب:" FontWeight="Bold" FontSize="16.5" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="10" Padding="10,3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtTestsCount" Text="0 تحاليل" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13.5"/>
                        </Border>
                    </StackPanel>

                    <!-- Add Test Bar -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="24,0,0,0" VerticalAlignment="Center">
                        <ComboBox x:Name="CmbAvailableTests" Width="340" Height="38" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="DisplayText" DisplayMemberPath="DisplayText" VerticalContentAlignment="Center" FontSize="14"/>
                        <Button Content="➕ إضافة الفحص للطلب" Style="{DynamicResource SuccessButtonStyle}" Padding="14,7" FontSize="13.5" FontWeight="Bold" Margin="8,0,0,0" Click="BtnAddTestToOrder_Click"/>
                        <Button Content="🔍 تصفح الكتالوج..." Style="{DynamicResource OutlineButtonStyle}" Padding="12,7" FontSize="13.5" Margin="6,0,0,0" Click="BtnBrowseCatalog_Click"/>
                    </StackPanel>
                </Grid>

                <!-- DataGrid of Ordered Tests -->
                <DataGrid x:Name="GridOrderedTests" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeight="44" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="اسم التحليل (Test Name)" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="6,0">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding TestCode}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="نوع العينة / الأنبوب (Tube)" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                        <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                             <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding TubeColorBrush}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Text="{Binding SpecimenTypeName}" FontSize="13.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="باركود العينة (Accession)" Binding="{Binding AccessionNo}" FontWeight="Bold" Width="150"/>
                        <DataGridTextColumn Header="السعر (Price)" Binding="{Binding FormattedPrice}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Width="120"/>
                        
                        <DataGridTemplateColumn Header="الحالة (Status)" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="إجراءات (Actions)" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑️ حذف" Style="{DynamicResource DangerButtonStyle}" Padding="12,5" FontSize="13" Click="BtnRemoveTest_Click" ToolTip="حذف هذا الفحص من الطلب وتحديث الفاتورة"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ══ 4. WORKLIST NOTICE BANNER ═══════════════════════════════════════ -->
        <Border Grid.Row="3" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="💡 ملاحظة نظام العمل:" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" FontSize="13"/>
                <TextBlock Text="هذه الصفحة مخصصة للمحاسبة ودفع المبلغ وطباعة وصل الكاشير وتعديل قائمة الفحوصات (إضافة وحذف). إجراءات سحب واستلام العينات، طباعة الباركود، والرفض تتم حصراً من قائمة العمل (Worklist)." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- ══ 5. FOOTER ACTIONS ══════════════════════════════════════════════ -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="🧾 طباعة وصل كاشير 80 مم (Print Receipt)" Style="{DynamicResource PrimaryButtonStyle}" Margin="0,0,10,0" Padding="16,9" FontSize="14" Click="BtnPrintReceipt_Click"/>
            <Button Content="إلغاء الطلب بالكامل (Cancel Order ❌)" Style="{DynamicResource DangerButtonStyle}" Margin="0,0,10,0" Padding="15,9" FontSize="14" Click="BtnCancelOrder_Click"/>
            <Button Content="إغلاق النافذة (Close)" Style="{DynamicResource OutlineButtonStyle}" Padding="15,9" FontSize="14" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
