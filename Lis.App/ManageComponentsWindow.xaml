<Window FontFamily="Simplified Arabic" x:Class="Lis.App.ManageComponentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة مكونات وبارامترات التحليل والقيم الطبيعية - Test Parameters &amp; Reference Ranges" 
        Icon="Assets/app_icon.ico"
        Height="840" Width="1380"
        MinWidth="1150" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        FlowDirection="LeftToRight"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content (2 Columns: Components & Ranges) -->
            <RowDefinition Height="*"/>
            <!-- Footer Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Margin="0,0,0,12" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔬 إدارة مكونات وبارامترات التحليل" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        <Border x:Name="BadgeTestCode" Background="{DynamicResource PrimaryBrush}" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHeaderTestCode" Text="T_CBC" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                        <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHeaderTestDept" Text="Hematology" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtHeaderTestSubtitle" Text="صورة الدم الكاملة (Complete Blood Count) • أنبوب EDTA Whole Blood • السعر: 1,000 IQD" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="➕ إضافة بارامتر جديد (New Parameter)" Style="{DynamicResource SuccessButtonStyle}" Padding="14,8" FontSize="12.5" Click="BtnStartNewComponent_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT (Proportional split for spacious parameter grid) -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <!-- Left: Components List & Parameter Form (Spacious 1.18*) -->
                <ColumnDefinition Width="1.18*" MinWidth="680"/>
                <!-- Right: Normal Reference Ranges & Analyzer Mapping (1*) -->
                <ColumnDefinition Width="1*" MinWidth="500"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: COMPONENTS / PARAMETERS -->
            <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Margin="0,0,12,0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Components Table -->
                        <RowDefinition Height="3*"/>
                        <!-- Separator -->
                        <RowDefinition Height="Auto"/>
                        <!-- Component Edit Form -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Components Grid -->
                    <DockPanel Grid.Row="0">
                        <!-- Top Toolbar with search box and badge -->
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📋 قائمة البارامترات والمكونات" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtComponentsCountBadge" Text="0 بارامتر" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>
                            </StackPanel>

                            <!-- Quick Filter Search Box -->
                            <Border Grid.Column="1" HorizontalAlignment="Right" Margin="12,0" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Height="30" Width="200">
                                <Grid>
                                    <TextBlock Text="🔍 بحث بالاسم أو الرمز..." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtCompSearch}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="TxtCompSearch" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11.5" VerticalContentAlignment="Center" Padding="6,0" TextChanged="TxtCompSearch_TextChanged"/>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Column="2" Text="اختر بارامتراً لعرض وتعديل قيمه ➡️" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>

                        <DataGrid x:Name="GridComponents" AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                                  RowHeight="36" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                  SelectionChanged="GridComponents_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding SortOrder}" Width="40"/>
                                <DataGridTextColumn Header="الرمز (Code)" Binding="{Binding DisplayCode}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Width="95"/>
                                <DataGridTextColumn Header="اسم البارامتر (Name)" Binding="{Binding NameEn}" Width="*"/>
                                <DataGridTextColumn Header="الوحدة (Unit)" Binding="{Binding Unit}" Width="90"/>
                                <DataGridTextColumn Header="الكسور" Binding="{Binding Decimals}" Width="60"/>
                                <DataGridTextColumn Header="القيم الطبيعية" Binding="{Binding RangesCount, StringFormat='{}{0} مدى'}" Width="95"/>
                                <DataGridTemplateColumn Header="إجراءات" Width="145">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="✏️ تعديل" Style="{DynamicResource OutlineButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,6,0" Click="BtnEditComponent_Click" ToolTip="تعديل بيانات البارامتر"/>
                                                <Button Content="🗑️ حذف" Style="{DynamicResource DangerButtonStyle}" Padding="8,3" FontSize="11" Click="BtnDeleteComponent_Click" ToolTip="حذف البارامتر"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- Divider -->
                    <Separator Grid.Row="1" Margin="0,10,0,10" Background="{DynamicResource BorderBrush}"/>

                    <!-- Component Form -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock x:Name="TxtComponentFormTitle" Text="➕ إضافة بارامتر جديد (New Parameter)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                <Button Content="↩ إلغاء / جديد" HorizontalAlignment="Right" Style="{DynamicResource OutlineButtonStyle}" Padding="10,4" FontSize="11" Click="BtnClearComponentForm_Click"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Display Code -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="الرمز المختصر (Code)*:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtCompDisplayCode" Height="42" VerticalContentAlignment="Center" Padding="10,4" ToolTip="رمز البارامتر مثل WBC, HGB, GLU"/>
                                </StackPanel>

                                <!-- English Name -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="الاسم بالإنجليزية (Name En)*:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtCompNameEn" Height="42" VerticalContentAlignment="Center" Padding="10,4" ToolTip="مثال: White Blood Cells"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <!-- Arabic Name -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="الاسم بالعربية (Name Ar):" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtCompNameAr" Height="42" VerticalContentAlignment="Center" Padding="10,4" ToolTip="مثال: كريات الدم البيضاء"/>
                                </StackPanel>

                                <!-- Unit -->
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="الوحدة (Unit):" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtCompUnit" Height="42" VerticalContentAlignment="Center" Padding="10,4" ToolTip="مثال: 10^9/L أو g/dL أو mg/dL أو %"/>
                                </StackPanel>

                                <!-- Decimals -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="الكسور:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbCompDecimals" Height="42" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="0" Tag="0"/>
                                        <ComboBoxItem Content="1" Tag="1" IsSelected="True"/>
                                        <ComboBoxItem Content="2" Tag="2"/>
                                        <ComboBoxItem Content="3" Tag="3"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Analyzer Mapping Row -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Instrument -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="ربط جهاز التحليل (Instrument):" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbCompInstrument" Height="42" VerticalContentAlignment="Center" DisplayMemberPath="DisplayName" SelectedValuePath="Id"/>
                                </StackPanel>

                                <!-- Instrument Test Code -->
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="كود الفحص (Code):" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtCompInstrumentCode" Height="42" VerticalContentAlignment="Center" Padding="10,4" ToolTip="الكود الذي يرسله الجهاز في ASTM مثل LYM%"/>
                                </StackPanel>

                                <!-- Unlink / Delete instrument from parameter -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                    <Button x:Name="BtnUnlinkCompInstrument" Content="🗑️ حذف الربط" Style="{DynamicResource DangerButtonStyle}" Height="42" Padding="12,0" FontSize="11.5" Click="BtnUnlinkCompInstrument_Click" ToolTip="إلغاء وحذف ربط هذا الجهاز من البارامتر"/>
                                </StackPanel>
                            </Grid>

                            <Button Content="💾 حفظ البارامتر (Save Parameter)" Style="{DynamicResource SuccessButtonStyle}" Height="42" FontSize="13" FontWeight="Bold" Click="BtnSaveComponent_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: TABS FOR NORMAL RANGES & LINKED INSTRUMENTS -->
            <Border Grid.Column="1" Style="{DynamicResource CardStyle}" Padding="14">
                <TabControl Background="Transparent" BorderThickness="0">
                    <!-- TAB 1: REFERENCE RANGES -->
                    <TabItem Header="🎯 القيم المرجعية الطبيعية (Normal Ranges)">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <!-- Header & Ranges Table -->
                                <RowDefinition Height="3*"/>
                                <!-- Separator -->
                                <RowDefinition Height="Auto"/>
                                <!-- Range Edit Form -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock x:Name="TxtSelectedComponentHeader" Text="🎯 القيم المرجعية الطبيعية (Normal Ranges)" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock x:Name="TxtSelectedComponentSubtitle" Text="حدد بارامتراً من القائمة اليسرى لعرض أو إضافة قيمه الطبيعية." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Ranges DataGrid -->
                                <DataGrid x:Name="GridReferenceRanges" AutoGenerateColumns="False" CanUserAddRows="False"
                                          IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                                          RowHeight="36" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="الجنس (Sex)" Binding="{Binding SexDisplay}" Width="110"/>
                                        <DataGridTextColumn Header="العمر (Age)" Binding="{Binding AgeDisplay}" Width="110"/>
                                        <DataGridTextColumn Header="المدى الطبيعي (Normal)" Binding="{Binding RangeDisplay}" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Width="130"/>
                                        <DataGridTextColumn Header="القيم الحرجة (Critical)" Binding="{Binding CriticalDisplay}" Foreground="{DynamicResource DangerBrush}" Width="110"/>
                                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Note}" Width="*"/>
                                        <DataGridTemplateColumn Header="حذف" Width="65">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="🗑️" Style="{DynamicResource DangerButtonStyle}" Padding="6,2" FontSize="11" Click="BtnDeleteRange_Click" ToolTip="حذف المدى الطبيعي"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                            <!-- Divider -->
                            <Separator Grid.Row="1" Margin="0,10,0,10" Background="{DynamicResource BorderBrush}"/>

                            <!-- Range Form -->
                            <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="➕ إضافة مدى مرجعي طبيعي جديد (New Reference Range)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                        <Button Content="مسح الحقول" HorizontalAlignment="Right" Style="{DynamicResource OutlineButtonStyle}" Padding="8,2" FontSize="11" Click="BtnClearRangeForm_Click"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Sex -->
                                        <!-- Sex -->
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="الجنس (Sex):" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="CmbRangeSex" Height="40" VerticalContentAlignment="Center">
                                                <ComboBoxItem Content="كلاهما (All) 🚻" Tag="B" IsSelected="True"/>
                                                <ComboBoxItem Content="ذكور (Male) 👨" Tag="M"/>
                                                <ComboBoxItem Content="إناث (Female) 👩" Tag="F"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Age Min -->
                                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                            <TextBlock Text="من عمر:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtRangeAgeMin" Text="18" Height="40" VerticalContentAlignment="Center" Padding="8,4"/>
                                        </StackPanel>

                                        <!-- Age Max -->
                                        <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                            <TextBlock Text="إلى عمر:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtRangeAgeMax" Text="100" Height="40" VerticalContentAlignment="Center" Padding="8,4"/>
                                        </StackPanel>

                                        <!-- Age Unit -->
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="الوحدة العمرية:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="CmbRangeAgeUnit" Height="40" VerticalContentAlignment="Center">
                                                <ComboBoxItem Content="سنوات (Years)" Tag="Years" IsSelected="True"/>
                                                <ComboBoxItem Content="أشهر (Months)" Tag="Months"/>
                                                <ComboBoxItem Content="أيام (Days)" Tag="Days"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Min Normal -->
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="الحد الأدنى الطبيعي (Min):" FontSize="11.5" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtRangeLow" Height="40" VerticalContentAlignment="Center" Padding="8,4" ToolTip="مثال: 4.0"/>
                                        </StackPanel>

                                        <!-- Max Normal -->
                                        <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                            <TextBlock Text="الحد الأعلى الطبيعي (Max):" FontSize="11.5" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtRangeHigh" Height="40" VerticalContentAlignment="Center" Padding="8,4" ToolTip="مثال: 10.0"/>
                                        </StackPanel>

                                        <!-- Panic Critical Low -->
                                        <StackPanel Grid.Column="2" Margin="0,0,6,0">
                                            <TextBlock Text="حرج أدنى (Crit Low):" FontSize="11.5" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtRangeCritLow" Height="40" VerticalContentAlignment="Center" Padding="8,4" ToolTip="قيمة التنبيه الحرج الدنيا"/>
                                        </StackPanel>

                                        <!-- Panic Critical High -->
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="حرج أعلى (Crit High):" FontSize="11.5" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtRangeCritHigh" Height="40" VerticalContentAlignment="Center" Padding="8,4" ToolTip="قيمة التنبيه الحرج القصوى"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Clinical Note -->
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="ملاحظة سريرية (Clinical Note):" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtRangeNote" Height="40" VerticalContentAlignment="Center" Padding="8,4"/>
                                    </StackPanel>

                                    <Button x:Name="BtnSaveRange" Content="➕ إضافة المدى المرجعي للبارامتر" Style="{DynamicResource PrimaryButtonStyle}" Height="40" FontSize="13" FontWeight="Bold" Click="BtnSaveRange_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- TAB 2: LINKED INSTRUMENTS & CODES -->
                    <TabItem Header="📡 أجهزة التحليل وقنوات الربط (Linked Instruments)">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock x:Name="TxtSelectedComponentInstHeader" Text="📡 أجهزة التحليل المرتبطة بهذا البارامتر" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="يمكنك ربط أكثر من جهاز بنفس التحليل (مثلاً سيمنز بكود HbA1c وجهاز آخر بكود A1c)." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Instrument Mappings DataGrid -->
                                <DataGrid x:Name="GridInstrumentMappings" AutoGenerateColumns="False" CanUserAddRows="False"
                                          IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                                          RowHeight="36" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="اسم الجهاز (Instrument Name)" Binding="{Binding InstrumentName}" FontWeight="SemiBold" Width="1.5*"/>
                                        <DataGridTextColumn Header="رمز الجهاز" Binding="{Binding InstrumentCode}" Width="110"/>
                                        <DataGridTextColumn Header="كود الفحص بالجهاز (Test Code)" Binding="{Binding InstrumentTestCode}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Width="160"/>
                                        <DataGridTemplateColumn Header="إلغاء الربط" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="🗑️ حذف" Style="{DynamicResource DangerButtonStyle}" Padding="6,2" FontSize="11" Click="BtnDeleteInstrumentMapping_Click" ToolTip="إلغاء ربط هذا الجهاز"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>

                            <!-- Divider -->
                            <Separator Grid.Row="1" Margin="0,10,0,10" Background="{DynamicResource BorderBrush}"/>

                            <!-- Add Instrument Mapping Form -->
                            <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="➕ ربط جهاز تحليل إضافي بهذا البارامتر (Link Instrument)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Instrument Selector -->
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="اختر جهاز التحليل:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="CmbMappingInstrument" Height="32" DisplayMemberPath="DisplayName" SelectedValuePath="Id"/>
                                        </StackPanel>

                                        <!-- Instrument Test Code -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="كود الفحص الذي يرسله الجهاز:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtMappingInstrumentTestCode" Height="32" ToolTip="مثال: HbA1c أو A1c أو 025"/>
                                        </StackPanel>
                                    </Grid>

                                    <Button Content="➕ ربط الجهاز بهذا البارامتر (Save Mapping)" Style="{DynamicResource PrimaryButtonStyle}" Height="34" FontSize="12.5" Click="BtnAddInstrumentMapping_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- FOOTER ACTIONS -->
        <Border Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="إغلاق النافذة والعودة (Close)" Style="{DynamicResource OutlineButtonStyle}" Padding="16,8" Click="BtnClose_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

