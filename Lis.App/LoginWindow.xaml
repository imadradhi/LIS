<Window FontFamily="Simplified Arabic" x:Class="Lis.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول - نظام إدارة المختبرات الطبية (LIS Login)" 
        Height="610" Width="490"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="LeftToRight"
        Background="{DynamicResource AppBackgroundBrush}">

    <Border Padding="32" VerticalAlignment="Center">
        <Border Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="16" 
                Padding="28,24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Opacity="0.22" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
                <!-- Brand Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="🔬" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="مختبر التحليلات الطبية التخصصي" 
                               FontSize="18.5" FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Laboratory Information System (LIS Interface)" 
                               FontSize="13.5" FontWeight="SemiBold" 
                               Foreground="{DynamicResource AccentBrush}" 
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>

                <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,20"/>

                <!-- Welcome Text -->
                <TextBlock Text="تسجيل الدخول إلى النظام (Sign In)" 
                           FontSize="15.5" FontWeight="Bold" 
                           Foreground="{DynamicResource TextPrimaryBrush}" 
                           Margin="0,0,0,14"/>

                <!-- Username Field -->
                <TextBlock Text="👤 اسم المستخدم (Username):" 
                           FontSize="13.5" FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextSecondaryBrush}" 
                           Margin="0,0,0,6"/>
                <TextBox x:Name="TxtUsername" 
                         Text="admin"
                         FontSize="14.5" Height="42" 
                         Padding="12,6" Margin="0,0,0,14" 
                         KeyDown="TxtUsername_KeyDown"/>

                <!-- Password Field -->
                <TextBlock Text="🔑 كلمة المرور (Password):" 
                           FontSize="13.5" FontWeight="SemiBold" 
                           Foreground="{DynamicResource TextSecondaryBrush}" 
                           Margin="0,0,0,6"/>
                <PasswordBox x:Name="TxtPassword" 
                             FontSize="14.5" Height="42" 
                             Padding="12,6" Margin="0,0,0,14"
                             Background="{DynamicResource InputBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             KeyDown="TxtPassword_KeyDown"/>

                <!-- Error Message Banner -->
                <Border x:Name="BdrError" Background="#7FDC2626" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,14" Visibility="Collapsed">
                    <TextBlock x:Name="TxtErrorMessage" Text="اسم المستخدم أو كلمة المرور غير صحيحة" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </Border>

                <!-- Login Button -->
                <Button x:Name="BtnLogin" 
                        Content="تسجيل الدخول (Sign In) ➜" 
                        Style="{DynamicResource PrimaryButtonStyle}" 
                        Height="46" FontSize="16" FontWeight="Bold"
                        Click="BtnLogin_Click" Margin="0,4,0,10"/>

                <!-- Server Settings Button -->
                <Button x:Name="BtnServerSettings" 
                        Content="⚙️ إعدادات الاتصال بالسيرفر (Server Settings)" 
                        Style="{DynamicResource OutlineButtonStyle}" 
                        Height="36" FontSize="12.5" FontWeight="SemiBold"
                        Click="BtnServerSettings_Click" Margin="0,0,0,14"/>

                <!-- Default Credentials Hint -->
                <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="💡 بيانات الحساب الافتراضي للمسؤول:" 
                                   FontSize="12.5" FontWeight="Bold" 
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,2"/>
                        <TextBlock Text="اسم المستخدم: admin  |  كلمة المرور: Admin123" 
                                   FontSize="12.5" 
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- App Version -->
                <TextBlock Text="الإصدار: v1.0.0" 
                           FontSize="11.5" 
                           Foreground="{DynamicResource TextMutedBrush}" 
                           HorizontalAlignment="Center" 
                           Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Border>
</Window>
