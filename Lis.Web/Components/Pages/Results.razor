@page "/results"
@inject IResultService ResultService
@inject IOrderService OrderService
@inject AuthSessionService AuthSession
@inject ILabSettingsService LabSettingsService
@inject IQcService QcService
@inject NavigationManager NavManager
@inject DirectPrintService PrintService
@inject UserPreferencesService Prefs
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@Prefs.T("النتائج والاعتماد الطبي - MedLab", "Results Entry & Validation - MedLab")</PageTitle>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- 1. MEDLAB SUBNAV STRIP (Top Tabs & Actions)                    -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="medlab-subnav-strip">
    <!-- Left: Tabs (LAB PATIENTS & ORDERS / LAB RESULTS / QC-MEASUREMENT / REPORTS) -->
    <div class="medlab-subnav-tabs">
        <a class="medlab-subnav-tab @(CurrentOrderResults == null ? "active" : "")" @onclick="() => { CurrentOrderResults = null; SelectedOrderId = null; }" style="cursor: pointer;">
            <i class="fas fa-clipboard-list" style="font-size: 11px;"></i>
            <span>@Prefs.T("قائمة الطلبات والمراجعين", "PATIENTS & ORDERS")</span>
        </a>
        @if (CurrentOrderResults != null)
        {
            <a class="medlab-subnav-tab active">
                <i class="fas fa-microscope" style="font-size: 11px;"></i>
                <span>@Prefs.T("نتائج الفحوصات", "LAB RESULTS") (#@CurrentOrderResults.OrderId)</span>
            </a>
        }
        <a class="medlab-subnav-tab" @onclick='() => NavManager.NavigateTo("qc")'>
            <i class="fas fa-chart-line" style="font-size: 11px;"></i>
            <span>QC-MEASUREMENT</span>
        </a>
        <a class="medlab-subnav-tab" @onclick="OpenReportPreview">
            <i class="fas fa-file-alt" style="font-size: 11px;"></i>
            <span>REPORTS</span>
        </a>
    </div>

    <!-- Right: Action Buttons (Orders / Controllers / View Report / Save / Validate) -->
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <button class="medlab-btn-controller" type="button" @onclick='() => NavManager.NavigateTo("catalog")' title="Test Catalog & Controllers">
            CONTROLLERS
        </button>

        <button class="medlab-btn-report" type="button" @onclick="OpenReportPreview" title="View Patient A4 Report">
            VIEW REPORT
        </button>

        @if (CurrentOrderResults != null)
        {
            <button class="btn btn-sm btn-outline-success py-0 px-2 fw-bold" style="font-size: 11.5px; height: 26px;" @onclick="SaveResults" disabled="@IsProcessing" title="@Prefs.T("حفظ النتائج", "Save Results")">
                <i class="fas fa-save me-1"></i> @Prefs.T("حفظ", "SAVE")
            </button>
            <button class="btn btn-sm btn-primary py-0 px-2 fw-bold" style="font-size: 11.5px; height: 26px;" @onclick="ValidateResults" disabled="@IsProcessing" title="@Prefs.T("اعتماد النتائج", "Validate Results")">
                <i class="fas fa-check-double me-1"></i> @Prefs.T("اعتماد", "VALIDATE")
            </button>
        }

        <!-- Quick Actions Dropdown -->
        <div class="dropdown d-inline-block">
            <button class="btn btn-sm btn-light border px-2 py-1 text-muted" type="button" id="moreActionsMenu" data-bs-toggle="dropdown" aria-expanded="false" style="height: 26px;">
                <i class="fas fa-ellipsis-v"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="moreActionsMenu">
                <li><button class="dropdown-item small" type="button" @onclick="SaveResults"><i class="fas fa-save me-2 text-primary"></i> @Prefs.T("حفظ النتائج", "Save Results")</button></li>
                <li><button class="dropdown-item small" type="button" @onclick="ValidateResults"><i class="fas fa-check-double me-2 text-success"></i> @Prefs.T("اعتماد النتائج", "Validate Results")</button></li>
                <li><button class="dropdown-item small" type="button" @onclick="UnvalidateResults"><i class="fas fa-undo me-2 text-warning"></i> @Prefs.T("فك الاعتماد", "Unvalidate Results")</button></li>
                <li><hr class="dropdown-divider"></li>
                <li><button class="dropdown-item small" type="button" @onclick="PrintSilentReport"><i class="fas fa-bolt me-2 text-info"></i> @Prefs.T("طباعة صامتة فورية", "Direct Silent Print")</button></li>
                <li><button class="dropdown-item small" type="button" @onclick="ExportReportPdf"><i class="fas fa-file-pdf me-2 text-danger"></i> @Prefs.T("حفظ التقرير كـ PDF", "Save Report as PDF")</button></li>
            </ul>
        </div>

        @if (CurrentOrderResults != null)
        {
            <button class="btn btn-sm btn-light border text-danger px-2 py-1" type="button" @onclick="() => CurrentOrderResults = null" title="@Prefs.T("إغلاق والعودة للقائمة", "Close & Back to List")" style="height: 26px;">
                ✕
            </button>
        }
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- 2. MEDLAB PATIENT SWITCHER & EXPLORATION TOOLBAR                -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="medlab-patient-selector-bar">
    <!-- Left Section: Live Search & Patient Selector Dropdown -->
    <div class="d-flex align-items-center gap-2 flex-grow-1 flex-wrap">
        <!-- Live Instant Search with Suggestions -->
        <div class="position-relative" style="min-width: 260px; max-width: 320px; flex: 1;">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-light text-muted border-end-0">
                    <i class="fas fa-search"></i>
                </span>
                <input type="text" class="form-control border-start-0" 
                       placeholder="@Prefs.T("بحث بالاسم، MRN، أو الطلب...", "Search patient, MRN, order...")" 
                       @bind="PatientSearchQuery" @bind:event="oninput" 
                       @onfocus="() => ShowSearchSuggestions = true" />
                @if (!string.IsNullOrWhiteSpace(PatientSearchQuery))
                {
                    <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="ClearPatientSearch">✕</button>
                }
            </div>

            @if (ShowSearchSuggestions && FilteredOrders.Any() && !string.IsNullOrWhiteSpace(PatientSearchQuery))
            {
                <div class="medlab-search-popover">
                    @foreach (var order in FilteredOrders.Take(8))
                    {
                        <div class="medlab-search-item d-flex justify-content-between align-items-center" @onclick="() => SelectPatientFromSearch(order.OrderId)">
                            <div>
                                <div class="fw-bold text-medlab-navy" style="font-size: 11.5px;">@order.PatientName</div>
                                <div class="text-muted" style="font-size: 10px;">#@order.OrderId • @order.AgeDisplay • @order.OrderDatetime.ToString("dd.MM.yyyy HH:mm")</div>
                            </div>
                            <span class="@GetStatusTextClass(order.Status) fw-bold" style="font-size: 10px; background: transparent !important;">● @GetStatusDisplay(order.Status)</span>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Quick Patient Dropdown Selector -->
        <div class="d-flex align-items-center gap-1" style="min-width: 250px; max-width: 360px; flex: 1;">
            <select class="form-select form-select-sm" value="@SelectedOrderId" @onchange="OnDropdownOrderChanged" style="font-size: 11.5px; height: 30px;">
                @if (OrdersList == null || !OrdersList.Any())
                {
                    <option value="">@Prefs.T("لا توجد طلبات متاحة", "No orders available")</option>
                }
                else
                {
                    @foreach (var o in OrdersList)
                    {
                        <option value="@o.OrderId">
                            #@o.OrderId - @o.PatientName (@o.AgeDisplay) [@o.Status]
                        </option>
                    }
                }
            </select>
        </div>

        <!-- Stepper Navigation: Previous / Next Patient -->
        <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-outline-secondary" @onclick="SelectPreviousOrder" disabled="@(!HasPreviousOrder)" title="@Prefs.T("المراجع السابق", "Previous Patient")" style="height: 30px;">
                <i class="fas fa-chevron-left me-1"></i>
                <span class="d-none d-sm-inline">@Prefs.T("السابق", "Prev")</span>
            </button>
            <button type="button" class="btn btn-outline-secondary" @onclick="SelectNextOrder" disabled="@(!HasNextOrder)" title="@Prefs.T("المراجع التالي", "Next Patient")" style="height: 30px;">
                <span class="d-none d-sm-inline">@Prefs.T("التالي", "Next")</span>
                <i class="fas fa-chevron-right ms-1"></i>
            </button>
        </div>

        <!-- Patients Worklist Drawer Button -->
        <button type="button" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1" @onclick="ToggleOrdersDrawer" title="@Prefs.T("عرض جميع المراجعين", "View all patients list")" style="height: 30px;">
            <i class="fas fa-users"></i>
            <span class="fw-bold" style="font-size: 11px;">@Prefs.T("قائمة المراجعين", "ALL PATIENTS")</span>
            <span class="badge bg-primary text-white ms-1" style="font-size: 9.5px;">@(OrdersList?.Count ?? 0)</span>
        </button>
    </div>

    <!-- Right Section: Critical Values Indicator (Clean Red Tag Only, as requested) -->
    <div class="d-flex align-items-center gap-2">
        @if (CurrentOrderResults?.HasCriticalResults == true)
        {
            <span class="medlab-critical-tag" title="@string.Join(", ", CurrentOrderResults.CriticalResults.Select(r => $"{r.DisplayComponentName}: {r.ValueText} {r.Unit}"))">
                <i class="fas fa-circle-exclamation"></i>
                <span>@Prefs.T("توجد قيم حرجة", "CRITICAL VALUES")</span>
            </span>
        }

        @if (CurrentOrderResults != null)
        {
            <div class="d-none d-md-flex align-items-center gap-1 small text-muted" style="font-size: 11px;">
                <span class="fw-bold text-medlab-navy">#@CurrentOrderResults.OrderId</span>
                <span>•</span>
                <span class="@GetStatusTextClass(CurrentOrderResults.OrderStatus) fw-bold" style="font-size: 11px; background: transparent !important;">● @GetStatusDisplay(CurrentOrderResults.OrderStatus)</span>
            </div>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(AlertMessage))
{
    <div class="alert @AlertClass py-2 px-3 mb-3 small d-flex justify-content-between align-items-center">
        <span>@AlertMessage</span>
        <button type="button" class="btn-close btn-sm" @onclick='() => AlertMessage = ""'></button>
    </div>
}

@if (CurrentOrderResults == null)
{
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- ZERO STATE: FULL ORDERS & PATIENTS WORKLIST TABLE              -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <div class="card p-3 border-0 shadow-sm lis-card mb-3" style="border: 1px solid var(--medlab-border) !important; border-radius: 6px;">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div>
                <h6 class="fw-bold mb-1 d-flex align-items-center gap-2">
                    <i class="fas fa-clipboard-list text-primary"></i>
                    <span>@Prefs.T("قائمة مراجعي وطلبات المختبر (Laboratory Patients & Orders List)", "Laboratory Patients & Orders List")</span>
                </h6>
                <p class="text-secondary small mb-0" style="font-size: 11px;">
                    @Prefs.T("اختر مراجعاً لاستعراض وتعديل واعتماد نتائجه المخبرية", "Select a patient to inspect, edit and validate laboratory findings.")
                </p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="input-group input-group-sm" style="width: 240px;">
                    <span class="input-group-text bg-transparent border-end-0 text-muted">
                        <i class="fas fa-search"></i>
                    </span>
                    <input type="text" class="form-control border-start-0" placeholder="@Prefs.T("بحث باسم المريض أو MRN...", "Search patient or MRN...")" 
                           @bind="OrderSearch" @bind:event="oninput" @onkeyup="LoadOrders" />
                </div>
                <select class="form-select form-select-sm" style="width: 160px;" @bind="StatusFilter" @bind:after="LoadOrders">
                    <option value="">@Prefs.T("جميع الحالات (All)", "All Statuses")</option>
                    <option value="ResultReceived">ResultReceived</option>
                    <option value="Validated">Validated</option>
                    <option value="Collected">Collected</option>
                    <option value="InProgress">InProgress</option>
                </select>
                <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="LoadOrders" title="@Prefs.T("تحديث", "Refresh")">
                    <i class="fas fa-sync-alt"></i>
                </button>
            </div>
        </div>

        @if (OrdersList == null)
        {
            <div class="text-center py-5 text-muted">
                <div class="spinner-border spinner-border-sm text-primary mb-2"></div>
                <div>@Prefs.T("جاري تحميل مراجعي المختبر...", "Loading patients worklist...")</div>
            </div>
        }
        else if (!OrdersList.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-inbox fa-3x text-secondary opacity-50 mb-3"></i>
                <div>@Prefs.T("لا توجد طلبات مطابقة للبحث الحالي.", "No matching orders found.")</div>
            </div>
        }
        else
        {
            <div class="table-responsive" style="border: 1px solid var(--medlab-border); border-radius: 4px;">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background: rgba(0,0,0,0.04);">
                        <tr>
                            <th style="width: 80px;">@Prefs.T("الطلب", "ORDER #")</th>
                            <th>@Prefs.T("اسم المريض", "PATIENT NAME")</th>
                            <th style="width: 110px;">@Prefs.T("العمر / الجنس", "AGE / GENDER")</th>
                            <th style="width: 130px;">@Prefs.T("التاريخ والوقت", "DATETIME")</th>
                            <th>@Prefs.T("الفحوصات المطلوبة", "TESTS SUMMARY")</th>
                            <th style="width: 150px;" class="text-center">@Prefs.T("الحالة", "STATUS")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in OrdersList)
                        {
                            <tr style="cursor: pointer;" @onclick="() => SelectOrder(o.OrderId)">
                                <td class="font-monospace fw-bold text-primary">#@o.OrderId</td>
                                <td class="fw-bold">
                                    <i class="fas fa-user-circle me-1 text-primary"></i>
                                    @o.PatientName
                                </td>
                                <td>@o.AgeDisplay (@(o.Sex == "F" ? Prefs.T("أنثى", "F") : Prefs.T("ذكر", "M")))</td>
                                <td class="text-muted small font-monospace">@o.OrderDatetime.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="small text-truncate" style="max-width: 280px;" title="@o.TestsSummary">
                                    @(o.TestsSummary ?? "--")
                                </td>
                                <td class="text-center">
                                    <span class="@GetStatusTextClass(o.Status) fw-bold" style="font-size: 11.5px; background: transparent !important;">
                                        ● @GetStatusDisplay(o.Status)
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
else
{
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 3. MEDLAB 2-COLUMN MAIN LAYOUT (Findings Left + Context Right)   -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <div class="medlab-findings-layout">
        <!-- ── LEFT / MAIN COLUMN: Laborbefund Findings ─────────────── -->
        <div class="medlab-findings-card">
            <!-- Befund Header Title -->
            <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap gap-2">
                <div class="d-flex align-items-center">
                    <span class="medlab-befund-title-bar"></span>
                    <span class="medlab-befund-title">
                        @Prefs.T("تقرير الفحوصات المخبرية", "LABORATORY FINDINGS") @(CurrentOrderResults.Results.FirstOrDefault()?.InstrumentName?.ToUpper() ?? "MICROSEMI CRP"), @CurrentOrderResults.OrderDatetime.ToString("dd.MM.yyyy HH:mm")
                    </span>
                    @if (CurrentOrderResults.HasCriticalResults)
                    {
                        <span class="badge bg-danger text-white px-2 py-1 ms-2" style="font-size: 10px; font-weight: 700;">
                            <i class="fas fa-circle-exclamation me-1"></i> @Prefs.T("قيم حرجة", "CRITICAL")
                        </span>
                    }
                    <i class="fas fa-pencil-alt text-primary ms-2" style="font-size: 11px; cursor: pointer;" title="Edit Title"></i>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-success py-0 px-2 fw-bold" style="font-size: 11.5px; height: 26px;" 
                            @onclick="SaveResults" disabled="@(IsProcessing || CurrentOrderResults.OrderStatus == "Ordered")" 
                            title='@(CurrentOrderResults.OrderStatus == "Ordered" ? Prefs.T("يجب قبول العينات أولاً قبل الحفظ", "Accept specimens first") : Prefs.T("حفظ النتائج", "Save Results"))'>
                        <i class="fas fa-save me-1"></i> @Prefs.T("حفظ", "Save")
                    </button>
                    <button class="btn btn-sm btn-primary py-0 px-2 fw-bold" style="font-size: 11.5px; height: 26px;" 
                            @onclick="ValidateResults" disabled="@(IsProcessing || CurrentOrderResults.OrderStatus == "Ordered")"
                            title='@(CurrentOrderResults.OrderStatus == "Ordered" ? Prefs.T("يجب قبول العينات أولاً قبل الاعتماد", "Accept specimens first") : Prefs.T("اعتماد النتائج", "Validate Results"))'>
                        <i class="fas fa-check-double me-1"></i> @Prefs.T("اعتماد", "Validate")
                    </button>
                </div>
            </div>

            <!-- 4-Column Metadata Strip -->
            <div class="medlab-meta-grid">
                <div>
                    <span class="medlab-meta-label">@Prefs.T("المصدر / الجهاز", "ORIGIN / ANALYZER")</span>
                    <span class="medlab-meta-val">@(CurrentOrderResults.Results.FirstOrDefault()?.InstrumentName ?? "Microsemi CRP")</span>
                    <span class="medlab-meta-label mt-2">@Prefs.T("طريقة الإدخال", "ENTRY MODE")</span>
                    <span class="medlab-meta-val">@Prefs.T("آلي (مباشر)", "Automated")</span>
                </div>
                <div>
                    <span class="medlab-meta-label">@Prefs.T("وقت السحب", "COLLECTION TIME")</span>
                    <span class="medlab-meta-val">@CurrentOrderResults.OrderDatetime.ToString("dd.MM.yyyy HH:mm")</span>
                    <span class="medlab-meta-label mt-2">@Prefs.T("وقت التحليل", "ANALYSIS TIME")</span>
                    <span class="medlab-meta-val">@CurrentOrderResults.OrderDatetime.AddMinutes(19).ToString("dd.MM.yyyy HH:mm")</span>
                </div>
                <div>
                    <span class="medlab-meta-label">@Prefs.T("تم التدقيق بواسطة", "VERIFIED BY")</span>
                    <span class="medlab-meta-val">@(CurrentOrderResults.OrderStatus == "Validated" ? (LabSettings?.ManagerName ?? "Dr. med. Consultant") : "—")</span>
                    <span class="medlab-meta-label mt-2">@Prefs.T("الترحيل المالي", "BILLED / POSTED")</span>
                    <span class="medlab-meta-val">@Prefs.T("تم الترحيل", "Posted")</span>
                </div>
                <div>
                    <span class="medlab-meta-label">@Prefs.T("رقم الطلب", "SAMPLE / ORDER")</span>
                    <span class="medlab-meta-val text-primary font-monospace">#@CurrentOrderResults.OrderId</span>
                    <span class="medlab-meta-label mt-2">@Prefs.T("الحالة", "STATUS")</span>
                    <span class="medlab-meta-val">
                        <span class="@GetStatusTextClass(CurrentOrderResults.OrderStatus) fw-bold" style="font-size: 11.5px; background: transparent !important;">● @GetStatusDisplay(CurrentOrderResults.OrderStatus)</span>
                    </span>
                </div>
            </div>

            <!-- Add Catalog Item & Section Header -->
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="fw-bold" style="font-size: 12.5px; color: #0F172A;">
                    <i class="fas fa-chevron-down me-1" style="font-size: 10px;"></i>
                    <span>@Prefs.T("النتائج المخبرية", "LAB RESULTS") (@CurrentOrderResults.Results.Count)</span>
                </div>
            </div>

            <div class="medlab-add-catalog-bar">
                <input type="text" placeholder='@Prefs.T("إضافة فحص من الدليل الطبي...", "Add new catalog test...")' @bind="QuickAddTestQuery" @onkeydown="HandleQuickAddKey" />
                <button class="medlab-btn-add" type="button" @onclick="DoQuickAddTest" title="Add item">
                    <i class="fas fa-plus"></i>
                </button>
            </div>

            <!-- Clinical Specimen Rejection Record Banner -->
            @if (CurrentOrderResults.HasRejections)
            {
                @foreach (var rej in CurrentOrderResults.Rejections)
                {
                    <div class="alert alert-danger py-2 px-3 mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2 shadow-sm border border-danger border-opacity-25" style="border-radius: 6px; font-size: 12px; background: rgba(239, 68, 68, 0.1);">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-triangle-exclamation fs-5 text-danger"></i>
                            <div>
                                <div class="fw-bold text-danger d-flex align-items-center gap-2">
                                    <span>@Prefs.T("⚠️ عينة مرفوضة سريرياً:", "⚠️ Clinically Rejected Specimen:")</span>
                                    <span class="badge bg-danger font-monospace">@rej.SpecimenTypeName (#@rej.AccessionNo)</span>
                                    <span class="text-danger fw-bold">[@rej.DisplayReason]</span>
                                </div>
                                <div class="text-secondary small mt-1" style="font-size: 11px;">
                                    @if (!string.IsNullOrWhiteSpace(rej.Notes))
                                    {
                                        <span><strong>@Prefs.T("ملاحظات الفني:", "Technician Notes:")</strong> @rej.Notes &nbsp;|&nbsp; </span>
                                    }
                                    <span><strong>@Prefs.T("المسؤول:", "By:")</strong> @(rej.UserFullName ?? rej.Username ?? "فني المختبر") &nbsp;|&nbsp; </span>
                                    <span class="font-monospace text-muted">@rej.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                </div>
                            </div>
                        </div>
                        <div>
                            <span class="badge bg-danger text-white font-monospace px-2 py-1" style="font-size: 11px;">
                                <i class="fas fa-ban me-1"></i> @Prefs.T("مرفوضة طبياً - ممنوع إدخال النتائج", "REJECTED - RESULTS BLOCKED")
                            </span>
                        </div>
                    </div>
                }
            }

            <!-- Strict Specimen Acceptance Guard Banner -->
            @if (CurrentOrderResults.OrderStatus == "Ordered" || CurrentOrderResults.Results.Any(r => r.Status == "Ordered"))
            {
                <div class="alert alert-warning py-2 px-3 mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2 shadow-sm" style="border-radius: 6px; font-size: 12px; border: 1px solid #F59E0B; background: rgba(245, 158, 11, 0.12);">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fas fa-hand-holding-medical fs-5 text-warning"></i>
                        <div>
                            <strong class="text-medlab-navy">@Prefs.T("العينة بانتظار الاستلام والقبول في المختبر", "Specimen Awaiting Lab Acceptance")</strong>
                            <div class="text-secondary small" style="font-size: 11px;">@Prefs.T("النظام في الوضع الصارم: يجب فحص وقبول العينة سريرياً أولاً للسماح بإدخال أو حفظ النتائج.", "Strict QC: Specimen must be physically inspected and accepted in the lab before entering results.")</div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-sm btn-warning text-dark fw-bold px-3 py-1 d-flex align-items-center gap-1 shadow-sm" 
                            @onclick="AcceptCurrentOrderSpecimens" disabled="@IsProcessing" style="font-size: 11px; height: 30px;">
                        <i class="fas fa-check-circle"></i>
                        <span>@Prefs.T("استلام وقبول العينات الآن", "Accept & Receive Specimens Now")</span>
                    </button>
                </div>
            }

            <!-- The Clinical Table -->
            <div class="table-responsive" style="border: 1px solid var(--medlab-border); border-radius: 4px;">
                <table class="medlab-table">
                    <thead>
                        <tr>
                            <th>@Prefs.T("اسم التحليل / المكون", "TEST NAME / PARAMETER")</th>
                            <th class="text-end" style="width: 110px;">@Prefs.T("النتيجة", "VALUE")</th>
                            <th style="width: 90px;">@Prefs.T("الوحدة", "UNIT")</th>
                            <th>@Prefs.T("المدى الطبيعي", "REFERENCE RANGE")</th>
                            <th class="text-center" style="width: 40px;" title='@Prefs.T("طباعة", "Print flag")'>@Prefs.T("ط", "P")</th>
                            <th class="text-center" style="width: 40px;" title='@Prefs.T("معتمد", "Validated")'>@Prefs.T("ع", "V")</th>
                            <th style="width: 30px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var res in CurrentOrderResults.Results)
                        {
                            string flag = res.Flag?.ToUpper().Trim() ?? "";
                            bool isAbnormal = flag == "H" || flag == "HH" || flag == "L" || flag == "LL";
                            bool isInputDisabled = CurrentOrderResults.OrderStatus == "Ordered" || res.Status == "Ordered" || CurrentOrderResults.OrderStatus == "Validated" || res.Status == "Validated";
                            <tr>
                                <!-- Test / Component Name -->
                                <td class="fw-semibold" style="color: #0F172A;">
                                    @res.DisplayComponentName
                                </td>

                                <!-- Value (with clean red arrow if abnormal, per user request) -->
                                <td class="text-end">
                                    <div class="d-inline-flex align-items-center justify-content-end gap-1">
                                        <input type="text" class="form-control form-control-sm text-end fw-bold font-monospace p-1 @(isAbnormal ? "text-danger border-danger bg-danger bg-opacity-10" : "")" 
                                               style="width: 70px; height: 26px; font-size: 12.5px;"
                                               disabled="@isInputDisabled"
                                               title='@(isInputDisabled && (res.Status == "Ordered" || CurrentOrderResults.OrderStatus == "Ordered") ? Prefs.T("يجب استلام وقبول العينة أولاً لإدخال النتيجة", "Accept specimen first to enter result") : "")'
                                               @bind="res.ValueText" />
                                        @if (flag == "H" || flag == "HH")
                                        {
                                            <span class="medlab-flag-arrow" title="@Prefs.T("مرتفع", "High")">↑</span>
                                        }
                                        else if (flag == "L" || flag == "LL")
                                        {
                                            <span class="medlab-flag-arrow" title="@Prefs.T("منخفض", "Low")">↓</span>
                                        }
                                    </div>
                                </td>

                                <!-- Unit -->
                                <td class="text-muted small font-monospace">
                                    @res.Unit
                                </td>

                                <!-- Reference Range -->
                                <td class="small" style="color: #334155;">
                                    @res.ReferenceRangeText
                                </td>

                                <!-- B: Print Flag -->
                                <td class="text-center">
                                    <input class="form-check-input" type="checkbox" checked style="cursor: pointer;" title="Include in report" />
                                </td>

                                <!-- V: Validated Checkmark -->
                                <td class="text-center">
                                    <i class="fas fa-check text-primary" style="font-size: 12px;" title="Verified"></i>
                                </td>

                                <!-- Row Action Menu -->
                                <td class="text-center text-muted" style="cursor: pointer;">
                                    <i class="fas fa-ellipsis-v" style="font-size: 11px;"></i>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Documents Section (Collapsible Accordion) -->
            <div class="d-flex align-items-center gap-1 mt-3 pt-2 text-muted fw-bold" style="font-size: 12px; cursor: pointer;" @onclick="OpenReportPreview">
                <i class="fas fa-chevron-right" style="font-size: 10px;"></i>
                <span>@Prefs.T("المستندات والمرفقات", "DOCUMENTS") (4)</span>
            </div>
        </div>

        <!-- ── RIGHT COLUMN: Contextual Patient & Order Panel ───────── -->
        <div class="medlab-context-pane">
            <!-- 1. PATIENT INFORMATION -->
            <div class="medlab-context-card">
                <div class="medlab-card-navy-header">
                    @Prefs.T("بيانات المريض", "PATIENT INFORMATION")
                </div>
                <div class="medlab-card-body">
                    <div class="d-flex align-items-start justify-content-between gap-2">
                        <div>
                            <div class="patient-info-name">
                                @CurrentOrderResults.FullNameAr (@(CurrentOrderResults.Sex == "F" ? Prefs.T("أنثى", "Female") : Prefs.T("ذكر", "Male")))
                            </div>
                            <div class="patient-info-meta">
                                @CurrentOrderResults.AgeDisplay
                            </div>
                            <div class="patient-info-detail mt-2">
                                <i class="fas fa-phone-alt me-1 text-primary" style="font-size: 11px;"></i>
                                <span>@(string.IsNullOrWhiteSpace(CurrentOrderResults.Phone) ? "--" : CurrentOrderResults.Phone)</span>
                            </div>
                            <div class="patient-info-detail mt-1">
                                <i class="fas fa-map-marker-alt me-1 text-primary" style="font-size: 11px;"></i>
                                <span>@Prefs.T("العنوان", "ADDRESS")</span><br/>
                                <span class="text-muted">@Prefs.T("العنوان: غير محدد", "Address: Not specified")</span>
                            </div>
                        </div>
                        <div class="patient-avatar-placeholder">
                            <i class="fas fa-user"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. REPORT ASSIGNMENT -->
            <div class="medlab-context-card">
                <div class="medlab-card-navy-header">
                    @Prefs.T("ربط وتوجيه التقرير", "REPORT ASSIGNMENT")
                </div>
                <div class="medlab-card-body">
                    <label class="medlab-meta-label mb-1">@Prefs.T("الطبيب المحول", "REFERRING PHYSICIAN")</label>
                    <select class="form-select form-select-sm mb-2" style="font-size: 12px; border-color: #CBD5E1;">
                        <option>@(CurrentOrderResults.ReferringDoctor ?? (LabSettings?.ManagerName ?? "Dr. med. Consultant"))</option>
                    </select>

                    <label class="medlab-meta-label mb-1">@Prefs.T("الاستشارة / التاريخ", "CONSULTATION")</label>
                    <div class="d-flex align-items-center gap-1 small text-dark fw-semibold">
                        <i class="fas fa-calendar-alt text-primary"></i>
                        <span>@CurrentOrderResults.OrderDatetime.ToString("dd.MM.yyyy HH:mm")</span>
                        <span class="badge bg-light text-primary border ms-1 font-monospace">AL</span>
                        <span class="text-muted">@Prefs.T("تشخيص سريري", "Clinical Diagnosis")</span>
                    </div>
                </div>
            </div>

            <!-- 3. REMARKS -->
            <div class="medlab-context-card">
                <div class="medlab-card-navy-header d-flex justify-content-between align-items-center">
                    <span>@Prefs.T("الملاحظات السريرية", "CLINICAL REMARKS")</span>
                    <i class="fas fa-plus" style="cursor: pointer; font-size: 11px;" title='@Prefs.T("إضافة ملاحظة", "Add note")'></i>
                </div>
                <div class="medlab-card-body">
                    <p class="text-muted small mb-0">@Prefs.T("لا توجد ملاحظات مسجلة على هذا الطلب", "No clinical remarks recorded")</p>
                </div>
            </div>

            <!-- 4. SERVICES RENDERED -->
            <div class="medlab-context-card">
                <div class="medlab-card-navy-header">
                    @Prefs.T("تسجيل الخدمات وسحب العينات", "SERVICES RENDERED")
                </div>
                <div class="medlab-card-body">
                    <div class="form-check mb-1">
                        <input class="form-check-input" type="checkbox" id="chkKap">
                        <label class="form-check-label small" for="chkKap">@Prefs.T("سحب دم شعري", "Capillary blood draw")</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="chkVen" checked>
                        <label class="form-check-label small" for="chkVen">@Prefs.T("سحب دم وريدي", "Venous blood draw")</label>
                    </div>
                </div>
            </div>

            <!-- 5. DIAGNOSTIC GRAPH / HISTOGRAM (PLT) -->
            <div class="medlab-context-card">
                <div class="medlab-card-navy-header">
                    @Prefs.T("مخطط بياني ومستندات", "DIAGNOSTIC GRAPH")
                </div>
                <div class="medlab-card-body text-center p-2 bg-white">
                    <div class="fw-bold small text-dark mb-1 font-monospace">PLT</div>
                    <svg viewBox="0 0 240 100" style="width: 100%; height: 95px; background: #FFFFFF;">
                        <!-- Baseline & Cutoff -->
                        <line x1="15" y1="90" x2="225" y2="90" stroke="#CBD5E1" stroke-width="1" />
                        <line x1="210" y1="10" x2="210" y2="90" stroke="#64748B" stroke-dasharray="3,3" stroke-width="1" />
                        <text x="205" y="14" fill="#64748B" font-size="9" text-anchor="end" font-family="monospace">Max</text>
                        
                        <!-- Smooth Gaussian Curve -->
                        <path d="M 20 90 Q 50 15 90 20 T 160 85 L 180 90 Z" fill="rgba(239, 68, 68, 0.06)" stroke="#DC2626" stroke-width="1.5" />
                        
                        <!-- Frequency Histogram Lines -->
                        <path d="M 40 90 L 45 42 L 50 90 M 55 90 L 60 25 L 65 90 M 70 90 L 75 18 L 80 90 M 85 90 L 90 20 L 95 90 M 100 90 L 105 25 L 110 90 M 115 90 L 120 36 L 125 90 M 130 90 L 135 55 L 140 90 M 145 90 L 150 75 L 155 90" stroke="#EF4444" stroke-width="1" />
                    </svg>
                </div>
            </div>
        </div>
    </div>
}

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- SLIDE DRAWER / MODAL: SWITCH & EXPLORE PATIENTS                 -->
<!-- ═══════════════════════════════════════════════════════════════ -->
@if (IsOrdersDrawerOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(2px);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg bg-white" style="border-radius: 6px; border: 1px solid var(--medlab-border) !important;">
                <div class="modal-header d-flex justify-content-between align-items-center" style="background: var(--medlab-navy-header); color: #FFFFFF; padding: 10px 16px;">
                    <h6 class="modal-title fw-bold mb-0">
                        <i class="fas fa-users me-2"></i> @Prefs.T("استكشاف واختيار مراجعي المختبر", "Explore & Select Patients")
                    </h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="ToggleOrdersDrawer"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="d-flex gap-2 mb-3">
                        <div class="input-group input-group-sm flex-grow-1">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="fas fa-search"></i>
                            </span>
                            <input type="text" class="form-control border-start-0" placeholder="@Prefs.T("بحث باسم المريض أو MRN...", "Search patient or MRN...")" 
                                   @bind="OrderSearch" @bind:event="oninput" @onkeyup="LoadOrders" />
                        </div>
                        <select class="form-select form-select-sm" style="width: 170px;" @bind="StatusFilter" @bind:after="LoadOrders">
                            <option value="">@Prefs.T("جميع الحالات", "All Statuses")</option>
                            <option value="ResultReceived">ResultReceived</option>
                            <option value="Validated">Validated</option>
                            <option value="Collected">Collected</option>
                            <option value="InProgress">InProgress</option>
                        </select>
                    </div>
                    <div style="max-height: 420px; overflow-y: auto;" class="border rounded">
                        @if (OrdersList != null && OrdersList.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var o in OrdersList)
                                {
                                    <button type="button" class="list-group-item list-group-item-action p-2 d-flex justify-content-between align-items-center @(SelectedOrderId == o.OrderId ? "bg-light border-start border-3 border-primary" : "")" 
                                            @onclick="() => { SelectOrder(o.OrderId); ToggleOrdersDrawer(); }">
                                        <div>
                                            <strong class="d-block text-medlab-navy" style="font-size: 12.5px;">
                                                <i class="fas fa-user-circle me-1 text-primary"></i>
                                                @o.PatientName
                                            </strong>
                                            <small class="text-muted" style="font-size: 11px;">
                                                #@o.OrderId • @o.AgeDisplay • @o.OrderDatetime.ToString("dd.MM.yyyy HH:mm") • @o.TestsSummary
                                            </small>
                                        </div>
                                        <span class="@GetStatusTextClass(o.Status) fw-bold" style="font-size: 10px; background: transparent !important;">● @GetStatusDisplay(o.Status)</span>
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted">
                                @Prefs.T("لا توجد طلبات مطابقة للبحث", "No matching patients found")
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- MODAL: A4 Medical Patient Report Preview & Direct Print         -->
<!-- ═══════════════════════════════════════════════════════════════ -->
@if (IsReportModalOpen && CurrentOrderResults != null && LabSettings != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.85); backdrop-filter: blur(5px);">
        <div class="modal-dialog modal-xl modal-dialog-centered" style="max-width: 900px;">
            <div class="modal-content lis-card border-info" style="max-height: 95vh; display: flex; flex-direction: column;">
                <div class="modal-header border-bottom border-secondary d-flex justify-content-between align-items-center">
                    <h5 class="modal-title text-white fw-bold mb-0">
                        <i class="fas fa-file-medical text-info me-2"></i> @Prefs.T("تقرير الفحص الطبي الرسمي A4", "Official Medical Laboratory Report A4")
                    </h5>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <div class="input-group input-group-sm" style="width: auto; min-width: 240px;">
                            <span class="input-group-text bg-dark border-secondary text-info py-0">
                                <i class="fas fa-print"></i>
                            </span>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary font-monospace" @bind="SelectedReportPrinter" @bind:after="OnReportPrinterSelected">
                                <option value="">@Prefs.T("الافتراضية للتقارير", "Default Report") (@(ConfiguredReportPrinter ?? "Default"))</option>
                                @foreach (var printer in InstalledPrinters)
                                {
                                    <option value="@printer">@printer</option>
                                }
                            </select>
                            <button type="button" class="btn btn-outline-info" title='@Prefs.T("حفظ كطابعة افتراضية", "Save as default")' @onclick="SaveAsDefaultReportPrinter">
                                <i class="fas fa-floppy-disk"></i>
                            </button>
                        </div>
                        <button class="btn btn-danger btn-sm fw-bold px-3 d-flex align-items-center gap-1 shadow-sm" data-mdb-ripple-init @onclick="ExportReportPdf" disabled="@IsExportingPdf">
                            @if (IsExportingPdf)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span>@Prefs.T("جاري التصدير...", "Exporting...")</span>
                            }
                            else
                            {
                                <i class="fas fa-file-pdf"></i>
                                <span>@Prefs.T("حفظ كـ PDF", "Save as PDF")</span>
                            }
                        </button>
                        <button class="btn btn-primary btn-sm fw-bold px-3" data-mdb-ripple-init @onclick="PrintSilentReport">
                            <i class="fas fa-bolt me-1"></i> @Prefs.T("طباعة فورية", "Quick Print")
                        </button>
                        <button class="btn btn-success btn-sm fw-bold px-3" data-mdb-ripple-init onclick="window.print()">
                            <i class="fas fa-print me-1"></i> @Prefs.T("طباعة المتصفح", "Print Dialog")
                        </button>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => IsReportModalOpen = false"></button>
                    </div>
                </div>

                <div class="modal-body p-4 overflow-auto bg-white text-dark" style="flex: 1;" id="printable-report-area">
                    <!-- A4 Sheet Container -->
                    <div class="medical-report-container" style="font-family: 'Segoe UI', Tahoma, Arial, sans-serif; direction: ltr; text-align: left; color: #111;">
                        <!-- Header -->
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3" style="border-color: #0B4F8A !important; border-width: 2px !important;">
                            <div class="d-flex align-items-center gap-3">
                                @if (LabSettings.LogoData != null && LabSettings.LogoData.Length > 0)
                                {
                                    <div class="border rounded p-1 bg-white shadow-sm d-flex align-items-center justify-content-center" style="width: 75px; height: 75px; min-width: 75px;">
                                        <img src="data:image/png;base64,@Convert.ToBase64String(LabSettings.LogoData)" 
                                             alt="Lab Logo" 
                                             style="max-width: 68px; max-height: 68px; object-fit: contain;" />
                                    </div>
                                }
                                else
                                {
                                    <div class="d-inline-flex align-items-center justify-content-center rounded-3 bg-dark text-info shadow-sm"
                                         style="width: 65px; height: 65px; min-width: 65px; font-size: 32px; border: 2px solid #0B4F8A;">
                                        🔬
                                    </div>
                                }
                                <div>
                                    <h3 class="fw-bold mb-0 text-dark">
                                        @(string.IsNullOrWhiteSpace(LabSettings.LabNameEn) ? "MedLab Specialized Laboratory" : LabSettings.LabNameEn)
                                    </h3>
                                    <div class="fw-semibold text-secondary" style="font-size: 14px;">
                                        @(string.IsNullOrWhiteSpace(LabSettings.LabNameAr) ? "مختبر التحليلات التخصصي" : LabSettings.LabNameAr)
                                    </div>
                                    <div class="small text-muted" style="font-size: 11px;">
                                        @(string.IsNullOrWhiteSpace(LabSettings.ReportHeaderText) ? "Clinical Pathology, Biochemistry & Diagnostic Assays" : LabSettings.ReportHeaderText)
                                    </div>
                                    <small class="text-muted">@LabSettings.Address | Tel: @LabSettings.Phones</small>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold text-dark mb-1" style="font-size: 14px; letter-spacing: 1.5px;">
                                    MEDICAL LABORATORY REPORT
                                </div>
                                <div class="text-secondary small font-monospace">
                                    Patient ID: <strong class="text-dark">@CurrentOrderResults.Mrn</strong>
                                </div>
                                <div class="text-secondary small font-monospace">
                                    Sample No: <strong class="text-dark">@(CurrentOrderResults.Results.FirstOrDefault()?.AccessionNo ?? CurrentOrderResults.OrderId.ToString())</strong>
                                </div>
                                <div class="small text-muted" style="font-size: 10.5px;">
                                    Printed: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </div>
                        </div>

                        <!-- Patient Demographics Box -->
                        <div class="p-3 mb-3 rounded" style="background-color: #f8fafc; border: 1px solid #cbd5e1; font-size: 12.5px;">
                            <div class="row g-2 mb-1">
                                <div class="col-5"><strong>Patient Name:</strong> @CurrentOrderResults.FullNameAr @(!string.IsNullOrWhiteSpace(CurrentOrderResults.FullNameEn) ? $"({CurrentOrderResults.FullNameEn})" : "")</div>
                                <div class="col-4"><strong>MRN:</strong> <span class="font-monospace fw-bold">@CurrentOrderResults.Mrn</span></div>
                                <div class="col-3 text-end"><strong>Order ID:</strong> <span class="font-monospace fw-bold">#@CurrentOrderResults.OrderId</span></div>
                            </div>
                            <div class="row g-2 text-muted" style="font-size: 11.5px;">
                                <div class="col-3"><strong>Age:</strong> @CurrentOrderResults.AgeDisplay</div>
                                <div class="col-2"><strong>Gender:</strong> @CurrentOrderResults.GenderDisplay</div>
                                <div class="col-4"><strong>Referring Doctor:</strong> @(CurrentOrderResults.ReferringDoctor ?? "Self / None")</div>
                                <div class="col-3 text-end"><strong>Date:</strong> @CurrentOrderResults.OrderDatetime.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </div>

                        <!-- Results Table in Report -->
                        @foreach (var deptGroup in CurrentOrderResults.Results.GroupBy(r => r.DisplayDepartmentName))
                        {
                            <div class="department-section mb-3">
                                <div class="d-flex align-items-center justify-content-between px-3 py-1 mb-2 rounded" 
                                     style="background-color: #f1f5f9; color: #0B4F8A; border: 1px solid #cbd5e1; border-left: 5px solid #0B4F8A;">
                                    <div class="fw-bold" style="font-size: 13px; letter-spacing: 0.5px;">
                                        <i class="fas fa-microscope text-primary me-2"></i>
                                        <span>@deptGroup.Key.ToUpperInvariant()</span>
                                    </div>
                                    <span class="badge bg-white text-secondary border font-monospace" style="font-size: 10px;">
                                        @deptGroup.Count() @(deptGroup.Count() == 1 ? "TEST" : "TESTS")
                                    </span>
                                </div>

                                <table class="table table-bordered table-sm mb-2" style="border-color: #cbd5e1; font-size: 13px;">
                                    <thead style="background-color: #f1f5f9; color: #1e293b;">
                                        <tr>
                                            <th style="width: 34%; text-align: left;">Test / Parameter</th>
                                            <th style="width: 17%; text-align: center;">Result</th>
                                            <th style="width: 13%; text-align: center;">Flag</th>
                                            <th style="width: 14%; text-align: center;">Unit</th>
                                            <th style="width: 22%; text-align: left;">Reference Range</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in deptGroup)
                                        {
                                            bool hasFlag = !string.IsNullOrEmpty(r.Flag) && r.Flag != "N";
                                            <tr style="border-bottom: 1px solid #e2e8f0;">
                                                <td class="fw-semibold text-dark">@r.DisplayComponentName</td>
                                                <td class="text-center fw-bold @(hasFlag ? "text-danger" : "text-dark")" style="font-size: 14px;">
                                                    @(string.IsNullOrWhiteSpace(r.ValueText) ? "--" : r.ValueText)
                                                </td>
                                                <td class="text-center font-monospace">
                                                    @if (r.Flag == "H" || r.Flag == "HH")
                                                    {
                                                        <strong class="text-danger fw-bold">@(r.Flag == "HH" ? "HH ↑↑" : "H ↑")</strong>
                                                    }
                                                    else if (r.Flag == "L" || r.Flag == "LL")
                                                    {
                                                        <strong class="text-primary fw-bold">@(r.Flag == "LL" ? "LL ↓↓" : "L ↓")</strong>
                                                    }
                                                    else if (r.Flag == "N" || !string.IsNullOrWhiteSpace(r.ValueText))
                                                    {
                                                        <span class="text-success fw-bold">N</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">--</span>
                                                    }
                                                </td>
                                                <td class="text-center text-secondary font-monospace" style="font-size: 12px;">@r.Unit</td>
                                                <td class="small fw-semibold text-secondary" style="font-size: 12px;">@r.ReferenceRangeText</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <!-- Footer and Signatures -->
                        <div class="row pt-3 mt-3 border-top" style="border-color: #cbd5e1 !important;">
                            <div class="col-7">
                                <small class="text-muted d-block mb-1 fw-bold">Laboratory Clinical Notes:</small>
                                <small class="text-secondary" style="font-size: 11px;">@(string.IsNullOrWhiteSpace(LabSettings.ReportFooterText) ? "Notice: Laboratory results should be interpreted in conjunction with other clinical findings." : LabSettings.ReportFooterText)</small>
                            </div>
                            <div class="col-5 text-center">
                                <small class="text-muted d-block mb-1" style="font-size: 11px;">Consultant / Laboratory Director:</small>
                                <strong class="d-block text-dark" style="font-size: 14px;">@LabSettings.ManagerName</strong>
                                <small class="text-secondary d-block">@LabSettings.ManagerTitle</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top border-secondary d-flex justify-content-between align-items-center">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => IsReportModalOpen = false">@Prefs.T("إغلاق", "Close")</button>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-danger fw-bold px-3 d-flex align-items-center gap-1 shadow-sm" @onclick="ExportReportPdf" disabled="@IsExportingPdf">
                            @if (IsExportingPdf)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span>@Prefs.T("جاري إنشاء PDF...", "Generating PDF...")</span>
                            }
                            else
                            {
                                <i class="fas fa-file-pdf"></i>
                                <span>@Prefs.T("حفظ كـ PDF", "Save as PDF")</span>
                            }
                        </button>
                        <button type="button" class="btn btn-success fw-bold px-4" onclick="window.print()">
                            <i class="fas fa-print me-1"></i> @Prefs.T("طباعة المتصفح A4", "Browser Print A4")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "orderId")]
    public long? QueryOrderId { get; set; }

    [SupplyParameterFromQuery(Name = "openReport")]
    public bool QueryOpenReport { get; set; }

    private List<OrderWorklistHeaderDto>? OrdersList;
    private OrderResultsDto? CurrentOrderResults;
    private LabSettingsDto? LabSettings;
    private long? SelectedOrderId;
    private string OrderSearch = "";
    private string StatusFilter = "";
    private string PatientSearchQuery = "";
    private bool ShowSearchSuggestions = false;
    private string AlertMessage = "";
    private string AlertClass = "alert-success";

    private CancellationTokenSource? _alertCts;

    private void SetAlert(string message, string alertClass = "alert-success", int autoDismissMs = 4500)
    {
        _alertCts?.Cancel();
        _alertCts = new CancellationTokenSource();
        var token = _alertCts.Token;

        AlertClass = alertClass;
        AlertMessage = message;

        if (autoDismissMs > 0)
        {
            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(autoDismissMs, token);
                    if (!token.IsCancellationRequested)
                    {
                        AlertMessage = "";
                        await InvokeAsync(StateHasChanged);
                    }
                }
                catch (TaskCanceledException) { }
            }, token);
        }
    }
    private bool IsProcessing = false;
    private bool IsReportModalOpen = false;
    private bool IsOrdersDrawerOpen = false;
    private bool IsExportingPdf = false;
    private string QuickAddTestQuery = "";
    private List<string> QcWarningBanners = new();
    private List<string> InstalledPrinters = new();
    private string? SelectedReportPrinter = "";
    private string? ConfiguredReportPrinter = "";

    private IEnumerable<OrderWorklistHeaderDto> FilteredOrders
    {
        get
        {
            if (OrdersList == null) return Enumerable.Empty<OrderWorklistHeaderDto>();
            if (string.IsNullOrWhiteSpace(PatientSearchQuery)) return OrdersList;
            var q = PatientSearchQuery.Trim().ToLowerInvariant();
            return OrdersList.Where(o => 
                (o.PatientName?.ToLowerInvariant().Contains(q) ?? false) ||
                o.OrderId.ToString().Contains(q) ||
                (o.TestsSummary?.ToLowerInvariant().Contains(q) ?? false));
        }
    }

    private int CurrentIndex => OrdersList?.FindIndex(o => o.OrderId == SelectedOrderId) ?? -1;
    private bool HasPreviousOrder => CurrentIndex > 0;
    private bool HasNextOrder => OrdersList != null && CurrentIndex >= 0 && CurrentIndex < OrdersList.Count - 1;

    protected override async Task OnInitializedAsync()
    {
        Prefs.OnChange += OnPrefsChanged;
        try
        {
            InstalledPrinters = PrintService.GetInstalledPrinters();
            LabSettings = await LabSettingsService.GetSettingsAsync();
            ConfiguredReportPrinter = LabSettings?.ReportPrinter;
            SelectedReportPrinter = ConfiguredReportPrinter ?? "";

            await LoadOrders();

            if (QueryOrderId.HasValue && QueryOrderId.Value > 0)
            {
                await SelectOrder(QueryOrderId.Value);
            }

            if (QueryOpenReport && CurrentOrderResults != null)
            {
                IsReportModalOpen = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Results Init Error] {ex.Message}");
        }
    }

    private void ToggleOrdersDrawer()
    {
        IsOrdersDrawerOpen = !IsOrdersDrawerOpen;
    }

    private async Task LoadOrders()
    {
        try
        {
            OrdersList = await ResultService.GetOrdersForResultsAsync(
                status: string.IsNullOrWhiteSpace(StatusFilter) ? null : StatusFilter,
                search: string.IsNullOrWhiteSpace(OrderSearch) ? null : OrderSearch.Trim(),
                limit: 200);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LoadOrders Error] {ex.Message}");
        }
    }

    private async Task SelectOrder(long orderId)
    {
        SelectedOrderId = orderId;
        AlertMessage = "";
        QcWarningBanners.Clear();
        ShowSearchSuggestions = false;
        try
        {
            CurrentOrderResults = await ResultService.GetOrderResultsAsync(orderId);
            if (CurrentOrderResults?.Results != null)
            {
                var instrumentItems = CurrentOrderResults.Results
                    .Where(r => r.InstrumentId.HasValue && r.InstrumentId.Value > 0)
                    .GroupBy(r => (r.InstrumentId!.Value, r.ComponentId))
                    .Select(g => g.First())
                    .ToList();

                foreach (var itm in instrumentItems)
                {
                    try
                    {
                        var st = await QcService.GetTodayQcStatusAsync(itm.InstrumentId!.Value, itm.ComponentId);
                        if (st.Status == "NotRun")
                        {
                            QcWarningBanners.Add($"فحص [{itm.DisplayComponentName}] لم تُسجَّل له قراءة ضبط جودة (QC) اليوم على جهاز [{itm.InstrumentName ?? "الجهاز"}]");
                        }
                        else if (st.Status == "Failed")
                        {
                            QcWarningBanners.Add($"فحص [{itm.DisplayComponentName}] لديه مخالفة ضبط جودة نشطة ({st.LastViolation}) على جهاز [{itm.InstrumentName ?? "الجهاز"}]");
                        }
                    }
                    catch { }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SelectOrder Error] {ex.Message}");
        }
    }

    private async Task OnDropdownOrderChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var id))
        {
            await SelectOrder(id);
        }
    }

    private async Task SelectPreviousOrder()
    {
        if (OrdersList == null || !HasPreviousOrder) return;
        var prevOrder = OrdersList[CurrentIndex - 1];
        await SelectOrder(prevOrder.OrderId);
    }

    private async Task SelectNextOrder()
    {
        if (OrdersList == null || !HasNextOrder) return;
        var nextOrder = OrdersList[CurrentIndex + 1];
        await SelectOrder(nextOrder.OrderId);
    }

    private async Task SelectPatientFromSearch(long orderId)
    {
        ShowSearchSuggestions = false;
        PatientSearchQuery = "";
        await SelectOrder(orderId);
    }

    private void ClearPatientSearch()
    {
        PatientSearchQuery = "";
        ShowSearchSuggestions = false;
    }

    private async Task AcceptCurrentOrderSpecimens()
    {
        if (CurrentOrderResults == null) return;
        IsProcessing = true;
        AlertMessage = "";

        try
        {
            await OrderService.MarkOrderSpecimensCollectedAsync(CurrentOrderResults.OrderId, AuthSession?.CurrentUser?.Id);
            AlertClass = "alert-success";
            AlertMessage = Prefs.T("✅ تم استلام وقبول عينات الطلب بنجاح! تم فتح إدخال النتائج.", "✅ Specimen accepted successfully! Result entry unlocked.");
            await SelectOrder(CurrentOrderResults.OrderId);
            await LoadOrders();
        }
        catch (Exception ex)
        {
            AlertClass = "alert-danger";
            AlertMessage = $"❌ {ex.Message}";
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task SaveResults()
    {
        if (CurrentOrderResults == null) return;
        IsProcessing = true;
        AlertMessage = "";

        try
        {
            var batch = CurrentOrderResults.Results
                .Select(r => (r.OrderTestId, r.ComponentId, r.ValueText))
                .ToList();

            await ResultService.SaveOrderResultsBatchAsync(CurrentOrderResults.OrderId, batch, currentUserId: AuthSession?.CurrentUser?.Id ?? 1);
            SetAlert(Prefs.T("✅ تم حفظ النتائج بنجاح! وتم تحديث التنبيهات تلقائياً.", "✅ Results saved successfully! Alerts updated automatically."), "alert-success");
            await SelectOrder(CurrentOrderResults.OrderId);
            await LoadOrders();
        }
        catch (Exception ex)
        {
            SetAlert(Prefs.T($"حدث خطأ أثناء الحفظ: {ex.Message}", $"Error saving results: {ex.Message}"), "alert-danger");
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task ValidateResults()
    {
        if (CurrentOrderResults == null) return;
        IsProcessing = true;
        AlertMessage = "";

        try
        {
            await ResultService.ValidateOrderResultsAsync(CurrentOrderResults.OrderId, validatorUserId: 1);
            SetAlert(Prefs.T("✅ تم اعتماد وتوثيق النتائج الطبية بنجاح!", "✅ Medical results verified and signed off successfully!"), "alert-success");
            await SelectOrder(CurrentOrderResults.OrderId);
            await LoadOrders();
        }
        catch (Exception ex)
        {
            SetAlert(Prefs.T($"فشل الاعتماد: {ex.Message}", $"Verification failed: {ex.Message}"), "alert-danger");
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task UnvalidateResults()
    {
        if (CurrentOrderResults == null) return;

        bool confirmed = await JS.InvokeAsync<bool>("lisConfirm",
            Prefs.T("تأكيد فك الاعتماد الطبي", "Confirm Medical Unvalidation"),
            Prefs.T($"هل أنت متأكد من فك اعتماد النتائج الطبية للطلب رقم (#{CurrentOrderResults.OrderId})؟ سيتم إعادة فتح الطلب وإتاحة تعديل نتائج الفحوصات.",
                    $"Are you sure you want to unvalidate medical results for order #{CurrentOrderResults.OrderId}? The results will become editable again."),
            Prefs.T("نعم، فك الاعتماد", "Yes, Unvalidate"),
            Prefs.T("تراجع", "Cancel"),
            "warning");
        if (!confirmed) return;

        IsProcessing = true;
        AlertMessage = "";

        try
        {
            await ResultService.UnvalidateOrderResultsAsync(CurrentOrderResults.OrderId, currentUserId: 1);
            SetAlert(Prefs.T("↩ تم فك الاعتماد للطلب لإتاحة التعديل.", "↩ Results unlocked for editing."), "alert-warning");
            await SelectOrder(CurrentOrderResults.OrderId);
            await LoadOrders();
        }
        catch (Exception ex)
        {
            SetAlert(Prefs.T($"فشل فك الاعتماد: {ex.Message}", $"Unlock failed: {ex.Message}"), "alert-danger");
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task PrintSilentReport()
    {
        if (CurrentOrderResults == null) return;
        try
        {
            var targetPrinter = string.IsNullOrWhiteSpace(SelectedReportPrinter) ? null : SelectedReportPrinter;
            var res = await PrintService.PrintReportDirectAsync(CurrentOrderResults, targetPrinter);
            AlertClass = res.Success ? "alert-success" : "alert-danger";
            AlertMessage = res.Message;
        }
        catch (Exception ex)
        {
            AlertClass = "alert-danger";
            AlertMessage = $"خطأ أثناء الطباعة الصامتة للتقرير: {ex.Message}";
        }
    }

    private async Task ExportReportPdf()
    {
        if (CurrentOrderResults == null) return;

        bool wasClosed = !IsReportModalOpen;
        if (wasClosed)
        {
            IsReportModalOpen = true;
            StateHasChanged();
            await Task.Delay(250);
        }

        try
        {
            IsExportingPdf = true;
            StateHasChanged();

            var safeName = string.Join("_", (CurrentOrderResults.FullNameAr ?? CurrentOrderResults.FullNameEn ?? "Patient").Split(System.IO.Path.GetInvalidFileNameChars())).Replace(" ", "_");
            var filename = $"Medical_Report_{CurrentOrderResults.Mrn}_{safeName}_{DateTime.Now:yyyyMMdd_HHmm}.pdf";

            await JS.InvokeVoidAsync("lisExportReportToPdf", "printable-report-area", filename);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[PDF Export Error] {ex.Message}");
            AlertClass = "alert-danger";
            AlertMessage = Prefs.T($"حدث خطأ أثناء تصدير PDF: {ex.Message}", $"Error exporting PDF: {ex.Message}");
        }
        finally
        {
            IsExportingPdf = false;
            StateHasChanged();
        }
    }

    private async Task OnReportPrinterSelected()
    {
        await SaveAsDefaultReportPrinter();
    }

    private async Task SaveAsDefaultReportPrinter()
    {
        if (LabSettings == null) return;
        try
        {
            LabSettings.ReportPrinter = string.IsNullOrWhiteSpace(SelectedReportPrinter) ? null : SelectedReportPrinter;
            await LabSettingsService.SaveSettingsAsync(LabSettings, currentUserId: 1);
            ConfiguredReportPrinter = LabSettings.ReportPrinter;
            AlertClass = "alert-success";
            AlertMessage = Prefs.T($"✅ تم حفظ وتعيين [{ConfiguredReportPrinter ?? "طابعة التقارير الافتراضية"}] كطابعة افتراضية للتقارير بنجاح!", $"✅ Saved [{ConfiguredReportPrinter ?? "Default Report Printer"}] as system default report printer!");
        }
        catch (Exception ex)
        {
            AlertClass = "alert-danger";
            AlertMessage = Prefs.T($"حدث خطأ أثناء حفظ الطابعة: {ex.Message}", $"Error saving report printer: {ex.Message}");
        }
    }

    private void HandleQuickAddKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            DoQuickAddTest();
        }
    }

    private void DoQuickAddTest()
    {
        if (string.IsNullOrWhiteSpace(QuickAddTestQuery)) return;
        NavManager.NavigateTo($"catalog?search={Uri.EscapeDataString(QuickAddTestQuery.Trim())}");
    }

    private void OpenReportPreview()
    {
        IsReportModalOpen = true;
    }

    private string GetStatusTextClass(string? status) => status?.ToLower() switch
    {
        "validated" => "text-success",
        "resultreceived" => "text-primary",
        "inprogress" => "text-warning",
        "collected" => "text-info",
        "ordered" => "text-primary",
        "cancelled" => "text-muted",
        _ => "text-secondary"
    };

    private string GetStatusDisplay(string? status) => status?.ToLower() switch
    {
        "validated" => Prefs.T("معتمد", "Validated"),
        "resultreceived" => Prefs.T("وصلت النتائج", "ResultReceived"),
        "inprogress" => Prefs.T("قيد التحليل", "InProgress"),
        "collected" => Prefs.T("تم السحب", "Collected"),
        "ordered" => Prefs.T("مطلوب", "Ordered"),
        "cancelled" => Prefs.T("ملغي", "Cancelled"),
        _ => status ?? "--"
    };

    private string GetStatusBadgeClass(string? status) => status?.ToLower() switch
    {
        "validated" => "bg-success text-white",
        "resultreceived" => "bg-primary text-white",
        "inprogress" => "bg-warning text-dark",
        "collected" => "bg-info text-dark",
        _ => "bg-secondary text-white"
    };

    private void OnPrefsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _alertCts?.Cancel();
        _alertCts?.Dispose();
        Prefs.OnChange -= OnPrefsChanged;
    }
}
