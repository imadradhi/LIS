    private async Task SaveUpdatedMapping(InstrumentMappingItemDto map)
    {
        if (SelectedComponentForRanges == null || ModalTest == null) return;

        if (string.IsNullOrWhiteSpace(map.InstrumentTestCode))
        {
            SetModalAlert(Prefs.T("يرجى كتابة كود الفحص في الجهاز قبل الحفظ.", "Please enter the instrument test code before saving."), "alert-warning");
            return;
        }

        try
        {
            await CatalogService.AddOrUpdateInstrumentMappingAsync(
                map.InstrumentId,
                ModalTest.Id,
                SelectedComponentForRanges.Id,
                map.InstrumentTestCode.Trim(),
                map.ReportableLow,
                map.ReportableHigh,
                userId: 1);

            SetModalAlert(Prefs.T($"✅ تم حفظ وتحديث كود الجهاز [{map.InstrumentName}] إلى ({map.InstrumentTestCode.Trim()}) بنجاح!", $"✅ Instrument [{map.InstrumentName}] test code updated to ({map.InstrumentTestCode.Trim()}) successfully!"), "alert-success");

            ComponentInstrumentMappings = (await CatalogService.GetInstrumentMappingsForComponentAsync(SelectedComponentForRanges.Id)).ToList();
            await ReloadModalComponents();

            var updated = ModalComponentsList?.FirstOrDefault(c => c.Id == SelectedComponentForRanges.Id);
            if (updated != null)
            {
                SelectedComponentForRanges.InstrumentName = updated.InstrumentName;
                SelectedComponentForRanges.InstrumentCode = updated.InstrumentCode;
                SelectedComponentForRanges.InstrumentTestCode = updated.InstrumentTestCode;
            }
        }
        catch (Exception ex)
        {
            SetModalAlert(Prefs.T($"خطأ أثناء حفظ كود الجهاز: {ex.Message}", $"Error saving instrument test code: {ex.Message}"), "alert-danger");
        }
    }

    private void EditReferenceRange(ReferenceRangeDto rng)
    {
        NewRangeModel = new ReferenceRangeDto
        {
            Id = rng.Id,
            RangeCode = rng.RangeCode,
            ComponentId = rng.ComponentId,
            Sex = rng.Sex,
            AgeMin = rng.AgeMin,
            AgeMax = rng.AgeMax,
            AgeUnit = rng.AgeUnit ?? "Years",
            Low = rng.Low,
            High = rng.High,
            CriticalLow = rng.CriticalLow,
            CriticalHigh = rng.CriticalHigh,
            Note = rng.Note
        };
        IsAddingRangeMode = true;
    }

    private void ResetRangeForm()
    {
        NewRangeModel = new ReferenceRangeDto
        {
            Id = 0,
            ComponentId = SelectedComponentForRanges?.Id ?? 0,
            Sex = "B",
            AgeMin = 18,
            AgeMax = 100,
            AgeUnit = "Years",
            Low = null,
            High = null,
            CriticalLow = null,
            CriticalHigh = null,
            Note = null
        };
    }

    private async Task SaveReferenceRange()
    {
        if (SelectedComponentForRanges == null) return;

        try
        {
            bool isUpdate = NewRangeModel.Id > 0;
            NewRangeModel.ComponentId = SelectedComponentForRanges.Id;
            await CatalogService.SaveReferenceRangeAsync(NewRangeModel, userId: 1);

            SetModalAlert(Prefs.T(isUpdate 
                ? "✅ تم تحديث المدى المرجعي بنجاح!" 
                : "✅ تمت إضافة المدى المرجعي بنجاح!",
                isUpdate
                ? "✅ Reference range updated successfully!"
                : "✅ Reference range added successfully!"), "alert-success");

            ComponentRangesList = (await CatalogService.GetReferenceRangesAsync(SelectedComponentForRanges.Id)).ToList();
            await ReloadModalComponents();
            ResetRangeForm();
            IsAddingRangeMode = false;
        }
        catch (Exception ex)
        {
            SetModalAlert(Prefs.T($"خطأ أثناء حفظ المدى: {ex.Message}", $"Error saving reference range: {ex.Message}"), "alert-danger");
        }
    }

    private async Task DeleteReferenceRange(long rangeId)
    {
        if (SelectedComponentForRanges == null) return;

        bool confirmed = await JS.InvokeAsync<bool>("lisConfirm",
            Prefs.T("تأكيد حذف المدى الطبيعي", "Confirm Reference Range Deletion"),
            Prefs.T("هل أنت متأكد من حذف هذا المدى المرجعي الطبيعي؟", "Are you sure you want to delete this reference range?"),
            Prefs.T("نعم، احذف المدى", "Yes, Delete Range"),
            Prefs.T("تراجع", "Cancel"),
            "danger");
        if (!confirmed) return;

        try
        {
            await CatalogService.DeleteReferenceRangeAsync(rangeId, userId: 1);
            SetModalAlert(Prefs.T("🗑️ تم حذف المدى الطبيعي بنجاح.", "🗑️ Reference range deleted successfully."), "alert-success");

            ComponentRangesList = (await CatalogService.GetReferenceRangesAsync(SelectedComponentForRanges.Id)).ToList();
            await ReloadModalComponents();
        }
        catch (Exception ex)
        {
            SetModalAlert(Prefs.T($"خطأ أثناء حذف المدى: {ex.Message}", $"Error deleting reference range: {ex.Message}"), "alert-danger");
        }
    }

    private void OnPrefsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _alertCts?.Cancel();
        _alertCts?.Dispose();
        _modalAlertCts?.Cancel();
        _modalAlertCts?.Dispose();
        Prefs.OnChange -= OnPrefsChanged;
    }

    private static string GetTubeColor(string? specimenType)
    {
        if (string.IsNullOrEmpty(specimenType)) return "#94A3B8";
        var s = specimenType.ToLower();
        if (s.Contains("edta") || s.Contains("purple") || s.Contains("lavender")) return "#8B5CF6"; // Purple
        if (s.Contains("serum") || s.Contains("red") || s.Contains("gold") || s.Contains("yellow")) return "#EF4444"; // Red
        if (s.Contains("citrate") || s.Contains("blue")) return "#3B82F6"; // Blue
        if (s.Contains("heparin") || s.Contains("green")) return "#10B981"; // Green
        if (s.Contains("glucose") || s.Contains("gray")) return "#64748B"; // Gray
        return "#00B4D8";
    }
