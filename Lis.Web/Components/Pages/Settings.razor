                                    <td style="padding: 4px 8px; text-align: center; color: #10b981; font-weight: bold; font-family: monospace;">N</td>
                                    <td style="padding: 4px 8px; text-align: center; color: #64748b;">g/dL</td>
                                    <td style="padding: 4px 8px; color: #64748b;">13.0 - 17.0</td>
                                </tr>
                                <tr style="border-bottom: 1px solid #e2e8f0;">
                                    <td style="padding: 4px 8px 4px 18px; font-weight: 600;">Platelets (PLT)</td>
                                    <td style="padding: 4px 8px; text-align: center; font-weight: bold;">250</td>
                                    <td style="padding: 4px 8px; text-align: center; color: #10b981; font-weight: bold; font-family: monospace;">N</td>
                                    <td style="padding: 4px 8px; text-align: center; color: #64748b;">10^3/uL</td>
                                    <td style="padding: 4px 8px; color: #64748b;">150 - 450</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Group 2: Clinical Biochemistry Department -->
                    <div class="mb-3">
                        <div class="d-flex align-items-center justify-content-between px-2 py-1 mb-1 rounded" style="background-color: #f1f5f9; color: #0b132b; border: 1px solid #cbd5e1; border-left: 4px solid #00B4D8;">
                            <span class="fw-bold" style="font-size: 11.5px; letter-spacing: 0.5px;">
                                <i class="fas fa-flask text-info me-1"></i> BIOCHEMISTRY
                            </span>
                            <span class="badge bg-white text-secondary border" style="font-size: 9.5px;">2 TESTS</span>
                        </div>
                        <table style="width: 100%; font-size: 11px; margin-bottom: 8px; border-collapse: collapse;">
                            <thead>
                                <tr style="background-color: #f1f5f9; border-bottom: 2px solid #cbd5e1; font-weight: bold;">
                                    <th style="padding: 5px 8px; text-align: left; width: 34%;">Test / Component</th>
                                    <th style="padding: 5px 8px; text-align: center; width: 18%;">Result</th>
                                    <th style="padding: 5px 8px; text-align: center; width: 12%;">Flag</th>
                                    <th style="padding: 5px 8px; text-align: center; width: 14%;">Unit</th>
                                    <th style="padding: 5px 8px; text-align: left; width: 22%;">Reference Range</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="border-bottom: 1px solid #e2e8f0;">
                                    <td style="padding: 5px 8px; font-weight: 600;">Fasting Blood Sugar (GLUC)</td>
                                    <td style="padding: 5px 8px; text-align: center; font-weight: bold;">95</td>
                                    <td style="padding: 5px 8px; text-align: center; color: #10b981; font-weight: bold; font-family: monospace;">N</td>
                                    <td style="padding: 5px 8px; text-align: center; color: #64748b;">mg/dL</td>
                                    <td style="padding: 5px 8px; color: #64748b;">70 - 105</td>
                                </tr>
                                <tr style="border-bottom: 1px solid #e2e8f0;">
                                    <td style="padding: 5px 8px; font-weight: 600;">Serum Triglycerides (TRIG)</td>
                                    <td style="padding: 5px 8px; text-align: center; font-weight: bold; color: #ef4444;">185</td>
                                    <td style="padding: 5px 8px; text-align: center; color: #ef4444; font-weight: bold; font-family: monospace;">H ↑</td>
                                    <td style="padding: 5px 8px; text-align: center; color: #64748b;">mg/dL</td>
                                    <td style="padding: 5px 8px; color: #64748b;">&lt; 150</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Simulated Footer & Doctor Signature -->
                    <div class="mt-auto pt-3 border-top border-secondary border-opacity-25" style="border-top: 1px solid #cbd5e1;">
                        <div class="row align-items-end">
                            <div class="col-8">
                                <div class="text-muted" style="font-size: 10px;">
                                    @(string.IsNullOrWhiteSpace(SettingsModel.ReportFooterText) ? "Notice: Laboratory results must be clinically correlated with patient status." : SettingsModel.ReportFooterText)
                                </div>
                            </div>
                            <div class="col-4 text-center">
                                <div class="text-muted small" style="font-size: 10px;">@Prefs.T("توقيع الطبيب المشرف:", "Consultant Signature:")</div>
