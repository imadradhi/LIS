@page "/settings"
@inject ILabSettingsService SettingsService
@inject NavigationManager NavManager
@inject DirectPrintService PrintService
@inject UserPreferencesService Prefs
@implements IDisposable

<PageTitle>@Prefs.T("إعدادات النظام والمختبر والترويسة - LIS Web", "Settings & Reports - LIS Web")</PageTitle>

@if (!string.IsNullOrEmpty(StatusMessage))
{
    <div class="alert @StatusClass mb-3 py-2 px-3 shadow d-flex justify-content-between align-items-center">
        <span>@StatusMessage</span>
        <button type="button" class="btn-close btn-close-white small" @onclick="ClearStatusMessage"></button>
    </div>
}

@if (SettingsModel != null)
{
    <!-- ═══ TOP ROW: Lab Information Fields (Full Width Card) ══════════════════ -->
    <div class="card p-4 mb-4 border-0 shadow-2-strong" style="background: var(--bg-card);">
        <!-- Header with Save Button -->
        <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom border-secondary flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <i class="fas fa-hospital text-info fs-4"></i>
                <div>
                    <h5 class="fw-bold text-info mb-0">@Prefs.T("إعدادات المختبر والترويسة (Lab Settings & Header)", "Laboratory Settings & Header")</h5>
                    <small class="text-secondary">@Prefs.T("بيانات المختبر الأساسية التي تظهر في رأس التقارير والوصولات", "Master laboratory information displayed on report headers and receipts.")</small>
                </div>
            </div>
            <button class="btn btn-success fw-bold px-4 fs-6 shadow-sm btn-action-animated" data-mdb-ripple-init @onclick="SaveSettings" disabled="@IsSaving">
                @if (IsSaving)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                    <span>@Prefs.T("جاري الحفظ...", "Saving...")</span>
                }
                else
                {
                    <span><i class="fas fa-floppy-disk me-1"></i> @Prefs.T("حفظ الإعدادات (Save Settings)", "Save Settings")</span>
                }
            </button>
        </div>

        <!-- Row 0: Official Laboratory Logo Configuration -->
        <div class="row g-3 mb-3 p-3 rounded-3" style="background: rgba(0, 180, 216, 0.05); border: 1px dashed rgba(0, 180, 216, 0.35);">
            <div class="col-12 col-md-auto d-flex align-items-center justify-content-center">
                @if (SettingsModel.LogoData != null && SettingsModel.LogoData.Length > 0)
                {
                    <div class="position-relative border rounded p-1 bg-white shadow-sm d-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                        <img src="data:image/png;base64,@Convert.ToBase64String(SettingsModel.LogoData)" 
                             alt="Lab Logo" 
                             style="max-width: 90px; max-height: 90px; object-fit: contain;" />
                    </div>
                }
                else
                {
                    <div class="rounded border border-secondary border-dashed d-flex flex-column align-items-center justify-content-center text-muted"
                         style="width: 100px; height: 100px; background: rgba(255,255,255,0.02);">
                        <i class="fas fa-image fs-2 mb-1 text-secondary opacity-50"></i>
                        <span style="font-size: 11px;">@Prefs.T("لا يوجد شعار", "No Logo")</span>
                    </div>
                }
            </div>
            <div class="col-12 col-md d-flex flex-column justify-content-center">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="fw-bold text-info fs-6">
                        <i class="fas fa-certificate text-warning me-1"></i> @Prefs.T("شعار المختبر المعتمد في التقارير الطبية الرسمية (Official Laboratory Logo):", "Official Accredited Laboratory Logo:")
                    </span>
                    @if (SettingsModel.LogoData != null && SettingsModel.LogoData.Length > 0)
                    {
                        <span class="badge bg-success bg-opacity-25 text-success border border-success">
                            <i class="fas fa-check-circle me-1"></i> @Prefs.T("شعار معتمد في كافة التقارير", "Accredited in Reports")
                        </span>
                    }
                </div>
                <div class="small text-secondary mb-2">
                    @Prefs.T("يظهر هذا الشعار الرسمي في أعلى ترويسة تقارير الفحوصات الطبية المطبوعة والمعاينات الرقمية للمرضى بدقة عالية (يدعم صيغ PNG, JPG, WEBP, SVG حتى 5 ميغابايت).", "This official logo is displayed at the top header of printed medical reports and digital previews (supports PNG, JPG, WEBP, SVG up to 5MB).")
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <label class="btn btn-outline-info btn-sm fw-bold mb-0 cursor-pointer" for="logoFileInput">
                        <i class="fas fa-upload me-1"></i>
                        @(SettingsModel.LogoData != null && SettingsModel.LogoData.Length > 0 ? Prefs.T("تغيير الشعار الحالي (Change Logo)", "Change Current Logo") : Prefs.T("رفع شعار المختبر (Upload Logo)", "Upload Lab Logo"))
                    </label>
                    <InputFile id="logoFileInput" OnChange="HandleLogoUpload" accept=".png,.jpg,.jpeg,.webp,.svg" class="d-none" />

                    @if (SettingsModel.LogoData != null && SettingsModel.LogoData.Length > 0)
                    {
                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="RemoveLogo">
                            <i class="fas fa-trash-alt me-1"></i> @Prefs.T("حذف الشعار", "Remove Logo")
                        </button>
                    }
                    <button type="button" class="btn btn-success btn-sm fw-bold px-3 shadow-sm btn-action-animated" data-mdb-ripple-init @onclick="SaveSettings" disabled="@IsSaving">
                        <i class="fas fa-floppy-disk me-1"></i> @Prefs.T("حفظ وتثبيت الشعار", "Save Logo")
                    </button>
                </div>
            </div>
        </div>

        <!-- Row 1: Lab Name Arabic, Lab Name English, Address, Phones -->
        <div class="row g-3 mb-3">
            <div class="col-xxl-3 col-xl-3 col-md-6 col-12">
                <label class="form-label text-secondary small fw-semibold mb-1">@Prefs.T("اسم المختبر بالعربية (Lab Name - Arabic):", "Lab Name (Arabic):")</label>
                <input type="text" class="form-control fw-bold" @bind="SettingsModel.LabNameAr" @bind:event="oninput" placeholder="مختبر التحليلات التخصصي" />
            </div>
            <div class="col-xxl-3 col-xl-3 col-md-6 col-12">
                <label class="form-label text-secondary small fw-semibold mb-1">@Prefs.T("اسم المختبر بالإنجليزية (Lab Name - English):", "Lab Name (English):")</label>
                <input type="text" class="form-control fw-bold font-monospace" @bind="SettingsModel.LabNameEn" @bind:event="oninput" placeholder="Specialized Medical Laboratory" />
            </div>
            <div class="col-xxl-3 col-xl-3 col-md-6 col-12">
                <label class="form-label text-secondary small fw-semibold mb-1">@Prefs.T("العنوان (Address):", "Address:")</label>
                <input type="text" class="form-control" @bind="SettingsModel.Address" @bind:event="oninput" placeholder="العراق - بغداد" />
            </div>
            <div class="col-xxl-3 col-xl-3 col-md-6 col-12">
                <label class="form-label text-secondary small fw-semibold mb-1">@Prefs.T("أرقام الهواتف (Phone Numbers):", "Phone Numbers:")</label>
                <input type="text" class="form-control font-monospace" @bind="SettingsModel.Phones" @bind:event="oninput" placeholder="07701234567" />
            </div>
        </div>

        <!-- Row 2: Email, Header Text, Manager Name, Title, Footer Text -->
        <div class="row g-3">
            <div class="col-xxl-2 col-xl-4 col-md-6 col-12">
                <label class="form-label text-secondary small fw-semibold mb-1">@Prefs.T("البريد الإلكتروني (Email):", "Email Address:")</label>
                <input type="email" class="form-control font-monospace" @bind="SettingsModel.Email" placeholder="lab@example.com" />
            </div>
            <div class="col-xxl-3 col-xl-4 col-md-6 col-12">
                <label class="form-label text-secondary small fw-semibold mb-1">@Prefs.T("نص رأس التقرير (Report Header):", "Report Header Text:")</label>
                <input type="text" class="form-control" @bind="SettingsModel.ReportHeaderText" @bind:event="oninput" placeholder="مختبر التحليلات المرضية المتقدمة" />
            </div>
            <div class="col-xxl-2 col-xl-4 col-md-6 col-12">
                <label class="form-label text-secondary small fw-semibold mb-1">@Prefs.T("الطبيب المسؤول (Manager Name):", "Director / Manager Name:")</label>
                <input type="text" class="form-control" @bind="SettingsModel.ManagerName" @bind:event="oninput" placeholder="د. أحمد علي" />
            </div>
            <div class="col-xxl-2 col-xl-6 col-md-6 col-12">
                <label class="form-label text-secondary small fw-semibold mb-1">@Prefs.T("اللقب والتخصص (Title):", "Professional Title:")</label>
                <input type="text" class="form-control" @bind="SettingsModel.ManagerTitle" @bind:event="oninput" placeholder="أخصائي التحليلات المرضية" />
            </div>
            <div class="col-xxl-3 col-xl-6 col-md-12 col-12">
                <label class="form-label text-secondary small fw-semibold mb-1">@Prefs.T("نص تذييل التقرير (Footer):", "Report Footer Text:")</label>
                <input type="text" class="form-control" @bind="SettingsModel.ReportFooterText" @bind:event="oninput" placeholder="نتائج الفحوصات تعتمد سريرياً بالربط مع حالة المريض" />
            </div>
        </div>
    </div>

    <!-- ═══ BOTTOM ROW: Controls (Left) + Live Preview (Right) ═════════════ -->
    <div class="row g-4">
        <!-- LEFT COLUMN: Settings Controls & Tools (col-xxl-6 / col-12) -->
        <div class="col-xxl-6 col-xl-6 col-12 d-flex flex-column gap-3">

            <!-- 1. Tests & Pricing Catalog Quick Launcher -->
            <div class="card p-3 mb-0 border-0 shadow-2-strong card-hover-lift" style="background: var(--bg-card); border-right: 4px solid var(--accent) !important;">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div>
                        <div class="fw-bold text-info fs-6 d-flex align-items-center gap-2">
                            <i class="fas fa-flask"></i>
                            <span>@Prefs.T("دليل الفحوصات الطبية والأسعار (Tests Catalog):", "Test Catalog & Pricing:")</span>
                        </div>
                        <div class="small text-secondary mt-1">
                            @Prefs.T("إضافة فحوصات جديدة للمختبر، تعديل الأسعار، ربط الفحوصات بالأنابيب والأقسام الطبية، والبارامترات.", "Manage lab tests, edit pricing, map specimen tubes, departments, and technical parameters.")
                        </div>
                    </div>
                    <a href="catalog" class="btn btn-primary btn-sm fw-bold px-3 text-nowrap btn-action-animated" data-mdb-ripple-init>
                        <i class="fas fa-clipboard-list me-1"></i> @Prefs.T("فتح دليل الفحوصات", "Open Test Catalog")
                    </a>
                </div>
            </div>

            <!-- 2. Database Server Connection Settings Card -->
            <div class="card p-3 mb-0 border-0 shadow-2-strong card-hover-lift" style="background: var(--bg-card);">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-server text-white"></i>
                            <span class="fw-bold text-white fs-6">@Prefs.T("خادم قاعدة البيانات والسيرفر (Database Server):", "Database Server Connection:")</span>
                            <span class="badge bg-success bg-opacity-25 text-success border border-success font-monospace">
                                127.0.0.1:5432 (lis_db)
                            </span>
                        </div>
                        <div class="small text-secondary mt-1">
                            @Prefs.T("تعديل عنوان السيرفر والمنفذ واسم قاعدة البيانات للربط الشبكي بين أجهزة المختبر ومحطات العمل.", "Configure host, port, and database name for network integration across workstations.")
                        </div>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3 text-nowrap" data-mdb-ripple-init @onclick="() => IsServerModalOpen = true">
                        <i class="fas fa-gear me-1"></i> @Prefs.T("تفاصيل السيرفر", "Server Details")
                    </button>
                </div>
            </div>

            <!-- 3. Default System Printers Section -->
            <div class="card p-4 mb-0 border-0 shadow-2-strong" style="background: var(--bg-card);">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom border-secondary flex-wrap gap-2">
                    <div>
                        <h6 class="fw-bold text-info mb-0 d-flex align-items-center gap-2">
                            <i class="fas fa-print"></i>
                            <span>@Prefs.T("طابعات النظام والطباعة الصامتة المباشرة (Default Printers & Direct Silent Print):", "System Printers & Direct Silent Print:")</span>
                        </h6>
                        <small class="text-secondary">@Prefs.T("تم كشف", "Detected") @InstalledPrinters.Count @Prefs.T("طابعة متصلة بالنظام حالياً", "printers connected to system")</small>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-outline-info btn-sm py-1 px-3 fw-bold btn-action-animated" data-mdb-ripple-init @onclick="DetectPrinters">
                            <i class="fas fa-sync-alt me-1"></i> @Prefs.T("كشف وتحديث الطابعات", "Detect & Refresh Printers")
                        </button>
                        <button type="button" class="btn btn-success btn-sm py-1 px-3 fw-bold shadow-sm btn-action-animated" data-mdb-ripple-init @onclick="SaveSettings" disabled="@IsSaving">
                            <i class="fas fa-floppy-disk me-1"></i> @Prefs.T("حفظ الطابعات (Save)", "Save Printers")
                        </button>
                    </div>
                </div>

                <datalist id="systemInstalledPrinters">
                    @foreach (var printer in InstalledPrinters)
                    {
                        <option value="@printer">@printer</option>
                    }
                </datalist>

                <!-- Label & Report Printers -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label text-secondary small fw-semibold mb-1">
                            <i class="fas fa-tag text-info me-1"></i> @Prefs.T("طابعة الملصقات والباركود (Label 5×2.5cm):", "Label & Barcode Printer (5×2.5cm):")
                        </label>
                        <div class="input-group">
                            <select class="form-select font-monospace" @bind="SettingsModel.LabelPrinter" @bind:after="AutoSavePrinters">
                                <option value="">-- @Prefs.T("طابعة الباركود الافتراضية (Windows Default)", "Default Label Printer") --</option>
                                @foreach (var printer in InstalledPrinters)
                                {
                                    <option value="@printer">@printer</option>
                                }
                                @if (!string.IsNullOrEmpty(SettingsModel.LabelPrinter) && !InstalledPrinters.Contains(SettingsModel.LabelPrinter))
                                {
                                    <option value="@SettingsModel.LabelPrinter">@SettingsModel.LabelPrinter (Custom)</option>
                                }
                            </select>
                            <button type="button" class="btn btn-outline-success fw-bold btn-sm" data-mdb-ripple-init title='@Prefs.T("إرسال أمر طباعة مباشر وصامت بدون شاشة معاينة", "Send direct silent print without preview")' @onclick="PrintDirectTestLabel">
                                <i class="fas fa-bolt me-1"></i> @Prefs.T("صامتة", "Silent")
                            </button>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-secondary small fw-semibold mb-1">
                            <i class="fas fa-file-lines text-info me-1"></i> @Prefs.T("طابعة التقارير والنتائج (Report A4):", "Reports Printer (A4):")
                        </label>
                        <div class="input-group">
                            <select class="form-select font-monospace" @bind="SettingsModel.ReportPrinter" @bind:after="AutoSavePrinters">
                                <option value="">-- @Prefs.T("طابعة التقارير الافتراضية (Windows Default)", "Default Report Printer") --</option>
                                @foreach (var printer in InstalledPrinters)
                                {
                                    <option value="@printer">@printer</option>
                                }
                                @if (!string.IsNullOrEmpty(SettingsModel.ReportPrinter) && !InstalledPrinters.Contains(SettingsModel.ReportPrinter))
                                {
                                    <option value="@SettingsModel.ReportPrinter">@SettingsModel.ReportPrinter (Custom)</option>
                                }
                            </select>
                            <button type="button" class="btn btn-outline-success fw-bold btn-sm" data-mdb-ripple-init title='@Prefs.T("إرسال أمر طباعة مباشر وصامت لتقرير النتائج", "Send direct silent print for report")' @onclick="PrintDirectTestReport">
                                <i class="fas fa-bolt me-1"></i> @Prefs.T("صامتة", "Silent")
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Receipt Printer -->
                <div class="mb-3">
                    <label class="form-label text-secondary small fw-semibold mb-1">
                        <i class="fas fa-receipt text-info me-1"></i> @Prefs.T("طابعة وصولات الكاشير الحرارية (Receipt 80mm):", "Thermal Receipt Printer (80mm):")
                    </label>
                    <div class="input-group">
                        <select class="form-select font-monospace" @bind="SettingsModel.ReceiptPrinter" @bind:after="AutoSavePrinters">
                            <option value="">-- @Prefs.T("طابعة الوصولات الافتراضية (Windows Default)", "Default Receipt Printer") --</option>
                            @foreach (var printer in InstalledPrinters)
                            {
                                <option value="@printer">@printer</option>
                            }
                            @if (!string.IsNullOrEmpty(SettingsModel.ReceiptPrinter) && !InstalledPrinters.Contains(SettingsModel.ReceiptPrinter))
                            {
                                <option value="@SettingsModel.ReceiptPrinter">@SettingsModel.ReceiptPrinter (Custom)</option>
                            }
                        </select>
                        <button type="button" class="btn btn-outline-success fw-bold" data-mdb-ripple-init title='@Prefs.T("إرسال وصل كاشير صامت مباشرة للطابعة دون نوافذ", "Send direct silent receipt")' @onclick="PrintDirectTestReceipt">
                            <i class="fas fa-bolt me-1"></i> @Prefs.T("صامتة", "Silent")
                        </button>
                        <button type="button" class="btn btn-outline-info" data-mdb-ripple-init @onclick="() => IsTestReceiptModalOpen = true">
                            <i class="fas fa-eye me-1"></i> @Prefs.T("معاينة الوصل", "Preview Receipt")
                        </button>
                    </div>
                </div>

                <!-- Direct Save Printers Action Bar -->
                <div class="d-flex justify-content-between align-items-center mb-3 pt-2 border-top border-secondary flex-wrap gap-2">
                    <small class="text-success">
                        <i class="fas fa-circle-check me-1"></i> @Prefs.T("يتم حفظ أي تغيير على الطابعات تلقائياً وفوراً في النظام.", "Any printer changes are automatically saved to the system.")
                    </small>
                    <button type="button" class="btn btn-success btn-sm fw-bold px-4 shadow-sm btn-action-animated" data-mdb-ripple-init @onclick="SaveSettings" disabled="@IsSaving">
                        <i class="fas fa-floppy-disk me-1"></i> @Prefs.T("حفظ وتثبيت الطابعات (Save Printers)", "Save & Apply Printers")
                    </button>
                </div>

                <!-- Silent Printing & Kiosk Mode Info Box -->
                <div class="p-3 rounded border border-info border-opacity-25" style="background: rgba(0, 180, 216, 0.05);">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-success text-white px-2 py-1">
                            <i class="fas fa-check me-1"></i> @Prefs.T("مفعل وجاهز", "Active & Ready")
                        </span>
                        <strong class="text-info small">@Prefs.T("دليل الطباعة الصامتة الفورية في المختبر (Silent Printing Guide):", "Direct Silent Printing Guide:")</strong>
                    </div>
                    <div class="small text-secondary mb-2">
                        • <strong>@Prefs.T("الطباعة الصامتة المباشرة (Direct Server Spooler):", "Direct Server Spooler:")</strong> @Prefs.T("تتم إحالة أوامر طباعة الملصقات والإيصالات فوراً من أزرار النظام إلى طابعة Windows Spooler دون فتح نافذة المتصفح نهائياً وبالمقاس الدقيق (50×25 مم أو 80 مم).", "Printing labels and receipts sends commands directly to Windows Spooler bypassing browser dialogs at exact paper dimensions (50x25mm or 80mm).")
                    </div>
                    <div class="small text-secondary mb-2">
                        • <strong>@Prefs.T("الطباعة الصامتة من المتصفح (Browser Kiosk Printing):", "Browser Kiosk Printing:")</strong> @Prefs.T("لتخطي نافذة معاينة المتصفح في أي مكان، يمكنك تشغيل متصفح Chrome أو Edge بوضع الكيوسك عبر الاختصار التالي:", "To bypass browser print dialog entirely, launch Chrome or Edge with kiosk mode using:")
                    </div>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-dark border-secondary text-info fw-bold">@Prefs.T("أمر تشغيل المتصفح الصامت:", "Kiosk Launch Command:")</span>
                        <input type="text" readonly class="form-control bg-dark border-secondary text-white font-monospace" value="chrome.exe --kiosk-printing --app=http://localhost:5215/" />
                    </div>
                </div>
            </div>

            <!-- 4. Barcode Calibration -->
            <div class="card p-4 mb-0 border-0 shadow-2-strong" style="background: var(--bg-card);">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div class="flex-grow-1 me-3">
                        <div class="fw-bold text-info small mb-1 d-flex align-items-center gap-1">
                            <i class="fas fa-crosshairs"></i>
                            <span>@Prefs.T("معايرة موضع الباركود أفقياً (Barcode Alignment Calibration):", "Barcode Horizontal Alignment Calibration:")</span>
                        </div>
                        <div class="small text-secondary mb-2">
                            @Prefs.T("إذا كانت الطباعة منحرفة على لاصق 5×2.5 سم، اختر قيمة الإزاحة لتوسيطه بدقة:", "If label printing is misaligned on 50×25mm labels, choose offset to center accurately:")
                        </div>
                        <select class="form-select font-monospace" @bind="SettingsModel.BarcodeOffsetMm">
                            <option value="20.0">+20 mm (@Prefs.T("إزاحة لليمين 20 مم", "Right shift 20 mm"))</option>
                            <option value="18.0">+18 mm (@Prefs.T("إزاحة لليمين 18 مم", "Right shift 18 mm"))</option>
                            <option value="16.0">+16 mm (@Prefs.T("إزاحة لليمين 16 مم", "Right shift 16 mm"))</option>
                            <option value="15.0">+15 mm (@Prefs.T("إزاحة لليمين 15 مم - الافتراضي", "Right shift 15 mm - Default"))</option>
                            <option value="14.0">+14 mm (@Prefs.T("إزاحة لليمين 14 مم", "Right shift 14 mm"))</option>
                            <option value="12.0">+12 mm (@Prefs.T("إزاحة لليمين 12 مم", "Right shift 12 mm"))</option>
                            <option value="10.0">+10 mm (@Prefs.T("إزاحة لليمين 10 مم", "Right shift 10 mm"))</option>
