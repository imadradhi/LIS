                                    @(string.IsNullOrWhiteSpace(SettingsModel.ManagerName) ? "د. أحمد علي" : SettingsModel.ManagerName)
                                </div>
                                <div class="text-muted" style="font-size: 10px;">
                                    @(string.IsNullOrWhiteSpace(SettingsModel.ManagerTitle) ? "أخصائي التحليلات المرضية" : SettingsModel.ManagerTitle)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

