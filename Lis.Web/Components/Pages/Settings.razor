                            </div>
                            <div class="d-flex justify-content-between text-success">
                                <span>@Prefs.T("المدفوع نقداً:", "Paid Cash:")</span>
                                <span>20,000 @Prefs.T("د.ع", "IQD")</span>
                            </div>
                        </div>

                        <div class="text-center pt-2 border-top border-dark">
                            <strong style="letter-spacing: 2px;">*TEST-RECEIPT*</strong>
                            <div style="font-size: 9.5px; color: #555; margin-top: 2px;">@Prefs.T("نشكركم لزيارتكم - نتمنى لكم السلامة", "Thank you for visiting - Wishing you good health")</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top border-secondary d-flex justify-content-between py-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-mdb-ripple-init @onclick="() => IsTestReceiptModalOpen = false">@Prefs.T("إغلاق", "Close")</button>
                    <button type="button" class="btn btn-success btn-sm fw-bold px-3 btn-action-animated" data-mdb-ripple-init onclick="window.print()">
                        <i class="fas fa-print me-1"></i> @Prefs.T("طباعة الوصل (Print)", "Print Receipt")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private LabSettingsDto? SettingsModel;
    private string StatusMessage = "";
    private string StatusClass = "alert-success";
    private bool IsSaving = false;

    private void ClearStatusMessage() => StatusMessage = "";

    // Modals
    private bool IsServerModalOpen = false;
    private bool IsTestLabelModalOpen = false;
    private bool IsTestReceiptModalOpen = false;
    private List<string> InstalledPrinters = new();

    protected override async Task OnInitializedAsync()
    {
        Prefs.OnChange += OnPrefsChanged;
        try
        {
            SettingsModel = await SettingsService.GetSettingsAsync();
            DetectPrinters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Settings Load Error] {ex.Message}");
        }
    }

    private void OnPrefsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Prefs.OnChange -= OnPrefsChanged;
    }

    private void DetectPrinters()
    {
        InstalledPrinters = PrintService.GetInstalledPrinters();
        StatusClass = "alert-info";
        StatusMessage = Prefs.T($"🔄 تم كشف {InstalledPrinters.Count} طابعة مثبتة في النظام بنجاح ({string.Join(", ", InstalledPrinters)}).", $"🔄 Detected {InstalledPrinters.Count} installed printers successfully ({string.Join(", ", InstalledPrinters)}).");
    }

    private async Task AutoSavePrinters()
    {
        if (SettingsModel == null) return;
        try
        {
            await SettingsService.SaveSettingsAsync(SettingsModel, currentUserId: 1);
            StatusClass = "alert-success";
            StatusMessage = Prefs.T("✅ تم حفظ وتحديث إعدادات الطابعات بنجاح في قاعدة البيانات!", "✅ Printer configurations saved successfully to database!");
        }
        catch (Exception ex)
        {
            StatusClass = "alert-danger";
            StatusMessage = Prefs.T($"حدث خطأ أثناء حفظ الطابعة: {ex.Message}", $"Error saving printer: {ex.Message}");
        }
    }

    private async Task PrintDirectTestLabel()
    {
        if (SettingsModel == null) return;
        var testData = new SpecimenLabelData
        {
            AccessionNo = "200586",
            Mrn = 100031,
            PatientNameAr = "زينب حيدر",
            DateOfBirth = new DateTime(1995, 3, 10),
            SpecimenTypeName = "EDTA Whole Blood"
        };

        var res = await PrintService.PrintLabelDirectAsync(testData, SettingsModel.LabelPrinter, SettingsModel.BarcodeOffsetMm);
        StatusClass = res.Success ? "alert-success" : "alert-danger";
        StatusMessage = res.Message;
    }

    private async Task PrintDirectTestReceipt()
    {
        if (SettingsModel == null) return;
        var testData = new ReceiptPrintData
        {
            LabNameAr = SettingsModel.LabNameAr,
            LabNameEn = SettingsModel.LabNameEn,
            Address = SettingsModel.Address,
            Phones = SettingsModel.Phones,
            InvoiceNo = 10001,
            OrderId = 5001,
            OrderDate = DateTime.Now,
            PatientNameAr = "محمد عبد الله أحمد (تجريبي)",
            Mrn = 100025,
            PatientPhone = "07701234567",
            Gender = "ذكر",
            CashierName = "مدير النظام (Admin)",
            PaymentMethod = "Cash",
            TotalAmount = 50000,
            Discount = 5000,
            NetAmount = 45000,
            PaidAmount = 45000,
            BalanceDue = 0,
            Items = new List<ReceiptItemData>
            {
                new ReceiptItemData { Code = "CBC", Name = "Complete Blood Count", Price = 15000 },
                new ReceiptItemData { Code = "LIPID", Name = "Lipid Profile Panel", Price = 20000 },
                new ReceiptItemData { Code = "TSH", Name = "Thyroid Stimulating Hormone", Price = 15000 }
            }
        };

        var res = await PrintService.PrintReceiptDirectAsync(testData, SettingsModel.ReceiptPrinter);
        StatusClass = res.Success ? "alert-success" : "alert-danger";
        StatusMessage = res.Message;
    }

    private void PrintDirectTestReport()
    {
        if (SettingsModel == null) return;
        StatusClass = "alert-info";
        StatusMessage = Prefs.T($"⚡ طابعة التقارير الرسمية محددة على: [{SettingsModel.ReportPrinter ?? "طابعة A4 الافتراضية"}]. يمكنك تجربة طباعة تقرير نتائج من صفحة النتائج.", $"⚡ Official report printer set to: [{SettingsModel.ReportPrinter ?? "Default A4 Printer"}]. You can test printing from Results page.");
    }

    private async Task HandleLogoUpload(InputFileChangeEventArgs e)
    {
        if (SettingsModel == null || e.File == null) return;
        try
        {
            // Max 5MB
            const long maxFileSize = 5 * 1024 * 1024;
            using var stream = e.File.OpenReadStream(maxAllowedSize: maxFileSize);
            using var ms = new System.IO.MemoryStream();
            await stream.CopyToAsync(ms);
            SettingsModel.LogoData = ms.ToArray();
            
            // Auto-save immediately to database
            await SettingsService.SaveSettingsAsync(SettingsModel, currentUserId: 1);

            StatusClass = "alert-success";
            StatusMessage = Prefs.T("✅ تم رفع وحفظ شعار المختبر بنجاح واعتماده في كافة التقارير الطبية الرسمية!", "✅ Laboratory logo uploaded and saved successfully to official medical reports!");
        }
        catch (Exception ex)
        {
            StatusClass = "alert-danger";
            StatusMessage = Prefs.T($"فشل رفع الشعار: {ex.Message}", $"Failed to upload logo: {ex.Message}");
        }
    }

    private async Task RemoveLogo()
    {
        if (SettingsModel == null) return;
        try
        {
            SettingsModel.LogoData = null;
            await SettingsService.SaveSettingsAsync(SettingsModel, currentUserId: 1);
            StatusClass = "alert-warning";
            StatusMessage = Prefs.T("🗑️ تم حذف شعار المختبر بنجاح.", "🗑️ Laboratory logo removed successfully.");
        }
        catch (Exception ex)
        {
            StatusClass = "alert-danger";
            StatusMessage = Prefs.T($"فشل حذف الشعار: {ex.Message}", $"Failed to remove logo: {ex.Message}");
        }
    }

    private async Task SaveSettings()
    {
        if (SettingsModel == null) return;
        IsSaving = true;
        StatusMessage = "";

        try
        {
            await SettingsService.SaveSettingsAsync(SettingsModel, currentUserId: 1);
            StatusClass = "alert-success";
            StatusMessage = Prefs.T("✅ تم حفظ وتحديث كافة إعدادات المختبر والتقارير والطابعات بنجاح في قاعدة البيانات!", "✅ Laboratory settings, report headers, and printer configurations saved successfully!");
        }
        catch (Exception ex)
        {
            StatusClass = "alert-danger";
            StatusMessage = Prefs.T($"حدث خطأ أثناء الحفظ: {ex.Message}", $"Error saving settings: {ex.Message}");
        }
        finally
        {
            IsSaving = false;
        }
    }
}
