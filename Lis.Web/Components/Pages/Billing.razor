@page "/billing"
@inject IBillingService BillingService
@inject UserPreferencesService Prefs
@implements IDisposable

<PageTitle>@Prefs.T("المالية وقاصة الحسابات - LIS Web", "Billing & Invoices - LIS Web")</PageTitle>

<!-- Top Title Bar -->
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h3 class="fw-bold text-white mb-1 d-flex align-items-center gap-2">
            <i class="fas fa-cash-register text-info"></i>
            <span>@Prefs.T("المالية وقاصة الحسابات (Billing & Cashier)", "Billing & Invoices")</span>
        </h3>
        <p class="text-secondary mb-0 small">@Prefs.T("متابعة إيرادات الصندوق، الدفعات النقدية، تسديد الديون، والتقارير اليومية", "Track cash revenue, receipts, debt settlement, and daily financial reports.")</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="text-secondary fw-semibold text-nowrap small">@Prefs.T("تاريخ التقرير:", "Report Date:")</span>
        <input type="date" class="form-control" style="width: 170px;" @bind="SelectedDate" @bind:after="LoadReport" />
        <button class="btn btn-outline-secondary" data-mdb-ripple-init @onclick="LoadReport">
            <i class="fas fa-sync-alt me-1"></i> @Prefs.T("تحديث", "Refresh")
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(AlertMessage))
{
    <div class="alert @AlertClass py-2 px-3 mb-3">@AlertMessage</div>
}

@if (CashReport != null)
{
    <!-- ═══ 1. Current User Cash Drawer (قاصة المستخدم الحالي) ═══ -->
    <div class="card p-3 mb-4 border-0 shadow-2-strong" style="background: var(--bg-card); border-right: 4px solid var(--accent) !important;">
        <div class="row g-3 align-items-center">
            <div class="col-xxl-3 col-xl-3 col-md-6 col-12 border-end border-secondary">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="fas fa-wallet text-info fs-5"></i>
                    <h5 class="fw-bold text-info mb-0">@Prefs.T("قاصة الحساب الحالي", "Current Cash Drawer")</h5>
                    <span class="badge bg-primary">@Prefs.T("قاصة الصندوق", "Cash Drawer")</span>
                </div>
                <div class="text-secondary small">@Prefs.T("الموظف:", "Staff:") <strong class="text-white">@Prefs.T("مدير النظام (Admin)", "System Admin")</strong></div>
            </div>

            <div class="col-xxl-2 col-xl-2 col-md-6 col-6">
                <small class="text-secondary d-block">
                    <i class="fas fa-money-bill-wave text-success me-1"></i> @Prefs.T("نقد في القاصة (Cash)", "Cash in Drawer")
                </small>
                <strong class="text-success fs-5 font-monospace">@CashReport.TotalCashCollected.ToString("N0") @Prefs.T("د.ع", "IQD")</strong>
            </div>

            <div class="col-xxl-2 col-xl-2 col-md-6 col-6">
                <small class="text-secondary d-block">
                    <i class="fas fa-credit-card text-info me-1"></i> @Prefs.T("دفع إلكتروني (Card)", "Card / POS")
                </small>
                <strong class="text-info fs-5 font-monospace">@CashReport.TotalCardCollected.ToString("N0") @Prefs.T("د.ع", "IQD")</strong>
            </div>

            <div class="col-xxl-3 col-xl-3 col-md-6 col-6">
                <small class="text-secondary d-block">
                    <i class="fas fa-coins text-warning me-1"></i> @Prefs.T("إجمالي دخل القاصة (Total)", "Total Drawer Intake")
                </small>
                <strong class="text-white fs-4 font-monospace">@CashReport.TotalCollected.ToString("N0") @Prefs.T("د.ع", "IQD")</strong>
            </div>

            <div class="col-xxl-2 col-xl-2 col-md-6 col-6 text-end">
                <button class="btn btn-outline-info w-100 fw-bold" data-mdb-ripple-init onclick="window.print()">
                    <i class="fas fa-print me-1"></i> @Prefs.T("كشف القاصة 80 مم", "Receipt 80mm")
                </button>
            </div>
        </div>
    </div>

    <!-- ═══ 2. 7 KPI Financial Summary Cards ═══ -->
    <div class="row g-2 mb-4">
        <div class="col-xxl col-xl-3 col-lg-3 col-md-4 col-6">
            <div class="card p-3 text-center border-0 shadow-2-strong card-hover-lift" style="background: var(--bg-card);">
                <small class="text-secondary">@Prefs.T("إجمالي الفواتير", "Total Invoiced")</small>
                <div class="fw-bold text-white fs-6 mt-1 font-monospace">@CashReport.TotalInvoiced.ToString("N0")</div>
            </div>
        </div>
        <div class="col-xxl col-xl-3 col-lg-3 col-md-4 col-6">
            <div class="card p-3 text-center border-0 shadow-2-strong card-hover-lift" style="background: var(--bg-card);">
                <small class="text-secondary">@Prefs.T("الخصومات", "Total Discounts")</small>
                <div class="fw-bold text-warning fs-6 mt-1 font-monospace">@CashReport.TotalDiscount.ToString("N0")</div>
            </div>
        </div>
        <div class="col-xxl col-xl-3 col-lg-3 col-md-4 col-6">
            <div class="card p-3 text-center border-0 shadow-2-strong card-hover-lift" style="background: var(--bg-card);">
                <small class="text-secondary">@Prefs.T("الصافي المطلوب", "Net Receivable")</small>
                <div class="fw-bold text-info fs-6 mt-1 font-monospace">@CashReport.TotalNet.ToString("N0")</div>
            </div>
        </div>
        <div class="col-xxl col-xl-3 col-lg-3 col-md-4 col-6">
            <div class="card p-3 text-center border-0 shadow-2-strong card-hover-lift" style="background: var(--bg-card);">
                <small class="text-secondary">@Prefs.T("نقداً (Cash)", "Cash")</small>
                <div class="fw-bold text-success fs-6 mt-1 font-monospace">@CashReport.TotalCashCollected.ToString("N0")</div>
            </div>
        </div>
        <div class="col-xxl col-xl-3 col-lg-3 col-md-4 col-6">
            <div class="card p-3 text-center border-0 shadow-2-strong card-hover-lift" style="background: var(--bg-card);">
                <small class="text-secondary">@Prefs.T("كارت (Card)", "Card")</small>
                <div class="fw-bold text-primary fs-6 mt-1 font-monospace">@CashReport.TotalCardCollected.ToString("N0")</div>
            </div>
        </div>
        <div class="col-xxl col-xl-3 col-lg-3 col-md-4 col-6">
            <div class="card p-3 text-center border-0 shadow-2-strong card-hover-lift" style="background: var(--bg-card);">
                <small class="text-secondary">@Prefs.T("المقبوض الكلي", "Total Collected")</small>
                <div class="fw-bold text-white fs-6 mt-1 font-monospace">@CashReport.TotalCollected.ToString("N0")</div>
            </div>
        </div>
        <div class="col-xxl col-xl-6 col-lg-6 col-md-8 col-12">
            <div class="card p-3 text-center border-0 shadow-2-strong card-hover-lift" style="background: var(--bg-card);">
                <small class="text-secondary">@Prefs.T("الديون المتبقية", "Outstanding Balance")</small>
                <div class="fw-bold text-danger fs-6 mt-1 font-monospace">@CashReport.TotalBalance.ToString("N0")</div>
            </div>
        </div>
    </div>

    <!-- ═══ 3. Bottom Grids: Users Collections Summary & Unpaid Invoices ═══ -->
    <div class="row g-4">
        <!-- Left: Cashier Users Summary (col-xxl-5 / col-xl-5 / col-12) -->
        <div class="col-xxl-5 col-xl-5 col-12">
            <div class="card p-0 border-0 shadow-2-strong overflow-hidden h-100" style="background: var(--bg-card);">
                <div class="p-3 border-bottom border-secondary d-flex justify-content-between align-items-center bg-dark">
                    <h6 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                        <i class="fas fa-users text-info"></i>
                        <span>@Prefs.T("القاصات حسب الموظفين", "Drawers by Staff")</span>
                    </h6>
                    <span class="badge bg-info text-dark">@CashReport.UserSummaries.Count @Prefs.T("موظف", "Staff")</span>
                </div>

                @if (!CashReport.UserSummaries.Any())
                {
                    <div class="text-center py-4 text-secondary">@Prefs.T("لا توجد حركات نقدية لهذا التاريخ.", "No cash transactions recorded for this date.")</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 table-stagger" style="color: var(--text-main);">
                            <thead class="table-dark">
                                <tr>
                                    <th>@Prefs.T("الموظف", "Staff Member")</th>
                                    <th>@Prefs.T("نقداً (Cash)", "Cash")</th>
                                    <th>@Prefs.T("كارت (Card)", "Card")</th>
                                    <th>@Prefs.T("الإجمالي", "Total")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in CashReport.UserSummaries)
                                {
                                    <tr>
                                        <td>
                                            <strong class="text-white">@u.FullName</strong>
                                            <div class="small text-muted font-monospace">@u.Username</div>
                                        </td>
                                        <td class="text-success fw-bold font-monospace">@u.CashCollected.ToString("N0")</td>
                                        <td class="text-info fw-semibold font-monospace">@u.CardCollected.ToString("N0")</td>
                                        <td class="text-white fw-bold font-monospace">@u.TotalCollected.ToString("N0") @Prefs.T("د.ع", "IQD")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Right: Unpaid Invoices with Quick Payment Action (col-xxl-7 / col-xl-7 / col-12) -->
        <div class="col-xxl-7 col-xl-7 col-12">
            <div class="card p-0 border-0 shadow-2-strong overflow-hidden h-100" style="background: var(--bg-card);">
                <div class="p-3 border-bottom border-secondary d-flex justify-content-between align-items-center bg-dark">
                    <h6 class="fw-bold text-white mb-0 d-flex align-items-center gap-2">
                        <i class="fas fa-file-invoice-dollar text-danger"></i>
                        <span>@Prefs.T("الفواتير غير المسددة (الديون)", "Unpaid Invoices & Receivables")</span>
                    </h6>
                    <span class="badge bg-danger">@(UnpaidInvoices?.Count ?? 0) @Prefs.T("فاتورة معلقة", "Pending Invoices")</span>
                </div>

                @if (UnpaidInvoices == null || !UnpaidInvoices.Any())
                {
                    <div class="text-center py-4 text-success">
                        <i class="fas fa-check-circle me-1"></i> @Prefs.T("ممتاز! لا توجد فواتير أو ديون معلقة غير مسددة.", "Great! No outstanding or unpaid invoices.")
                    </div>
                }
                else
                {
                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-hover align-middle mb-0 table-stagger" style="color: var(--text-main);">
                            <thead class="table-dark">
                                <tr>
                                    <th>@Prefs.T("فاتورة", "Invoice #")</th>
                                    <th>@Prefs.T("المريض", "Patient Name")</th>
                                    <th>@Prefs.T("المبلغ الكلي", "Total")</th>
                                    <th>@Prefs.T("المدفوع", "Paid")</th>
                                    <th>@Prefs.T("المتبقي", "Balance Due")</th>
                                    <th class="text-center">@Prefs.T("إجراء", "Action")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var inv in UnpaidInvoices)
                                {
                                    long invId = Convert.ToInt64(inv.id);
                                    long ordId = Convert.ToInt64(inv.order_id);
                                    string patientName = inv.full_name_ar?.ToString() ?? "";
                                    var net = ToDecimal(inv.net_amount);
                                    var paid = ToDecimal(inv.paid_amount);
                                    var bal = ToDecimal(inv.balance_due);
                                    <tr>
                                        <td class="fw-bold text-info font-monospace">#@invId</td>
                                        <td>
                                            <strong class="text-white">@patientName</strong>
                                            <div class="small text-muted font-monospace">@Prefs.T("طلب #", "Order #")@ordId</div>
                                        </td>
                                        <td class="font-monospace">@net.ToString("N0")</td>
                                        <td class="text-success font-monospace">@paid.ToString("N0")</td>
                                        <td class="text-danger fw-bold font-monospace">@bal.ToString("N0") @Prefs.T("د.ع", "IQD")</td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-success px-2 py-1 btn-action-animated" data-mdb-ripple-init @onclick="() => OpenPaymentModal(inv)">
                                                <i class="fas fa-hand-holding-dollar me-1"></i> @Prefs.T("تسديد", "Settle")
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- MODAL: Receive Payment                                                    -->
<!-- ========================================================================= -->
@if (SelectedInvoiceForPayment != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.75); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content card border-0 shadow-3-strong" style="background: var(--bg-card);">
                <div class="modal-header border-bottom border-secondary d-flex justify-content-between align-items-center">
                    <h5 class="modal-title text-success fw-bold mb-0 d-flex align-items-center gap-2">
                        <i class="fas fa-hand-holding-dollar text-success"></i>
                        <span>@Prefs.T("تسجيل دفعة نقدية", "Record Payment Receipt")</span>
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => SelectedInvoiceForPayment = null"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="p-3 mb-3 rounded bg-dark border border-secondary">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-secondary">@Prefs.T("المريض:", "Patient:")</span>
                            <strong class="text-white">@(SelectedInvoiceForPayment.full_name_ar?.ToString())</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-secondary">@Prefs.T("فاتورة رقم:", "Invoice #:")</span>
                            <strong class="text-info font-monospace">#@(SelectedInvoiceForPayment.id?.ToString()) (@Prefs.T("طلب #", "Order #")@(SelectedInvoiceForPayment.order_id?.ToString()))</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-secondary">@Prefs.T("المبلغ المتبقي:", "Balance Due:")</span>
                            <strong class="text-danger fs-5 font-monospace">@ToDecimal(SelectedInvoiceForPayment.balance_due).ToString("N0") @Prefs.T("د.ع", "IQD")</strong>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-secondary fw-semibold">@Prefs.T("المبلغ المسدد الآن (IQD):", "Amount to Pay (IQD):")</label>
                        <input type="number" class="form-control fw-bold text-success fs-5 font-monospace" @bind="PaymentAmount" min="1" max="@ToDecimal(SelectedInvoiceForPayment.balance_due)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-secondary fw-semibold">@Prefs.T("طريقة الدفع:", "Payment Method:")</label>
                        <select class="form-select" @bind="PaymentMethod">
                            <option value="Cash">@Prefs.T("نقداً (Cash)", "Cash")</option>
                            <option value="Card">@Prefs.T("كارت / دفع إلكتروني (Card)", "Card / POS")</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top border-secondary d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary" data-mdb-ripple-init @onclick="() => SelectedInvoiceForPayment = null">@Prefs.T("إلغاء", "Cancel")</button>
                    <button type="button" class="btn btn-success fw-bold px-4" data-mdb-ripple-init @onclick="SubmitPayment">
                        <i class="fas fa-check me-1"></i> @Prefs.T("تأكيد استلام الدفعة", "Confirm Payment")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DateTime SelectedDate = DateTime.Today;
    private DailyCashReportDto? CashReport;
    private List<dynamic>? UnpaidInvoices;
    private string AlertMessage = "";
    private string AlertClass = "alert-success";

    // Receive Payment Modal
    private dynamic? SelectedInvoiceForPayment;
    private decimal PaymentAmount = 0;
    private string PaymentMethod = "Cash";

    protected override async Task OnInitializedAsync()
    {
        Prefs.OnChange += OnPrefsChanged;
        await LoadReport();
    }

    private void OnPrefsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Prefs.OnChange -= OnPrefsChanged;
    }

    private async Task LoadReport()
    {
        try
        {
            CashReport = await BillingService.GetDailyCashReportAsync(SelectedDate);
            UnpaidInvoices = (await BillingService.GetUnpaidInvoicesAsync(100)).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Billing Report Error] {ex.Message}");
        }
    }

    private static decimal ToDecimal(object? val)
    {
        if (val == null || val is DBNull) return 0m;
        if (val is decimal d) return d;
        if (decimal.TryParse(val.ToString(), out var parsed)) return parsed;
        return 0m;
    }

    private void OpenPaymentModal(dynamic inv)
    {
        SelectedInvoiceForPayment = inv;
        PaymentAmount = ToDecimal(inv.balance_due);
        PaymentMethod = "Cash";
    }

    private async Task SubmitPayment()
    {
        if (SelectedInvoiceForPayment == null || PaymentAmount <= 0) return;

        try
        {
            long invId = (long)SelectedInvoiceForPayment.id;
            await BillingService.RecordPaymentAsync(invId, PaymentAmount, PaymentMethod, currentUserId: 1);
            SelectedInvoiceForPayment = null;
            AlertClass = "alert-success";
            AlertMessage = Prefs.T("✅ تم تسجيل الدفعة النقدية وتحديث رصيد الفاتورة بنجاح!", "✅ Payment recorded and invoice balance updated successfully!");
            await LoadReport();
        }
        catch (Exception ex)
        {
            AlertClass = "alert-danger";
            AlertMessage = Prefs.T($"حدث خطأ أثناء تسجيل الدفعة: {ex.Message}", $"Error recording payment: {ex.Message}");
        }
    }
}
