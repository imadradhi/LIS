@page "/orders"
@inject IOrderService OrderService
@inject IPatientService PatientService
@inject ITestCatalogService CatalogService
@inject IBillingService BillingService
@inject ILabSettingsService LabSettingsService
@inject IDbConnectionFactory DbConnectionFactory
@inject NavigationManager NavManager
@inject DirectPrintService PrintService
@inject IJSRuntime JS
@inject UserPreferencesService Prefs
@inject AuthSessionService AuthSession
@implements IDisposable

<PageTitle>@Prefs.T("سجل المراجعين والطلبات - LIS Web", "Orders & Patients Registry - LIS Web")</PageTitle>

<!-- MedLab Page Header -->
<div class="medlab-page-header">
    <div>
        <h3 class="d-flex align-items-center gap-2">
            <i class="fas fa-clipboard-list" style="color: var(--medlab-blue);"></i>
            <span>@Prefs.T("إدارة المراجعين والطلبات (Orders & Patients)", "Orders & Patient Registration")</span>
        </h3>
        <p>@Prefs.T("تسجيل مراجع جديد، إنشاء طلبات الفحوصات، إدارة الفواتير والباركود", "Patient registration, lab order creation, billing & barcode printing.")</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary fw-semibold px-3" data-mdb-ripple-init @onclick="StartNewOrderFlow">
            <i class="fas fa-user-plus me-1"></i> @Prefs.T("مراجع جديد (طلب فحص)", "+ NEW PATIENT ORDER")
        </button>
    </div>
</div>

<!-- Filters & Search Bar (MedLab Card) -->
<div class="card p-2 mb-3">
    <div class="row g-2 align-items-center">
        <div class="col-xxl-4 col-xl-4 col-lg-5 col-md-6 col-12">
            <div class="input-group">
                <span class="input-group-text">
                    <i class="fas fa-search"></i>
                </span>
                <input type="text" class="form-control" placeholder="@Prefs.T("ابحث باسم المريض، رقم الطلب، الهاتف أو MRN...", "Search patient, order #, phone or MRN...")" 
                       @bind="SearchQuery" @bind:event="oninput" @onkeyup="FilterOrders" />
            </div>
        </div>

        <div class="col-xxl-3 col-xl-3 col-lg-3 col-md-6 col-12">
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted fw-semibold text-nowrap small" style="font-size: 11px;">@Prefs.T("الحالة:", "Status:")</span>
                <select class="form-select" @bind="SelectedStatus" @bind:after="FilterOrders">
                    <option value="">@Prefs.T("جميع الحالات (All)", "All Statuses")</option>
                    <option value="Ordered">Ordered (مطلوبة)</option>
                    <option value="Collected">Collected (تم الاستلام)</option>
                    <option value="InProgress">InProgress (قيد الفحص)</option>
                    <option value="ResultReceived">ResultReceived (تم استلام النتائج)</option>
                    <option value="Validated">Validated (معتمدة ومكتملة)</option>
                </select>
            </div>
        </div>

        <div class="col-xxl-3 col-xl-3 col-lg-4 col-md-6 col-12">
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted fw-semibold text-nowrap small" style="font-size: 11px;">@Prefs.T("التاريخ:", "Date:")</span>
                <input type="date" class="form-control" @bind="SelectedDate" @bind:after="FilterOrders" />
            </div>
        </div>

        <div class="col-xxl-2 col-xl-2 col-lg-12 col-md-6 col-12 text-end">
            <button class="btn btn-outline-secondary w-100" data-mdb-ripple-init @onclick="RefreshOrders">
                <i class="fas fa-sync-alt me-1"></i> @Prefs.T("تحديث", "Refresh")
            </button>
        </div>
    </div>
</div>

<!-- Orders Full Data Table (MedLab Card & Table) -->
<div class="card p-0 overflow-hidden mb-3">
    @if (OrdersList == null)
    {
        <div class="text-center py-5 text-secondary">
            <div class="spinner-border text-info mb-2" role="status"></div>
            <div>جاري تحميل سجل الطلبات...</div>
        </div>
    }
    else if (!OrdersList.Any())
    {
        <div class="text-center py-5 text-secondary">
            <div style="font-size: 40px;" class="mb-2">📋</div>
            <div>لا توجد طلبات فحص مطابقة للبحث.</div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 table-stagger">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@Prefs.T("التاريخ والوقت", "Date & Time")</th>
                        <th>@Prefs.T("اسم المريض", "Patient Name")</th>
                        <th>MRN</th>
                        <th>@Prefs.T("الجنس / العمر", "Gender / Age")</th>
                        <th>@Prefs.T("الهاتف", "Phone")</th>
                        <th>@Prefs.T("الطبيب المحول", "Referring Doctor")</th>
                        <th>@Prefs.T("الحالة المخبرية", "Lab Status")</th>
                        <th>@Prefs.T("المبلغ الإجمالي (حالة الدفع)", "Total Amount (Payment)")</th>
                        <th class="text-center">@Prefs.T("إجراءات", "Actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in OrdersList)
                    {
                        long id = Convert.ToInt64(order.id);
                        string fullName = order.full_name_ar?.ToString() ?? "";
                        string mrn = order.mrn?.ToString() ?? "";
                        string phone = order.phone?.ToString() ?? "--";
                        string doctor = order.referring_doctor?.ToString() ?? "--";
                        string status = order.status?.ToString() ?? "Ordered";
                        string invStatus = order.invoice_status?.ToString() ?? "";
                        var total = ToDecimal(order.total_amount);
                        var paid = ToDecimal(order.paid_amount);
                        var remaining = Math.Max(0, total - paid);
                        bool isPaid = (total > 0 && remaining <= 0) || invStatus.Equals("Paid", StringComparison.OrdinalIgnoreCase);

                        <tr>
                            <td class="fw-bold text-primary font-monospace">#@id</td>
                            <td class="small font-monospace text-muted">@FormatDateTime(order.order_datetime)</td>
                            <td class="fw-bold fs-6">@fullName</td>
                            <td><span class="badge bg-dark bg-opacity-25 border border-secondary border-opacity-50 text-secondary font-monospace px-2 py-1">@mrn</span></td>
                            <td class="small font-monospace">
                                <span class="fw-bold @(order.sex?.ToString()?.ToUpper() == "F" ? "text-danger" : "text-info")">@FormatGender(order.sex)</span>
                                <span class="text-secondary mx-1">/</span>
                                <span class="fw-semibold text-white">@FormatAge(order.date_of_birth)</span>
                            </td>
                            <td class="small font-monospace text-muted">@phone</td>
                            <td class="text-secondary small">@doctor</td>
                            <!-- Laboratory Status (Text-only with distinct color per status, matching Worklist) -->
                            <td>
                                <span class="fw-bold font-monospace d-inline-flex align-items-center gap-1" style="color: @GetStatusTextColor(status); font-size: 13px;">
                                    <i class="@GetStatusIcon(status)" style="font-size: 11px;"></i>
                                    <span>@status</span>
                                </span>
                            </td>
                            <!-- Total Amount (Text color only by payment status, NO background) -->
                            <td>
                                @if (isPaid)
                                {
                                    <span class="fw-bold font-monospace d-inline-flex align-items-center gap-1 text-success" style="font-size: 13.5px;" title="المبلغ مدفوع بالكامل">
                                        <i class="fas fa-check-circle" style="font-size: 11.5px;"></i>
                                        <span>@total.ToString("N0") د.ع</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="fw-bold font-monospace d-inline-flex align-items-center gap-1 text-danger" style="font-size: 13.5px;" title="المبلغ غير مدفوع (متبقي: @remaining.ToString("N0") د.ع)">
                                        <i class="fas fa-exclamation-circle" style="font-size: 11.5px;"></i>
                                        <span>@total.ToString("N0") د.ع</span>
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="d-flex align-items-center justify-content-center gap-2">
                                    <button class="btn btn-sm btn-outline-primary btn-action-icon p-0" style="width: 34px; height: 34px; min-height: 34px; border-radius: 8px;" data-mdb-ripple-init title='@Prefs.T("عرض تفاصيل الطلب والفحوصات والدفعات", "View Order Details")' @onclick="() => ViewOrderDetails(id)">
                                        <i class="fas fa-eye fs-6"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-info btn-action-icon p-0" style="width: 34px; height: 34px; min-height: 34px; border-radius: 8px;" data-mdb-ripple-init title='@Prefs.T("طباعة ومعاينة باركود الأنابيب للمراجع", "Print & Preview Tube Barcode")' @onclick="() => OpenBarcodeModalForOrderId(id)">
                                        <i class="fas fa-barcode fs-6"></i>
                                    </button>
                                    <a href="results?orderId=@id" class="btn btn-sm btn-primary btn-action-icon p-0 text-decoration-none" style="width: 34px; height: 34px; min-height: 34px; border-radius: 8px;" data-mdb-ripple-init title='@Prefs.T("إدخال واعتماد النتائج المخبرية", "Enter Results")'>
                                        <i class="fas fa-microscope fs-6"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- ========================================================================= -->
<!-- STEP 1 MODAL: Patient Registration / Existing Patient Search              -->
<!-- ========================================================================= -->
@if (IsStep1PatientModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(4px); z-index: 1060;">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg medlab-modal-content" style="border-radius: 6px; overflow: hidden; border: 1px solid var(--medlab-border) !important;">
                <!-- Modal Header -->
                <div class="modal-header py-2 px-3 border-bottom d-flex justify-content-between align-items-center medlab-modal-header" style="border-color: var(--medlab-border) !important;">
                    <div class="d-flex align-items-center gap-2">
                        <div class="d-flex align-items-center justify-content-center rounded-2" style="width: 32px; height: 32px; background: rgba(0, 62, 107, 0.1); color: var(--medlab-navy);">
                            <i class="fas fa-user-plus" style="font-size: 14px;"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <h6 class="fw-bold mb-0 text-medlab-navy" style="font-size: 13.5px;">
                                    | @Prefs.T("الخطوة 1: بيانات المراجع وتسجيل الطلب", "Step 1: Patient Demographics")
                                </h6>
                                <span class="badge font-monospace" style="background: var(--medlab-navy); color: #fff; font-size: 10px;">1 / 2</span>
                            </div>
                            <div class="text-muted" style="font-size: 11px;">
                                @Prefs.T("ابحث عن مريض سابق برقم الملف أو الهاتف، أو سجل مراجعاً جديداً", "Search previous patient by MRN/phone, or register a new patient")
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseModalsSafe"></button>
                </div>

                <div class="modal-body p-3">
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- 1. SMART CLINICAL PATIENT LOOKUP PANEL                          -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    @if (SelectedExistingPatient == null)
                    {
                        <div class="medlab-patient-finder-panel mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-1">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 26px; height: 26px; background: rgba(2, 132, 199, 0.15); color: #0284C7; font-size: 12px;">
                                        <i class="fas fa-magnifying-glass"></i>
                                    </div>
                                    <span class="fw-bold" style="font-size: 12px; color: var(--medlab-text-navy);">
                                        @Prefs.T("البحث في سجل المراجعين السابقين (Smart Patient Lookup)", "Search Existing Patient Records")
                                    </span>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="badge bg-light text-secondary border font-monospace" style="font-size: 9.5px;">@Prefs.T("بالاسم", "Name")</span>
                                    <span class="badge bg-light text-secondary border font-monospace" style="font-size: 9.5px;">@Prefs.T("الهاتف", "Phone")</span>
                                    <span class="badge bg-light text-secondary border font-monospace" style="font-size: 9.5px;">@Prefs.T("MRN", "MRN")</span>
                                </div>
                            </div>

                            <div class="position-relative">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-transparent border-end-0 text-primary px-3">
                                        <i class="fas fa-search"></i>
                                    </span>
                                    <input type="text" class="form-control border-start-0 medlab-patient-finder-input" 
                                           placeholder="@Prefs.T("اكتب اسم المراجع، رقم الهاتف، أو رقم الملف الطبي MRN...", "Type patient name, phone, or MRN to search...")" 
                                           @bind="PatientSearchQuery" @bind:event="oninput" @onkeyup="HandlePatientSearch" />
                                    @if (!string.IsNullOrEmpty(PatientSearchQuery))
                                    {
                                        <button class="btn btn-outline-secondary px-3" type="button" @onclick="ClearPatientSearch" title="@Prefs.T("مسح البحث", "Clear search")">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    }
                                </div>

                                <!-- Floating Autocomplete Suggestions Dropdown -->
                                @if (PatientSearchResults != null && PatientSearchResults.Any())
                                {
                                    <div class="medlab-patient-suggestion-dropdown">
                                        <div class="px-3 py-2 border-bottom d-flex justify-content-between align-items-center" style="background: rgba(0,0,0,0.02); font-size: 11px;">
                                            <span class="fw-bold text-primary">
                                                <i class="fas fa-users me-1"></i>
                                                @Prefs.T($"تم العثور على ({PatientSearchResults.Count}) مراجعين مسجلين:", $"Found ({PatientSearchResults.Count}) matching patients:")
                                            </span>
                                            <span class="text-muted small">@Prefs.T("انقر لاختيار المراجع وتعبئة بياناته", "Click to auto-fill details")</span>
                                        </div>

                                        @foreach (var p in PatientSearchResults)
                                        {
                                            var ageInfo = PatientService.CalculateAge(p.DateOfBirth);
                                            <div class="medlab-patient-suggestion-item d-flex justify-content-between align-items-center"
                                                 @onclick="() => SelectExistingPatient(p)">
                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                                         style="width: 36px; height: 36px; min-width: 36px; font-size: 14px; background: @(p.Sex == "F" ? "rgba(236, 72, 153, 0.12)" : "rgba(2, 132, 199, 0.12)"); color: @(p.Sex == "F" ? "#DB2777" : "#0284C7");">
                                                        <i class="fas @(p.Sex == "F" ? "fa-female" : "fa-male")"></i>
                                                    </div>
                                                    <div>
                                                        <div class="d-flex align-items-center gap-2">
                                                            <strong class="text-medlab-navy" style="font-size: 12.5px;">@p.FullNameAr</strong>
                                                            @if (!string.IsNullOrWhiteSpace(p.FullNameEn))
                                                            {
                                                                <span class="text-muted small">(@p.FullNameEn)</span>
                                                            }
                                                            <span class="badge font-monospace" style="background: rgba(2, 132, 199, 0.1); color: #0284C7; font-size: 9.5px; border: 1px solid rgba(2, 132, 199, 0.2);">
                                                                MRN: @p.Mrn
                                                            </span>
                                                        </div>
                                                        <div class="text-muted small d-flex align-items-center gap-2 mt-1" style="font-size: 11px;">
                                                            <span><i class="fas fa-venus-mars me-1 text-secondary"></i>@(p.Sex == "F" ? Prefs.T("أنثى", "Female") : Prefs.T("ذكر", "Male"))</span>
                                                            <span>•</span>
                                                            <span><i class="fas fa-cake-candles me-1 text-secondary"></i>@ageInfo.FormattedText</span>
                                                            @if (!string.IsNullOrWhiteSpace(p.Phone))
                                                            {
                                                                <span>•</span>
                                                                <span class="font-monospace"><i class="fas fa-phone me-1 text-success"></i>@p.Phone</span>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-bold d-flex align-items-center gap-1 shadow-sm" style="font-size: 10.5px; height: 26px;">
                                                    <span>@Prefs.T("اختيار المراجع", "Select")</span>
                                                    <i class="fas @(Prefs.IsArabic ? "fa-arrow-left" : "fa-arrow-right") ms-1"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(PatientSearchQuery) && PatientSearchQuery.Trim().Length >= 2 && PatientSearchResults != null && !PatientSearchResults.Any())
                                {
                                    <div class="medlab-patient-suggestion-dropdown p-3 text-center text-muted" style="font-size: 11.5px;">
                                        <i class="fas fa-user-xmark fs-4 text-secondary opacity-50 mb-1 d-block"></i>
                                        <span>@Prefs.T("لم يتم العثور على مراجع سابق بهذه البيانات.", "No existing patient found matching this query.")</span>
                                        <div class="small text-primary mt-1">@Prefs.T("يمكنك المتابعة مباشرة وتعبئة النموذج أدناه لتسجيله كمراجع جديد في النظام.", "You can proceed to fill the form below to register as a new patient.")</div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <!-- 2. VERIFIED PATIENT IDENTITY CARD (When Selected)           -->
                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <div class="medlab-verified-patient-card mb-3">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm"
                                         style="width: 44px; height: 44px; min-width: 44px; background: rgba(16, 185, 129, 0.15); color: #10B981; font-size: 20px;">
                                        <i class="fas fa-user-check"></i>
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <h6 class="fw-bold mb-0 text-medlab-navy" style="font-size: 14px;">
                                                @SelectedExistingPatient.FullNameAr
                                            </h6>
                                            <span class="badge bg-success text-white px-2 py-1" style="font-size: 10px;">
                                                <i class="fas fa-check-circle me-1"></i> @Prefs.T("مراجع مسجل ومعتمد", "Verified Existing Patient")
                                            </span>
                                            <span class="badge font-monospace bg-light text-primary border" style="font-size: 10.5px;">
                                                MRN: #@SelectedExistingPatient.Mrn
                                            </span>
                                        </div>
                                        <div class="text-secondary small d-flex align-items-center gap-3 mt-1 flex-wrap" style="font-size: 11.5px;">
                                            <span><strong>@Prefs.T("الجنس والعمر", "Gender & Age"):</strong> @(SelectedExistingPatient.Sex == "F" ? Prefs.T("أنثى", "Female") : Prefs.T("ذكر", "Male")) • @CalculatedAgeText</span>
                                            <span><strong>@Prefs.T("الهاتف", "Phone"):</strong> <span class="font-monospace">@(SelectedExistingPatient.Phone ?? Prefs.T("غير متوفر", "N/A"))</span></span>
                                            <span><strong>@Prefs.T("تاريخ الميلاد", "DOB"):</strong> <span class="font-monospace">@SelectedExistingPatient.DateOfBirth.ToString("dd/MM/yyyy")</span></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex align-items-center gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary px-2 py-1 d-flex align-items-center gap-1" style="font-size: 11px; height: 28px;" @onclick="ClearPatientSearch" title="@Prefs.T("البحث عن مراجع آخر", "Search another patient")">
                                        <i class="fas fa-magnifying-glass"></i>
                                        <span>@Prefs.T("بحث عن آخر", "Search Another")</span>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger px-2 py-1 d-flex align-items-center gap-1" style="font-size: 11px; height: 28px;" @onclick="ResetToNewPatient" title="@Prefs.T("تفريغ وتسجيل مراجع جديد", "Register new patient instead")">
                                        <i class="fas fa-user-plus"></i>
                                        <span>@Prefs.T("تسجيل مراجع جديد", "New Patient")</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <!-- 3. PATIENT DEMOGRAPHICS REGISTRATION FORM                       -->
                    <!-- ═══════════════════════════════════════════════════════════════ -->
                    <div class="medlab-demographics-section">
                        <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom" style="border-color: var(--medlab-border) !important;">
                            <div class="fw-bold d-flex align-items-center gap-2" style="font-size: 12px; color: var(--medlab-text-navy);">
                                <i class="fas fa-id-card-clip text-primary"></i>
                                <span>@(SelectedExistingPatient != null 
                                    ? Prefs.T("بيانات المراجع المسترجعة (قابلة للتعديل والتدقيق لهذا الطلب)", "Retrieved Patient Data (Editable for this order)") 
                                    : Prefs.T("بيانات المراجع الأساسية (أو اكتب الاسم مباشرة للبدء)", "Patient Demographics & Registration"))</span>
                            </div>
                            @if (SelectedExistingPatient != null)
                            {
                                <span class="badge bg-light text-muted border font-monospace" style="font-size: 9.5px;">
                                    @Prefs.T("مسترجع من السجل الطبي", "Loaded from EMR")
                                </span>
                            }
                        </div>

                        <div class="row g-2">
                            <div class="col-md-12">
                                <label class="medlab-form-label">
                                    <i class="fas fa-user text-primary me-1"></i>
                                    <span>@Prefs.T("الاسم الكامل للمريض", "Patient Full Name")</span>
                                    <span class="text-danger fw-bold">*</span>
                                </label>
                                <input type="text" class="form-control form-control-sm" @bind="PatientFullName" placeholder="@Prefs.T("ادخل الاسم الثلاثي أو الرباعي للمريض...", "Type full patient name...")" style="height: 34px; font-size: 13px;" />
                            </div>

                            <div class="col-md-4">
                                <label class="medlab-form-label">
                                    <i class="fas fa-venus-mars text-primary me-1"></i>
                                    <span>@Prefs.T("الجنس", "Gender")</span>
                                </label>
                                <select class="form-select form-select-sm" @bind="PatientSex" style="height: 34px; font-size: 12.5px;">
                                    <option value="M">@Prefs.T("ذكر (Male)", "Male")</option>
                                    <option value="F">@Prefs.T("أنثى (Female)", "Female")</option>
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="medlab-form-label">
                                    <i class="fas fa-calendar-day text-primary me-1"></i>
                                    <span>@Prefs.T("تاريخ الميلاد", "Date of Birth")</span>
                                    <span class="text-danger fw-bold">*</span>
                                </label>
                                <input type="date" class="form-control form-control-sm" @bind="PatientDob" @bind:after="UpdateCalculatedAge" style="height: 34px; font-size: 12.5px;" />
                            </div>

                            <div class="col-md-4">
                                <label class="medlab-form-label">
                                    <i class="fas fa-clock text-primary me-1"></i>
                                    <span>@Prefs.T("العمر المحسوب", "Calculated Age")</span>
                                </label>
                                <input type="text" class="form-control form-control-sm text-center fw-bold text-success font-monospace" value="@CalculatedAgeText" readonly style="height: 34px; font-size: 12.5px; background: rgba(16, 185, 129, 0.08); border-color: rgba(16, 185, 129, 0.3);" />
                            </div>

                            <div class="col-md-6">
                                <label class="medlab-form-label">
                                    <i class="fas fa-phone text-primary me-1"></i>
                                    <span>@Prefs.T("رقم الهاتف", "Phone Number")</span>
                                </label>
                                <input type="text" class="form-control form-control-sm font-monospace" @bind="PatientPhone" placeholder="07XXXXXXXXX" style="height: 34px; font-size: 12.5px;" />
                            </div>

                            <div class="col-md-6">
                                <label class="medlab-form-label">
                                    <i class="fas fa-user-doctor text-primary me-1"></i>
                                    <span>@Prefs.T("الطبيب أو العيادة المحولة", "Referring Doctor / Clinic")</span>
                                </label>
                                <input type="text" class="form-control form-control-sm" @bind="ReferringDoctor" placeholder="@Prefs.T("د. فلان / المستشفى المحول منها...", "Doctor name or hospital...")" style="height: 34px; font-size: 12.5px;" />
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(PatientStepError))
                    {
                        <div class="alert alert-danger py-2 px-3 mt-3 mb-0" style="font-size: 12px;">@PatientStepError</div>
                    }
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer medlab-modal-footer d-flex justify-content-between align-items-center">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3" style="height: 28px;" @onclick="CloseModalsSafe">
                        <i class="fas fa-times me-1"></i> @Prefs.T("إلغاء", "Cancel")
                    </button>
                    <button type="button" class="btn btn-sm btn-primary fw-bold px-4 d-flex align-items-center gap-1" style="background: var(--medlab-green); border-color: var(--medlab-green); height: 28px;" @onclick="ProceedToStep2TestSelection">
                        <span>@Prefs.T("متابعة واختيار التحاليل المطلوبة", "Proceed to Test Selection")</span>
                        <i class="fas @(Prefs.IsArabic ? "fa-arrow-left" : "fa-arrow-right") ms-1"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- STEP 2 MODAL: Test Selection & Billing Calculation                        -->
<!-- ========================================================================= -->
@if (IsStep2TestsModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(4px); z-index: 1060;">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg medlab-modal-content" style="border-radius: 6px; overflow: hidden; border: 1px solid var(--medlab-border) !important; max-height: 90vh; display: flex; flex-direction: column;">
                <!-- Header -->
                <div class="modal-header py-2 px-3 border-bottom d-flex justify-content-between align-items-center medlab-modal-header" style="border-color: var(--medlab-border) !important;">
                    <div class="d-flex align-items-center gap-2">
                        <div class="d-flex align-items-center justify-content-center rounded-2" style="width: 32px; height: 32px; background: rgba(0, 62, 107, 0.1); color: var(--medlab-navy);">
                            <i class="fas fa-flask" style="font-size: 14px;"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <h6 class="fw-bold mb-0 text-medlab-navy" style="font-size: 13.5px;">
                                    | @Prefs.T("الخطوة 2: اختيار الفحوصات والفوترة الطبية", "Step 2: Test Selection & Medical Billing")
                                </h6>
                                <span class="badge font-monospace" style="background: var(--medlab-navy); color: #fff; font-size: 10px;">2 / 2</span>
                            </div>
                            <div class="text-muted" style="font-size: 11px;">
                                @Prefs.T("المريض:", "Patient:") <strong>@PatientFullName</strong> | @(PatientSex == "F" ? Prefs.T("أنثى", "Female") : Prefs.T("ذكر", "Male")) | @CalculatedAgeText
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseModalsSafe"></button>
                </div>

                <div class="modal-body p-3 overflow-auto" style="flex: 1;">
                    <div class="row g-3">
                        <!-- Left: Available Tests Catalog (col-md-7) -->
                        <div class="col-md-7 border-end" style="border-color: var(--medlab-border) !important;">
                            <h6 class="fw-bold text-medlab-navy mb-2 d-flex align-items-center gap-2" style="font-size: 12px;">
                                <i class="fas fa-list-check text-primary"></i>
                                <span>@Prefs.T("دليل الفحوصات الطبية المتاحة للاختيار:", "Available Tests Catalog:")</span>
                            </h6>
                            <div class="row g-2 mb-2">
                                <div class="col-md-8">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-white border-end-0 text-muted">
                                            <i class="fas fa-search"></i>
                                        </span>
                                        <input type="text" class="form-control border-start-0" placeholder="@Prefs.T("ابحث باسم التحليل أو الكود (CBC, Lipid, TSH...)", "Search by test name or code (CBC, Lipid...)...")" 
                                               @bind="TestSearchFilter" @bind:event="oninput" @onkeyup="FilterAvailableTests" style="height: 30px; font-size: 12px;" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <select class="form-select form-select-sm" @bind="DepartmentFilter" @bind:after="FilterAvailableTests" style="height: 30px; font-size: 12px;">
                                        <option value="">@Prefs.T("جميع الأقسام", "All Departments")</option>
                                        @if (Departments != null)
                                        {
                                            @foreach (var d in Departments)
                                            {
                                                <option value="@d.Id">@d.DisplayName</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>

                            <!-- Tests Catalog Grid -->
                            <div class="border rounded p-2 bg-light bg-opacity-25" style="max-height: 380px; overflow-y: auto; border-color: var(--medlab-border) !important;">
                                @if (FilteredCatalogTests == null || !FilteredCatalogTests.Any())
                                {
                                    <div class="text-center py-4 text-muted small">@Prefs.T("لا توجد فحوصات مطابقة للبحث.", "No matching tests found.")</div>
                                }
                                else
                                {
                                    <div class="row g-2">
                                        @foreach (var test in FilteredCatalogTests)
                                        {
                                            bool isSelected = SelectedTestIds.Contains(test.Id);
                                            <div class="col-md-6">
                                                <div class="medlab-catalog-item-card @(isSelected ? "selected" : "") d-flex justify-content-between align-items-center"
                                                     @onclick="() => ToggleTestSelection(test)">
                                                    <div>
                                                        <div class="fw-bold text-medlab-navy font-monospace" style="font-size: 12px;">@test.TestCode</div>
                                                        <div class="small text-truncate text-secondary" style="max-width: 170px; font-size: 11px;">@(test.NameAr ?? test.NameEn)</div>
                                                        <span class="badge bg-light text-muted border font-monospace" style="font-size: 9.5px;">@test.SpecimenTypeName</span>
                                                    </div>
                                                    <div class="text-end">
                                                        <div class="fw-bold text-medlab-navy small font-monospace">@test.FormattedPrice</div>
                                                        <span class="badge @(isSelected ? "bg-primary text-white" : "bg-light text-secondary border") mt-1" style="font-size: 9.5px;">
                                                            @(isSelected ? "✓ " + Prefs.T("محدد", "Selected") : "+ " + Prefs.T("إضافة", "Add"))
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Right: Selected Tests Cart & Financials (col-md-5) -->
                        <div class="col-md-5">
                            <h6 class="fw-bold text-medlab-navy mb-2 d-flex align-items-center gap-2" style="font-size: 12px;">
                                <i class="fas fa-cart-shopping text-primary"></i>
                                <span>@Prefs.T("الفحوصات المحددة للطلب", "Selected Tests") (@SelectedTests.Count):</span>
                            </h6>

                            <!-- Selected List -->
                            <div class="border rounded p-2 mb-2 bg-white" style="max-height: 180px; overflow-y: auto; border-color: var(--medlab-border) !important;">
                                @if (!SelectedTests.Any())
                                {
                                    <div class="text-center py-4 text-muted small">@Prefs.T("لم يتم اختيار أي فحص بعد. انقر على الفحوصات في اليسار للإضافة.", "No tests selected yet. Click tests on the left to add.")</div>
                                }
                                else
                                {
                                    <ul class="list-group list-group-flush">
                                        @foreach (var st in SelectedTests)
                                        {
                                            <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center p-1 border-bottom">
                                                <div>
                                                    <strong class="text-medlab-navy font-monospace" style="font-size: 11.5px;">@st.TestCode</strong> - <span style="font-size: 11px;">@(st.NameAr ?? st.NameEn)</span>
                                                    <div class="text-muted" style="font-size: 9.5px;">@st.SpecimenTypeName</div>
                                                </div>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="fw-bold font-monospace text-medlab-navy small">@st.FormattedPrice</span>
                                                    <button class="btn btn-sm btn-outline-danger py-0 px-1" style="font-size: 10px; height: 20px; line-height: 18px;" @onclick="() => RemoveSelectedTest(st.Id)">
                                                        <i class="fas fa-trash-can"></i>
                                                    </button>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>

                            <!-- Specimen Tubes Auto-Grouping Preview -->
                            @if (EstimatedTubes.Any())
                            {
                                <div class="mb-2 p-2 rounded bg-light border" style="border-color: var(--medlab-border) !important;">
                                    <small class="medlab-form-label d-block mb-1 d-flex align-items-center gap-1">
                                        <i class="fas fa-vial text-primary"></i>
                                        <span>@Prefs.T("الأنابيب والعينات المطلوبة للسحب:", "Required Specimen Tubes:")</span>
                                    </small>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var tube in EstimatedTubes)
                                        {
                                            <span class="badge bg-white text-medlab-navy border px-2 py-1" style="font-size: 10px;">
                                                @tube.SpecimenTypeName (@tube.TestsCount @Prefs.T("تحليل", "Tests"))
                                            </span>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Financial Breakdown Box -->
                            <div class="medlab-cart-box">
                                <div class="d-flex justify-content-between mb-1" style="font-size: 12px;">
                                    <span class="text-muted">@Prefs.T("المبلغ الإجمالي (Total):", "Total Amount:")</span>
                                    <strong class="text-medlab-navy font-monospace">@TotalPrice.ToString("N0") د.ع</strong>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="text-muted small">@Prefs.T("الخصم (Discount):", "Discount:")</span>
                                    <input type="number" class="form-control form-control-sm text-end fw-bold font-monospace" style="width: 100px; height: 26px; font-size: 11.5px;" 
                                           @bind="DiscountAmount" @bind:after="OnDiscountChanged" min="0" />
                                </div>

                                <div class="d-flex justify-content-between mb-1 pt-1 border-top" style="border-color: var(--medlab-border) !important; font-size: 12px;">
                                    <span class="text-primary fw-bold">@Prefs.T("الصافي المطلوب (Net):", "Net Amount:")</span>
                                    <strong class="text-primary font-monospace fs-6">@NetAmount.ToString("N0") د.ع</strong>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="d-flex align-items-center gap-1">
                                        <span class="text-muted small">@Prefs.T("المبلغ المدفوع:", "Paid Amount:")</span>
                                        <button type="button" class="btn btn-outline-success py-0 px-1" style="font-size: 9px; height: 18px; line-height: 16px;" 
                                                @onclick="ResetPaidToFull" title="@Prefs.T("دفع كامل المبلغ", "Pay Full Amount")">
                                            @Prefs.T("كامل المبلغ", "Full")
                                        </button>
                                    </div>
                                    <input type="number" class="form-control form-control-sm text-end fw-bold text-success font-monospace" style="width: 100px; height: 26px; font-size: 11.5px;" 
                                           @bind="PaidAmount" @bind:after="OnPaidAmountChanged" min="0" />
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted small">@Prefs.T("طريقة الدفع:", "Payment Method:")</span>
                                    <select class="form-select form-select-sm" style="width: 110px; height: 26px; font-size: 11px;" @bind="PaymentMethod">
                                        <option value="Cash">@Prefs.T("نقداً (Cash)", "Cash")</option>
                                        <option value="Card">@Prefs.T("كارت / زين كاش", "Card / E-Payment")</option>
                                    </select>
                                </div>

                                <div class="d-flex justify-content-between pt-1 border-top" style="border-color: var(--medlab-border) !important; font-size: 12px;">
                                    <span class="text-muted">@Prefs.T("المتبقي (Balance):", "Remaining Balance:")</span>
                                    <strong class="font-monospace @(RemainingBalance > 0 ? "text-danger" : "text-success")">
                                        @(RemainingBalance > 0 ? $"{RemainingBalance:N0} د.ع" : Prefs.T("مسدد بالكامل ✓", "Paid in Full ✓"))
                                    </strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(OrderStepError))
                    {
                        <div class="alert alert-danger py-2 px-3 mt-3 mb-0" style="font-size: 12px;">@OrderStepError</div>
                    }
                </div>

                <div class="modal-footer medlab-modal-footer d-flex justify-content-between align-items-center">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3" style="height: 28px;" @onclick="BackToStep1">
                        <i class="fas @(Prefs.IsArabic ? "fa-arrow-right" : "fa-arrow-left") me-1"></i> @Prefs.T("رجوع لبيانات المراجع", "Back to Patient Info")
                    </button>
                    <button type="button" class="btn btn-sm btn-primary fw-bold px-4 d-flex align-items-center gap-2" style="background: var(--medlab-navy); border-color: var(--medlab-navy); height: 32px;" @onclick="FinalizeAndSaveOrder" disabled="@(!SelectedTests.Any() || IsSubmittingOrder)">
                        @if (IsSubmittingOrder)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>@Prefs.T("جاري المتابعة...", "Continuing...")</span>
                        }
                        else
                        {
                            <span>@Prefs.T("متابعة", "Continue")</span>
                            <i class="fas @(Prefs.IsArabic ? "fa-arrow-left" : "fa-arrow-right") ms-1"></i>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- ORDER DETAILS, BILLING & TESTS MANAGEMENT MODAL                            -->
<!-- ========================================================================= -->
@if (SelectedOrderDetails != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(4px); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered medlab-fixed-order-dialog">
            <div class="modal-content border-0 shadow-lg medlab-modal-content" style="border-radius: 6px; overflow: hidden; border: 1px solid var(--medlab-border) !important;">
                <!-- Modal Header -->
                <div class="modal-header py-2 px-3 border-bottom d-flex justify-content-between align-items-center medlab-modal-header" style="border-color: var(--medlab-border) !important;">
                    <div class="d-flex align-items-center gap-2">
                        <div class="d-flex align-items-center justify-content-center rounded-2" style="width: 32px; height: 32px; background: rgba(0, 62, 107, 0.1); color: var(--medlab-navy);">
                            <i class="fas fa-file-invoice" style="font-size: 14px;"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <h6 class="fw-bold mb-0 text-medlab-navy" style="font-size: 13.5px;">
                                    @Prefs.T("تفاصيل الطلب والحسابات والتحاليل", "Order Details, Billing & Tests") #@SelectedOrderDetails.Order.Id (@Prefs.T("زيارة رقم", "Visit #") @SelectedOrderDetails.Order.VisitNo)
                                </h6>
                                <span class="badge-status @GetStatusClass(SelectedOrderDetails.Order.Status)" style="font-size: 10px;">
                                    @GetStatusDisplay(SelectedOrderDetails.Order.Status)
                                </span>
                            </div>
                            <div class="text-muted" style="font-size: 11px;">
                                @Prefs.T("المريض", "Patient"): <strong class="text-medlab-navy">@SelectedOrderDetails.Patient.FullNameAr</strong> | MRN: <strong class="text-medlab-navy font-monospace">@SelectedOrderDetails.Patient.Mrn</strong> | @(SelectedOrderDetails.Patient.Sex == "F" ? Prefs.T("أنثى", "Female") : Prefs.T("ذكر", "Male")) | @SelectedOrderDetails.Order.OrderDatetime.ToString("dd.MM.yyyy HH:mm")
                            </div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn-close" @onclick="() => SelectedOrderDetails = null"></button>
                    </div>
                </div>

                <div class="modal-body">
                    <!-- Status / Action Message Alert -->
                    @if (!string.IsNullOrEmpty(DetailsAlertMessage))
                    {
                        <div class="alert @DetailsAlertClass py-2 px-3 mb-2 d-flex justify-content-between align-items-center flex-shrink-0" style="font-size: 12px;">
                            <span>@DetailsAlertMessage</span>
                            <button type="button" class="btn-close small" @onclick="ClearDetailsAlert"></button>
                        </div>
                    }

                    <!-- ══ 1. FINANCIAL SUMMARY & DIRECT CASHIER PAYMENT ══ -->
                    <div class="medlab-cart-box flex-shrink-0 p-2 px-3 border rounded shadow-sm" style="background: var(--medlab-card-bg); border-color: var(--medlab-border) !important;">
                        <div class="row g-2 align-items-center">
                            <div class="col-md col-4 border-end" style="border-color: var(--medlab-border) !important;">
                                <div class="medlab-form-label mb-0" style="font-size: 10.5px;">@Prefs.T("إجمالي الفاتورة", "Total Amount")</div>
                                <div class="fw-bold text-medlab-navy fs-6 mt-1 font-monospace">@((SelectedOrderDetails.Invoice?.Total ?? 0).ToString("N0")) د.ع</div>
                            </div>
                            <div class="col-md col-4 border-end" style="border-color: var(--medlab-border) !important;">
                                <div class="medlab-form-label mb-0" style="font-size: 10.5px;">@Prefs.T("الخصم الممنوح", "Discount")</div>
                                <div class="fw-bold text-warning fs-6 mt-1 font-monospace">@((SelectedOrderDetails.Invoice?.Discount ?? 0).ToString("N0")) د.ع</div>
                            </div>
                            <div class="col-md col-4 border-end" style="border-color: var(--medlab-border) !important;">
                                <div class="medlab-form-label mb-0 text-primary" style="font-size: 10.5px;">@Prefs.T("الصافي المطلوب", "Net Total")</div>
                                <div class="fw-bold text-primary fs-6 mt-1 font-monospace">@((SelectedOrderDetails.Invoice?.Net ?? 0).ToString("N0")) د.ع</div>
                            </div>
                            <div class="col-md col-6 border-end" style="border-color: var(--medlab-border) !important;">
                                <div class="medlab-form-label mb-0 text-success" style="font-size: 10.5px;">@Prefs.T("المبلغ المسدد", "Paid Amount")</div>
                                <div class="fw-bold text-success fs-6 mt-1 font-monospace">@((SelectedOrderDetails.Invoice?.Paid ?? 0).ToString("N0")) د.ع</div>
                            </div>
                            <div class="col-md col-6">
                                <div class="medlab-form-label mb-0" style="font-size: 10.5px;">@Prefs.T("المتبقي بذمة المراجع", "Balance Due")</div>
                                <div class="fw-bold fs-6 mt-1 font-monospace @((SelectedOrderDetails.Invoice?.Balance ?? 0) > 0 ? "text-danger" : "text-success")">
                                    @if ((SelectedOrderDetails.Invoice?.Balance ?? 0) > 0)
                                    {
                                        <span>@((SelectedOrderDetails.Invoice?.Balance ?? 0).ToString("N0")) د.ع</span>
                                    }
                                    else
                                    {
                                        <span><i class="fas fa-check-circle text-success me-1"></i> @Prefs.T("مسدد بالكامل ✓", "Fully Paid ✓")</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Direct Cashier Payment Bar -->
                        @if (SelectedOrderDetails.Invoice != null && SelectedOrderDetails.Invoice.Balance > 0)
                        {
                            <div class="mt-2 pt-2 border-top d-flex align-items-center gap-3 flex-wrap" style="border-color: var(--medlab-border) !important; background: rgba(34, 197, 94, 0.05); padding: 10px 14px; border-radius: 8px;">
                                <div class="d-flex align-items-center gap-1 text-success fw-bold" style="font-size: 12.5px;">
                                    <i class="fas fa-cash-register fs-6"></i>
                                    <span>@Prefs.T("عملية الدفع:", "Cashier Payment:")</span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <label class="medlab-form-label mb-0 text-nowrap fw-bold" style="font-size: 11.5px;">@Prefs.T("المبلغ (د.ع):", "Amount (IQD):")</label>
                                    <input type="number" class="form-control form-control-sm fw-bold text-success font-monospace" style="height: 32px; width: 140px; font-size: 13px;" @bind="DetailsPaymentAmount" min="1" max="@SelectedOrderDetails.Invoice.Balance" />
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <label class="medlab-form-label mb-0 text-nowrap fw-bold" style="font-size: 11.5px;">@Prefs.T("طريقة الدفع:", "Payment Method:")</label>
                                    <div class="btn-group shadow-sm" role="group">
                                        <button type="button" class="btn btn-sm px-3 d-flex align-items-center gap-1 @(DetailsPaymentMethod == "Cash" ? "btn-success fw-bold text-white shadow-sm" : "btn-outline-secondary bg-white")" 
                                                style="height: 32px; font-size: 11.5px; border-radius: 4px 0 0 4px;" 
                                                @onclick='() => DetailsPaymentMethod = "Cash"'>
                                            <i class="fas fa-money-bill-wave"></i>
                                            <span>@Prefs.T("نقداً (Cash)", "Cash")</span>
                                        </button>
                                        <button type="button" class="btn btn-sm px-3 d-flex align-items-center gap-1 @(DetailsPaymentMethod == "Card" ? "btn-primary fw-bold text-white shadow-sm" : "btn-outline-secondary bg-white")" 
                                                style="height: 32px; font-size: 11.5px; border-radius: 0 4px 4px 0;" 
                                                @onclick='() => DetailsPaymentMethod = "Card"'>
                                            <i class="fas fa-credit-card"></i>
                                            <span>@Prefs.T("بالبطاقة (Card)", "Card")</span>
                                        </button>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-sm fw-bold px-4 d-flex align-items-center gap-2 shadow-sm ms-auto @(DetailsPaymentMethod == "Card" ? "btn-primary" : "btn-success")" 
                                        style="height: 34px; font-size: 12.5px; @(DetailsPaymentMethod == "Card" ? "background: #2563eb; border-color: #2563eb;" : "background: #16a34a; border-color: #16a34a;")" 
                                        @onclick="SubmitDetailsPayment" disabled="@IsProcessingPayment">
                                    @if (IsProcessingPayment)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                        <span>@Prefs.T("جاري الدفع...", "Processing...")</span>
                                    }
                                    else
                                    {
                                        <i class="fas @(DetailsPaymentMethod == "Card" ? "fa-credit-card" : "fa-money-bill-wave")"></i>
                                        <span>
                                            @if (DetailsPaymentMethod == "Card")
                                            {
                                                @Prefs.T("دفع بالبطاقة وطباعة الوصل", "Pay with Card & Print")
                                            }
                                            else
                                            {
                                                @Prefs.T("دفع نقداً وطباعة الوصل", "Pay with Cash & Print")
                                            }
                                        </span>
                                    }
                                </button>
                            </div>
                        }
                    </div>

                    <!-- ══ 2. ORDERED TESTS MANAGEMENT (ADD / DELETE) ══ -->
                    <div class="medlab-order-details-card medlab-order-tests-container shadow-sm">
                        <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2 flex-shrink-0">
                            <div class="d-flex align-items-center gap-2">
                                <h6 class="fw-bold text-medlab-navy mb-0 d-flex align-items-center gap-2" style="font-size: 12.5px;">
                                    <i class="fas fa-clipboard-list text-primary"></i>
                                    <span>@Prefs.T("قائمة التحاليل المطلوبة لهذا الطلب", "Ordered Laboratory Tests")</span>
                                </h6>
                                <span class="badge" style="background: var(--medlab-navy); color: #fff; font-size: 10px;">
                                    @(SelectedOrderDetails.Specimens.Sum(s => s.Tests.Count)) @Prefs.T("فحص", "Tests")
                                </span>
                            </div>

                            <!-- Quick Add Test To Order Bar with Live Search -->
                            <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-end flex-wrap" style="max-width: 750px;">
                                <!-- Live Search Input -->
                                <div class="input-group input-group-sm" style="width: 240px;">
                                    <span class="input-group-text bg-transparent text-muted border-end-0">
                                        <i class="fas fa-search"></i>
                                    </span>
                                    <input type="text" class="form-control border-start-0" 
                                           placeholder="@Prefs.T("ابحث باسم الفحص أو الكود...", "Search test name or code...")" 
                                           @bind="AddTestSearchQuery" @bind:event="oninput" @onkeydown="HandleAddTestKeyDown" style="height: 28px; font-size: 11.5px;" />
                                    @if (!string.IsNullOrEmpty(AddTestSearchQuery))
                                    {
                                        <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="ClearAddTestSearch" title="@Prefs.T("مسح", "Clear")">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    }
                                </div>

                                <!-- Filtered Tests Dropdown -->
                                <select class="form-select form-select-sm flex-grow-1" style="min-width: 220px; height: 28px; font-size: 11.5px;" @bind="SelectedTestToAddId">
                                    <option value="0">@Prefs.T($"-- اختر فحصاً ({AddTestFilteredCatalog.Count()} فحص متاح) --", $"-- Select test ({AddTestFilteredCatalog.Count()} available) --")</option>
                                    @foreach (var t in AddTestFilteredCatalog)
                                    {
                                        <option value="@t.Id">[@t.TestCode] @(t.NameAr ?? t.NameEn) - @t.FormattedPrice (@t.SpecimenTypeName)</option>
                                    }
                                </select>

                                <!-- Add Button -->
                                <button class="btn btn-sm btn-primary fw-bold text-nowrap px-3" style="height: 28px; font-size: 11px;" @onclick="AddTestToCurrentOrder" disabled="@(SelectedTestToAddId == 0 || IsAddingTest)">
                                    @if (IsAddingTest)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                        <span>@Prefs.T("جاري الإضافة...", "Adding...")</span>
                                    }
                                    else
                                    {
                                        <span><i class="fas fa-plus me-1"></i> @Prefs.T("إضافة الفحص", "Add Test")</span>
                                    }
                                </button>
                            </div>
                        </div>

                        <!-- Table of Ordered Tests with Fixed Height & Sticky Header -->
                        <div class="table-responsive medlab-order-tests-table-wrapper">
                            <table class="medlab-table mb-0 w-100">
                                <thead>
                                    <tr>
                                        <th>@Prefs.T("اسم التحليل", "TEST NAME")</th>
                                        <th style="width: 140px;">@Prefs.T("نوع العينة / الأنبوب", "SPECIMEN / TUBE")</th>
                                        <th style="width: 180px;">@Prefs.T("باركود العينة", "ACCESSION BARCODE")</th>
                                        <th style="width: 110px;">@Prefs.T("السعر", "PRICE")</th>
                                        <th style="width: 110px;" class="text-center">@Prefs.T("الحالة", "STATUS")</th>
                                        <th class="text-center" style="width: 80px;">@Prefs.T("إجراءات", "ACTIONS")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (SelectedOrderDetails.Specimens == null || !SelectedOrderDetails.Specimens.Any() || !SelectedOrderDetails.Specimens.Any(s => s.Tests.Any()))
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center py-4 text-muted small">
                                                <i class="fas fa-clipboard-question fs-4 d-block opacity-50 mb-1"></i>
                                                @Prefs.T("لا توجد تحاليل مسجلة لهذا الطلب حالياً.", "No tests currently ordered.")
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var spec in SelectedOrderDetails.Specimens)
                                        {
                                            var tubeColor = GetTubeColor(spec.SpecimenTypeName);
                                            @foreach (var test in spec.Tests)
                                            {
                                                long orderTestId = test.OrderTestId;
                                                string testName = test.NameAr ?? test.NameEn;
                                                <tr>
                                                    <td>
                                                        <div class="fw-bold text-medlab-navy" style="font-size: 12px;">@testName</div>
                                                        <div class="small text-muted font-monospace" style="font-size: 10px;">@test.TestCode</div>
                                                    </td>
                                                    <td>
                                                        <div class="d-flex align-items-center gap-1">
                                                            <span style="width: 9px; height: 9px; border-radius: 2px; background-color: @tubeColor; display: inline-block;"></span>
                                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border font-monospace" style="font-size: 9.5px;">@spec.SpecimenTypeName</span>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <strong class="text-primary font-monospace" style="font-size: 11.5px;">@spec.Specimen.AccessionNo</strong>
                                                    </td>
                                                    <td class="fw-bold text-medlab-navy font-monospace" style="font-size: 11.5px;">
                                                        @test.Price.ToString("N0") د.ع
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge-status @GetStatusClass(test.Status)" style="font-size: 9.5px;">
                                                            @GetStatusDisplay(test.Status)
                                                        </span>
                                                        @if (spec.Rejection != null)
                                                        {
                                                            <div class="mt-1">
                                                                <span class="badge bg-danger text-white font-monospace text-wrap" style="font-size: 8.5px; max-width: 140px; display: inline-block;" title="@($"{Prefs.T("سبب الرفض:", "Reason:")} {spec.Rejection.DisplayReason}\n{Prefs.T("ملاحظات:", "Notes:")} {spec.Rejection.Notes}\n{Prefs.T("بواسطة:", "By:")} {spec.Rejection.UserFullName ?? spec.Rejection.Username}")">
                                                                    ⚠️ @spec.Rejection.DisplayReason
                                                                </span>
                                                            </div>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        @if (test.Status == "Ordered" && SelectedOrderDetails.Order.Status != "Cancelled")
                                                        {
                                                            <button class="btn btn-sm btn-outline-danger py-0 px-2" style="font-size: 10px; height: 22px; line-height: 20px;" title="@Prefs.T("حذف هذا الفحص من الطلب وتعديل الفاتورة", "Remove test from order")" @onclick="() => RemoveTestFromCurrentOrder(orderTestId, testName)">
                                                                <i class="fas fa-trash-can me-1"></i> @Prefs.T("حذف", "Delete")
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border" style="font-size: 9.5px;">@Prefs.T("مُستلم ✓", "Received ✓")</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- ══ 3. NOTICE BANNER ══ -->
                    <div class="p-2 px-3 rounded border d-flex align-items-center gap-2 mb-0 flex-shrink-0" style="background: rgba(2, 132, 199, 0.05); border-color: var(--medlab-border) !important;">
                        <i class="fas fa-circle-info text-primary" style="font-size: 13px;"></i>
                        <span style="font-size: 11px; color: var(--medlab-text-navy);">
                            @Prefs.T("معلومات المراجع والطلب جاهزة. يمكنك طباعة باركود الأنابيب (50×25 مم) مباشرة بالضغط على زر [طباعة باركود الأنابيب] بالأعلى أو بالأسفل، أو بجانب كل أنبوب، بالإضافة لإدارة الفاتورة والوصل.", "Patient & order ready. You can print tube barcodes (50x25mm) directly by clicking [Print Tube Barcodes] at top/bottom, or beside each tube, in addition to cashier receipts and payments.")
                        </span>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer medlab-modal-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <button type="button" class="btn btn-sm btn-primary fw-bold d-flex align-items-center gap-2 px-3 shadow-sm" style="height: 32px; font-size: 11.5px; background: var(--medlab-navy); border-color: var(--medlab-navy);" @onclick="OpenOrderBarcodeLabelsModal">
                            <i class="fas fa-barcode fs-6"></i>
                            <span>@Prefs.T("طباعة باركودات التحاليل", "Print Specimen Barcodes")</span>
                        </button>
                        @if (SelectedOrderDetails.Order.Status != "Cancelled")
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger" style="height: 30px; font-size: 11px;" @onclick="CancelCurrentOrder">
                                <i class="fas fa-ban me-1"></i> @Prefs.T("إلغاء الطلب", "Cancel Order")
                            </button>
                        }
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary px-3" style="height: 28px; font-size: 11px;" @onclick="() => SelectedOrderDetails = null">
                            @Prefs.T("إغلاق", "Close")
                        </button>
                        <a href="results?orderId=@SelectedOrderDetails.Order.Id" class="btn btn-sm btn-primary fw-bold px-3 d-flex align-items-center gap-1" style="height: 28px; font-size: 11px;">
                            <span>@Prefs.T("الانتقال المباشر للنتائج والاعتماد", "Go to Results & Validation")</span>
                            <i class="fas @(Prefs.IsArabic ? "fa-arrow-left" : "fa-arrow-right") ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- MODAL: 80mm Thermal Cashier Receipt Preview & Print (Like Real Cashier)    -->
<!-- ========================================================================= -->
@if (IsReceiptModalOpen && SelectedOrderDetails != null)
{
    var labNameAr = !string.IsNullOrWhiteSpace(LabSettings?.LabNameAr) ? LabSettings.LabNameAr : "مختبر النقاء التخصصي";
    var labNameEn = !string.IsNullOrWhiteSpace(LabSettings?.LabNameEn) ? LabSettings.LabNameEn : "Al-Naqaa Specialized Lab";
    var labAddress = !string.IsNullOrWhiteSpace(LabSettings?.Address) ? LabSettings.Address : "بغداد - الكرادة";
    var labPhones = !string.IsNullOrWhiteSpace(LabSettings?.Phones) ? LabSettings.Phones : "07700000000";
    var labContact = $"{labAddress} • {labPhones}";
    var invoiceNumber = SelectedOrderDetails.Invoice?.InvoiceNo != null ? $"TEST-{SelectedOrderDetails.Invoice.InvoiceNo:D2}" : $"TEST-{SelectedOrderDetails.Order.Id:D2}";
    var patientNumber = SelectedOrderDetails.Patient.Mrn > 0 ? SelectedOrderDetails.Patient.Mrn.ToString() : (100000 + SelectedOrderDetails.Patient.Id).ToString();
    var allOrderTests = SelectedOrderDetails.Specimens.SelectMany(s => s.Tests).ToList();
    var invoiceTotal = SelectedOrderDetails.Invoice?.Total ?? allOrderTests.Sum(t => t.Price);
    var invoiceDiscount = SelectedOrderDetails.Invoice?.Discount ?? 0;
    var invoiceNet = SelectedOrderDetails.Invoice?.Net ?? invoiceTotal;
    var invoicePaid = SelectedOrderDetails.Invoice?.Paid ?? 0;
    var invoiceBalance = SelectedOrderDetails.Invoice?.Balance ?? (invoiceNet - invoicePaid);

    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(5px); z-index: 1070;">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
            <div class="modal-content border-0 shadow-lg" style="background: #1e293b; border-radius: 12px; overflow: hidden; border: 1px solid rgba(255,255,255,0.1);">
                <!-- Modal Top Header -->
                <div class="modal-header py-2 px-3 border-bottom border-secondary d-flex justify-content-between align-items-center" style="background: #0f172a;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fas fa-receipt text-success fs-5"></i>
                        <div>
                            <h6 class="fw-bold text-white mb-0" style="font-size: 13.5px;">@Prefs.T("وصل كاشير حراري (80 مم)", "Thermal Cashier Receipt (80mm)")</h6>
                            <small class="text-muted" style="font-size: 10px;">@Prefs.T("جاهز للطباعة المباشرة", "Ready for cashier printing")</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => IsReceiptModalOpen = false"></button>
                </div>

                <!-- Modal Body: Real Thermal Receipt Card with jagged edges -->
                <div class="modal-body p-3 text-center d-flex flex-column align-items-center" style="background: #0b1120; max-height: 75vh; overflow-y: auto;">
                    
                    <!-- Top Zigzag Tear decoration -->
                    <div class="receipt-zigzag-top" style="width: 320px;"></div>

                    <!-- Thermal Paper Ticket (Printable Area) -->
                    <div id="cashier-receipt-print-area" class="thermal-receipt-container text-start bg-white text-dark shadow-lg"
                         style="width: 320px; font-family: 'Segoe UI', Tahoma, Arial, sans-serif; padding: 18px 16px; direction: rtl; line-height: 1.35; color: #000;">
                        
                        <!-- 1. Lab Header -->
                        <div class="text-center" style="margin-bottom: 4px;">
                            <h5 class="fw-bold mb-0 text-black" style="font-size: 17px; font-weight: 800; letter-spacing: -0.3px;">@labNameAr</h5>
                            <div class="fw-bold text-dark" style="font-size: 13px; font-weight: 600; margin-top: 1px;">@labNameEn</div>
                            <div class="text-dark" style="font-size: 11px; margin-top: 3px; font-weight: 500;">@labContact</div>
                        </div>

                        <!-- Solid Black Line -->
                        <div style="border-bottom: 2px solid #000; margin: 8px 0;"></div>

                        <!-- 2. Patient & Invoice Metadata (2 Columns) -->
                        <div style="font-size: 11.5px; line-height: 1.55;">
                            <div class="d-flex justify-content-between align-items-start">
                                <div style="text-align: right; width: 55%;">
                                    <div><span style="font-weight: 500;">اسم المريض:</span> <strong style="font-size: 12px;">@SelectedOrderDetails.Patient.FullNameAr</strong></div>
                                    <div><span style="font-weight: 500;">رقم الفاتورة:</span> <strong class="font-monospace">#@invoiceNumber</strong></div>
                                </div>
                                <div style="text-align: left; width: 45%;">
                                    <div><span style="font-weight: 500;">التاريخ:</span> <strong class="font-monospace">@SelectedOrderDetails.Order.OrderDatetime.ToString("dd/MM/yyyy")</strong></div>
                                    <div><span style="font-weight: 500;">الرقم:</span> <strong class="font-monospace">@patientNumber</strong></div>
                                </div>
                            </div>
                        </div>

                        <!-- Solid Black Line -->
                        <div style="border-bottom: 2px solid #000; margin: 8px 0;"></div>

                        <!-- 3. Tests & Prices Table -->
                        <table style="width: 100%; border-collapse: collapse; font-size: 12px; margin: 4px 0;">
                            <thead>
                                <tr style="border-bottom: 1.5px solid #000;">
                                    <th style="text-align: right; padding: 4px 0; font-weight: 800;">الفحص</th>
                                    <th style="text-align: left; padding: 4px 0; font-weight: 800;">السعر (د.ع)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var spec in SelectedOrderDetails.Specimens)
                                {
                                    @foreach (var t in spec.Tests)
                                    {
                                        <tr>
                                            <td style="text-align: right; padding: 5px 0; vertical-align: top;">
                                                @(string.IsNullOrWhiteSpace(t.NameAr) ? t.NameEn : $"{t.NameAr} ({t.TestCode})")
                                            </td>
                                            <td style="text-align: left; padding: 5px 0; font-weight: bold; font-family: monospace; font-size: 12.5px; vertical-align: top;">
                                                @t.Price.ToString("N0")
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>

                        <!-- Dashed Black Line -->
                        <div style="border-bottom: 1.5px dashed #000; margin: 8px 0;"></div>

                        <!-- 4. Financial Totals & Paid Amount -->
                        @if (invoiceDiscount > 0)
                        {
                            <div class="d-flex justify-content-between" style="font-size: 11.5px; margin-bottom: 3px;">
                                <span>المبلغ الإجمالي</span>
                                <span class="font-monospace">@invoiceTotal.ToString("N0") د.ع</span>
                            </div>
                            <div class="d-flex justify-content-between" style="font-size: 11.5px; margin-bottom: 3px;">
                                <span>الخصم الممنوح</span>
                                <span class="font-monospace">-@invoiceDiscount.ToString("N0") د.ع</span>
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center" style="padding: 2px 0;">
                            <div>
                                <span style="font-size: 15px; font-weight: 800;">المبلغ المدفوع</span>
                                <div style="font-size: 11px; font-weight: 700; color: #1e293b;">
                                    طريقة الدفع: @(CurrentReceiptPaymentMethod == "Card" ? "بالبطاقة (Card) 💳" : "نقداً (Cash) 💵")
                                </div>
                            </div>
                            <span class="font-monospace" style="font-size: 17px; font-weight: 800;">@invoicePaid.ToString("N0") د.ع</span>
                        </div>

                        @if (invoiceBalance > 0)
                        {
                            <div class="d-flex justify-content-between" style="font-size: 11.5px; margin-top: 4px; color: #dc2626; font-weight: bold;">
                                <span>المتبقي بذمة المريض</span>
                                <span class="font-monospace">@invoiceBalance.ToString("N0") د.ع</span>
                            </div>
                        }

                        <!-- Solid Black Line -->
                        <div style="border-bottom: 2px solid #000; margin: 8px 0;"></div>

                        <!-- 5. Footer Thank You -->
                        <div class="text-center" style="margin-top: 6px;">
                            <div style="font-size: 15px; font-weight: 800; margin-bottom: 2px;">شكراً لزيارتكم</div>
                            <div style="font-size: 13px; font-weight: 600;">Thank you for visiting</div>
                        </div>

                    </div>

                    <!-- Bottom Zigzag Tear decoration -->
                    <div class="receipt-zigzag-bottom" style="width: 320px;"></div>

                </div>

                <!-- Modal Footer with Printing Actions -->
                <div class="modal-footer py-2 px-3 border-top border-secondary d-flex justify-content-between align-items-center" style="background: #0f172a;">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => IsReceiptModalOpen = false">
                        <i class="fas fa-times me-1"></i> @Prefs.T("إغلاق", "Close")
                    </button>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary btn-sm fw-bold px-3" @onclick="PrintSilentReceipt" title="@Prefs.T("طباعة صامتة فورية لطابعة الإيصالات المثبتة", "Silent Direct Print")">
                            <i class="fas fa-bolt me-1"></i> @Prefs.T("طباعة صامتة", "Direct Print")
                        </button>
                        <button type="button" class="btn btn-success btn-sm fw-bold px-3" onclick="lisPrintThermalReceipt('cashier-receipt-print-area')">
                            <i class="fas fa-print me-1"></i> @Prefs.T("طباعة الوصل (80 مم)", "Print Receipt (80mm)")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- MODAL: Cashier Thermal Refund Receipt (وصل استرجاع مالي 80mm)            -->
<!-- ========================================================================= -->
@if (IsRefundReceiptModalOpen && LastRefundResult != null)
{
    string labNameAr = LabSettings?.LabNameAr ?? "مختبر التحليلات المرضية المتقدم";
    string labNameEn = LabSettings?.LabNameEn ?? "Advanced Clinical Laboratory";
    string labContact = $"{LabSettings?.Address ?? "بغداد - الكرادة"} | هاتف: {LabSettings?.Phones ?? "07700000000"}";

    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.8); backdrop-filter: blur(5px); z-index: 1060;">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content card border-0 shadow-5-strong" style="background: #0f172a;">
                
                <!-- Modal Header -->
                <div class="modal-header py-2 px-3 border-bottom border-secondary d-flex justify-content-between align-items-center" style="background: #1e293b;">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-danger p-1 fs-6"><i class="fas fa-undo"></i></span>
                        <div>
                            <h6 class="modal-title fw-bold text-white mb-0" style="font-size: 14px;">@Prefs.T("وصل استرجاع مالي (Refund Receipt)", "Refund Receipt (80mm)")</h6>
                            <div class="text-white-50 small" style="font-size: 10px;">@Prefs.T("إلغاء فحص واسترجاع قيمته للمراجع", "Test cancellation & refund voucher")</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => IsRefundReceiptModalOpen = false"></button>
                </div>

                <!-- Modal Body: Real Thermal Receipt Card with jagged edges -->
                <div class="modal-body p-3 text-center d-flex flex-column align-items-center" style="background: #0b1120; max-height: 75vh; overflow-y: auto;">
                    
                    <!-- Top Zigzag Tear decoration -->
                    <div class="receipt-zigzag-top" style="width: 320px;"></div>

                    <!-- Thermal Paper Ticket (Printable Area) -->
                    <div id="cashier-refund-print-area" class="thermal-receipt-container text-start bg-white text-dark shadow-lg"
                         style="width: 320px; font-family: 'Segoe UI', Tahoma, Arial, sans-serif; padding: 18px 16px; direction: rtl; line-height: 1.35; color: #000;">
                        
                        <!-- 1. Lab Header -->
                        <div class="text-center" style="margin-bottom: 4px;">
                            <h5 class="fw-bold mb-0 text-black" style="font-size: 17px; font-weight: 800; letter-spacing: -0.3px;">@labNameAr</h5>
                            <div class="fw-bold text-dark" style="font-size: 13px; font-weight: 600; margin-top: 1px;">@labNameEn</div>
                            <div class="text-dark" style="font-size: 11px; margin-top: 3px; font-weight: 500;">@labContact</div>
                        </div>

                        <!-- Solid Black Line -->
                        <div style="border-bottom: 2px solid #000; margin: 8px 0;"></div>

                        <!-- 2. Receipt Title Box -->
                        <div class="text-center py-1 my-1" style="border: 2px dashed #dc2626; background: #fef2f2; border-radius: 4px;">
                            <div class="fw-bold text-danger" style="font-size: 15px; font-weight: 800;">وصل استرجاع مالي</div>
                            <div class="text-danger small font-monospace" style="font-size: 11px; font-weight: 700;">REFUND VOUCHER</div>
                        </div>

                        <!-- 3. Patient & Refund Metadata -->
                        <div style="font-size: 11.5px; line-height: 1.55; margin-top: 6px;">
                            <div class="d-flex justify-content-between align-items-start">
                                <div style="text-align: right; width: 55%;">
                                    <div><span style="font-weight: 500;">اسم المريض:</span> <strong style="font-size: 12px;">@LastRefundResult.PatientName</strong></div>
                                    <div><span style="font-weight: 500;">رقم الفاتورة:</span> <strong class="font-monospace">#@(LastRefundResult.InvoiceNo > 0 ? LastRefundResult.InvoiceNo.ToString() : LastRefundResult.OrderId.ToString())</strong></div>
                                </div>
                                <div style="text-align: left; width: 45%;">
                                    <div><span style="font-weight: 500;">التاريخ:</span> <strong class="font-monospace">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</strong></div>
                                    <div><span style="font-weight: 500;">الرقم:</span> <strong class="font-monospace">@LastRefundResult.Mrn</strong></div>
                                </div>
                            </div>
                        </div>

                        <!-- Solid Black Line -->
                        <div style="border-bottom: 2px solid #000; margin: 8px 0;"></div>

                        <!-- 4. Cancelled Test Details Table -->
                        <div style="font-size: 11px; font-weight: 700; margin-bottom: 4px; color: #475569;">تفاصيل الفحص الملغي:</div>
                        <table style="width: 100%; border-collapse: collapse; font-size: 12px; margin: 4px 0;">
                            <thead>
                                <tr style="border-bottom: 1.5px solid #000;">
                                    <th style="text-align: right; padding: 4px 0; font-weight: 800;">الفحص الملغي</th>
                                    <th style="text-align: left; padding: 4px 0; font-weight: 800;">المبلغ المسترجع</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="text-align: right; padding: 6px 0; vertical-align: top;">
                                        <strong>@LastRefundResult.TestName</strong>
                                        <div class="text-muted" style="font-size: 10.5px;">كود: @LastRefundResult.TestCode</div>
                                    </td>
                                    <td style="text-align: left; padding: 6px 0; font-weight: bold; font-family: monospace; font-size: 13px; vertical-align: top; color: #dc2626;">
                                        -@LastRefundResult.RefundAmount.ToString("N0") د.ع
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Dashed Black Line -->
                        <div style="border-bottom: 1.5px dashed #000; margin: 8px 0;"></div>

                        <!-- 5. Refund Amount Box -->
                        <div class="d-flex justify-content-between align-items-center" style="padding: 4px 0;">
                            <div>
                                <span style="font-size: 14px; font-weight: 800; color: #dc2626;">المبلغ المسترجع للمراجع:</span>
                                <div style="font-size: 11px; font-weight: 700; color: #1e293b;">
                                    طريقة الإرجاع: نقداً (Cash Refund) 💵
                                </div>
                            </div>
                            <span class="font-monospace" style="font-size: 18px; font-weight: 800; color: #dc2626;">
                                @LastRefundResult.RefundAmount.ToString("N0") د.ع
                            </span>
                        </div>

                        <!-- Solid Black Line -->
                        <div style="border-bottom: 2px solid #000; margin: 8px 0;"></div>

                        <!-- 6. Footer & Signatures -->
                        <div class="d-flex justify-content-between align-items-end mt-3 pt-2" style="font-size: 10.5px;">
                            <div style="text-align: center; width: 45%;">
                                <div style="border-bottom: 1px dotted #000; margin-bottom: 3px; height: 18px;"></div>
                                <span>توقيع المراجع المستلم</span>
                            </div>
                            <div style="text-align: center; width: 45%;">
                                <div style="border-bottom: 1px dotted #000; margin-bottom: 3px; height: 18px;"></div>
                                <span>أمين الصندوق: @(AuthSession.CurrentUser?.FullName ?? "المحاسب")</span>
                            </div>
                        </div>

                    </div>

                    <!-- Bottom Zigzag Tear decoration -->
                    <div class="receipt-zigzag-bottom" style="width: 320px;"></div>

                </div>

                <!-- Modal Footer with Printing Actions -->
                <div class="modal-footer py-2 px-3 border-top border-secondary d-flex justify-content-between align-items-center" style="background: #0f172a;">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => IsRefundReceiptModalOpen = false">
                        <i class="fas fa-times me-1"></i> @Prefs.T("إغلاق", "Close")
                    </button>
                    <button type="button" class="btn btn-danger btn-sm fw-bold px-3" onclick="lisPrintThermalReceipt('cashier-refund-print-area')">
                        <i class="fas fa-print me-1"></i> @Prefs.T("طباعة وصل الاسترجاع (80 مم)", "Print Refund Receipt (80mm)")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

