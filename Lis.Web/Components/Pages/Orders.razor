    private static string FormatGender(object? sexObj)
    {
        var s = sexObj?.ToString()?.Trim().ToUpper();
        return s switch
        {
            "M" or "MALE" or "ذكر" => "M",
            "F" or "FEMALE" or "أنثى" => "F",
            _ => "--"
        };
    }

    private static string FormatAge(object? dobObj)
    {
        if (dobObj == null || dobObj is DBNull) return "--";
        DateTime dob;
        if (dobObj is DateTime dt) dob = dt;
        else if (!DateTime.TryParse(dobObj.ToString(), out dob)) return "--";

        var today = DateTime.Today;
        int years = today.Year - dob.Year;
        if (dob.Date > today.AddYears(-years)) years--;

        if (years >= 2) return $"{years}";
        
        int months = (today.Year - dob.Year) * 12 + today.Month - dob.Month;
        if (today.Day < dob.Day) months--;
        if (months > 0) return $"{months}m";

        int days = (today - dob).Days;
        return $"{Math.Max(1, days)}d";
    }

