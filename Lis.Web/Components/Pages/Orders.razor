    private async Task SubmitDetailsPayment()
    {
        if (SelectedOrderDetails?.Invoice == null) return;
        if (DetailsPaymentAmount <= 0 || DetailsPaymentAmount > SelectedOrderDetails.Invoice.Balance)
        {
            SetDetailsAlert(Prefs.T("يرجى إدخال مبلغ صحيح ضمن حدود المبلغ المتبقي.", "Please enter a valid amount within the remaining balance."), "alert-warning");
            return;
        }

        IsProcessingPayment = true;
        DetailsAlertMessage = "";

        try
        {
            await BillingService.RecordPaymentAsync(
                SelectedOrderDetails.Invoice.Id,
                DetailsPaymentAmount,
                DetailsPaymentMethod,
                currentUserId: 1);

            SetDetailsAlert(Prefs.T($"✅ تم تسديد مبلغ ({DetailsPaymentAmount:N0} د.ع) بنجاح!", $"✅ Payment of ({DetailsPaymentAmount:N0} IQD) recorded successfully!"), "alert-success");
            CurrentReceiptPaymentMethod = DetailsPaymentMethod;
            IsDetailsPaymentBoxOpen = false;

            // Reload order details & main list, and show receipt
            await ViewOrderDetails(SelectedOrderDetails.Order.Id);
            await RefreshOrders();
            _isReceiptPrintingTriggered = false;
            IsReceiptModalOpen = true;
        }
        catch (Exception ex)
        {
            SetDetailsAlert(Prefs.T($"خطأ في تسجيل الدفعة: {ex.Message}", $"Error recording payment: {ex.Message}"), "alert-danger");
        }
        finally
        {
            IsProcessingPayment = false;
        }
    }

