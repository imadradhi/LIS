    private string GetTubeColor(string? tubeName)
    {
        if (string.IsNullOrWhiteSpace(tubeName)) return "#6c757d";
        var t = tubeName.ToLower();
        if (t.Contains("edta") || t.Contains("purple") || t.Contains("lavender")) return "#9333ea"; // Purple
        if (t.Contains("serum") || t.Contains("gel") || t.Contains("red") || t.Contains("clot")) return "#ef4444"; // Red
        if (t.Contains("citrate") || t.Contains("blue") || t.Contains("coag")) return "#3b82f6"; // Light Blue
        if (t.Contains("heparin") || t.Contains("green")) return "#10b981"; // Green
        if (t.Contains("glucose") || t.Contains("fluoride") || t.Contains("gray")) return "#6b7280"; // Gray
        if (t.Contains("urine") || t.Contains("yellow")) return "#eab308"; // Yellow
        return "#0284c7"; // Cyan
    }

    private static decimal ToDecimal(object? val)
    {
        if (val == null || val is DBNull) return 0m;
        if (val is decimal d) return d;
        if (decimal.TryParse(val.ToString(), out var parsed)) return parsed;
        return 0m;
    }

    private static string FormatDateTime(object? val, string format = "dd/MM/yyyy HH:mm")
    {
        if (val == null || val is DBNull) return "--";
        if (val is DateTime dt) return dt.ToString(format);
        if (DateTime.TryParse(val.ToString(), out var parsed)) return parsed.ToString(format);
        return "--";
    }

    private async Task PrintSilentReceipt()
    {
        if (SelectedOrderDetails == null) return;
        try
        {
            var invoice = SelectedOrderDetails.Invoice;
            var order = SelectedOrderDetails.Order;
            var patient = SelectedOrderDetails.Patient;
            var allTests = SelectedOrderDetails.Specimens.SelectMany(s => s.Tests).ToList();

            var settings = LabSettings ?? await LabSettingsService.GetSettingsAsync();

            var printData = new ReceiptPrintData
            {
                LabNameAr = settings.LabNameAr,
                LabNameEn = settings.LabNameEn,
                Address = settings.Address,
                Phones = settings.Phones,
                InvoiceNo = invoice?.InvoiceNo ?? order.Id,
                OrderId = order.Id,
                OrderDate = order.OrderDatetime,
                PatientNameAr = patient.FullNameAr,
                Mrn = patient.Mrn,
                PatientPhone = patient.Phone,
                Gender = patient.Sex == "F" ? "أنثى" : "ذكر",
                CashierName = "المحاسب (الكاشير)",
                PaymentMethod = CurrentReceiptPaymentMethod,
                TotalAmount = invoice?.Total ?? allTests.Sum(t => t.Price),
                Discount = invoice?.Discount ?? 0,
                NetAmount = invoice?.Net ?? allTests.Sum(t => t.Price),
                PaidAmount = invoice?.Paid ?? 0,
                BalanceDue = invoice?.Balance ?? 0,
                Currency = "IQD",
                Items = allTests.Select(t => new ReceiptItemData
                {
                    Code = t.TestCode,
                    Name = t.NameAr ?? t.TestCode,
                    Price = t.Price
                }).ToList()
            };

            var res = await PrintService.PrintReceiptDirectAsync(printData);
            if (res.Success)
            {
                DetailsAlertClass = "alert-success";
                DetailsAlertMessage = res.Message;
            }
            else
            {
                DetailsAlertClass = "alert-danger";
                DetailsAlertMessage = res.Message;
            }
        }
        catch (Exception ex)
        {
            DetailsAlertClass = "alert-danger";
            DetailsAlertMessage = $"فشل أمر الطباعة الصامتة للوصل: {ex.Message}";
        }
    }

