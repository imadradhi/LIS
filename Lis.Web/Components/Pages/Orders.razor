    private async Task PrintAllOrderTubesSilent()
    {
        if (LabelModalOrder == null) return;
        int printedCount = 0;
        foreach (var spec in LabelModalOrder.Specimens)
        {
            try
            {
                var patient = LabelModalOrder.Patient;
                var labelData = new SpecimenLabelData
                {
                    AccessionNo = (spec.Specimen.AccessionNo ?? "").ToString(),
                    Mrn = patient.Mrn,
                    PatientNameAr = patient.FullNameAr,
                    DateOfBirth = patient.DateOfBirth,
                    SpecimenTypeName = (spec.SpecimenTypeName ?? "Sample").ToString()
                };
                var res = await PrintService.PrintLabelDirectAsync(labelData);
                if (res.Success) printedCount++;
            }
            catch
            {
                // continue next
            }
        }
        LabelModalMessage = $"تم إرسال {printedCount} من أصل {LabelModalOrder.Specimens.Count} ملصق إلى طابعة الباركود بنجاح.";
    }

