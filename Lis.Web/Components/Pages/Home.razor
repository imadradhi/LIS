@page "/"
@inject IOrderService OrderService
@inject IBillingService BillingService
@inject NavigationManager NavManager
@inject UserPreferencesService Prefs
@implements IDisposable

<PageTitle>@Prefs.T("لوحة المؤشرات العامة - LIS Web", "General Dashboard - LIS Web")</PageTitle>

<!-- MEDLAB PAGE SUB-HEADER -->
<div class="medlab-page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div class="d-flex align-items-center gap-2">
        <span class="medlab-header-title">
            | @Prefs.T("لوحة المؤشرات والتحليلات المخبرية", "LABORATORY DASHBOARD & ANALYTICS")
        </span>
        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1 ms-2" style="font-size: 10px; font-weight: 700;">
            <i class="fas fa-microscope me-1"></i> LIS MEDLAB V2
        </span>
    </div>

    <!-- Header Actions & Live Clock -->
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <div class="d-flex align-items-center gap-1 bg-white border rounded px-2 py-1" style="border-color: var(--medlab-border) !important; height: 28px;">
            <i class="far fa-calendar-alt text-primary" style="font-size: 11px;"></i>
            <span class="fw-semibold text-muted" style="font-size: 11px;">@DateTime.Today.ToString("dd.MM.yyyy")</span>
        </div>

        <button class="btn btn-outline-secondary btn-sm" @onclick="ReloadData" title="@Prefs.T("تحديث البيانات", "Refresh Data")" style="height: 28px;">
            <i class="fas fa-sync-alt @(IsLoading ? "fa-spin text-primary" : "")"></i>
        </button>

        <a href="orders" class="btn btn-primary btn-sm px-3" style="height: 28px;">
            <i class="fas fa-plus me-1"></i> @Prefs.T("طلب جديد", "NEW ORDER")
        </a>
        <a href="worklist" class="btn btn-outline-primary btn-sm px-3" style="height: 28px;">
            <i class="fas fa-vial me-1"></i> @Prefs.T("قائمة العمل", "WORKLIST")
        </a>
        <a href="results" class="btn btn-outline-secondary btn-sm px-3" style="height: 28px;">
            <i class="fas fa-file-medical-alt me-1"></i> @Prefs.T("النتائج المخبرية", "LAB RESULTS")
        </a>
    </div>
</div>

<!-- TOP KPI SUMMARY TILES (5 Compact MedLab Clinical Cards) -->
<div class="row g-2 mb-3">
    <!-- Card 1: Today's Orders -->
    <div class="col-xl col-md-4 col-sm-6 col-12">
        <div class="medlab-kpi-card kpi-blue h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="medlab-kpi-label">@Prefs.T("طلبات اليوم", "TODAY'S ORDERS")</span>
                <div class="medlab-kpi-icon" style="background: rgba(11, 114, 185, 0.1); color: var(--medlab-blue);">
                    <i class="fas fa-file-medical"></i>
                </div>
            </div>
            <div class="medlab-kpi-value text-primary">@TodayOrdersCount</div>
            <div class="medlab-kpi-sub mt-2 d-flex align-items-center gap-1">
                <i class="fas fa-check text-success"></i>
                <span>@Prefs.T("مسجلة بالنظام اليوم", "Registered today")</span>
            </div>
        </div>
    </div>

    <!-- Card 2: In-Progress Samples -->
    <div class="col-xl col-md-4 col-sm-6 col-12">
        <div class="medlab-kpi-card kpi-amber h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="medlab-kpi-label">@Prefs.T("قيد التحليل والمعالجة", "SAMPLES IN PROCESS")</span>
                <div class="medlab-kpi-icon" style="background: rgba(245, 158, 11, 0.1); color: #F59E0B;">
                    <i class="fas fa-vial"></i>
                </div>
            </div>
            <div class="medlab-kpi-value" style="color: #D97706;">@InProgressCount</div>
            <div class="medlab-kpi-sub mt-2 d-flex align-items-center gap-1">
                <i class="fas fa-spinner fa-spin text-warning"></i>
                <span>@Prefs.T("جارية في أجهزة التحليل", "Active on analyzers")</span>
            </div>
        </div>
    </div>

    <!-- Card 3: Validated & Released -->
    <div class="col-xl col-md-4 col-sm-6 col-12">
        <div class="medlab-kpi-card kpi-green h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="medlab-kpi-label">@Prefs.T("نتائج معتمدة ومطلقة", "VALIDATED & RELEASED")</span>
                <div class="medlab-kpi-icon" style="background: rgba(16, 124, 65, 0.1); color: var(--medlab-green);">
                    <i class="fas fa-clipboard-check"></i>
                </div>
            </div>
            <div class="medlab-kpi-value text-success">@ValidatedCount</div>
            <div class="medlab-kpi-sub mt-2 d-flex align-items-center gap-1">
                <span class="badge bg-success bg-opacity-10 text-success fw-bold px-1" style="font-size: 10px;">
                    @(TodayOrdersCount > 0 ? (int)((double)ValidatedCount / TodayOrdersCount * 100) : 100)%
                </span>
                <span>@Prefs.T("نسبة الإنجاز اليومي", "Daily completion")</span>
            </div>
        </div>
    </div>

    <!-- Card 4: Critical / Panic Alerts -->
    <div class="col-xl col-md-6 col-sm-6 col-12">
        <div class="medlab-kpi-card kpi-red h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="medlab-kpi-label">@Prefs.T("تنبيهات حرجة (Panic)", "PANIC / CRITICAL")</span>
                <div class="medlab-kpi-icon" style="background: rgba(220, 38, 38, 0.1); color: var(--medlab-danger-red);">
                    <i class="fas fa-heart-pulse"></i>
                </div>
            </div>
            <div class="medlab-kpi-value text-danger">0</div>
            <div class="medlab-kpi-sub mt-2 d-flex align-items-center gap-1">
                <i class="fas fa-shield-alt text-success"></i>
                <span class="text-success fw-semibold">@Prefs.T("لا توجد قيم حرجة غير معالجة", "All within safe margins")</span>
            </div>
        </div>
    </div>

    <!-- Card 5: Daily Revenue -->
    <div class="col-xl col-md-6 col-sm-12 col-12">
        <div class="medlab-kpi-card kpi-navy h-100">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="medlab-kpi-label">@Prefs.T("إيراد الصندوق اليوم", "DAILY CASHIER")</span>
                <div class="medlab-kpi-icon" style="background: rgba(0, 62, 107, 0.1); color: var(--medlab-navy);">
                    <i class="fas fa-cash-register"></i>
                </div>
            </div>
            <div class="medlab-kpi-value text-medlab-navy">
                @TotalIncome.ToString("N0") <span style="font-size: 12px; font-weight: 600;" class="text-muted">IQD</span>
            </div>
            <div class="medlab-kpi-sub mt-2 d-flex align-items-center gap-1">
                <i class="fas fa-receipt text-primary"></i>
                <span>@Prefs.T("صافي المقبوضات النقدية", "Net cash collected")</span>
            </div>
        </div>
    </div>
</div>

<!-- WORKFLOW PIPELINE RIBBON -->
<div class="medlab-pipeline-container d-none d-md-block">
    <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
        <!-- Step 1: Ordered -->
        <div class="medlab-step @(TodayOrdersCount > 0 ? "active" : "")">
            <div class="medlab-step-num">1</div>
            <div>
                <div class="medlab-step-title">@Prefs.T("مسجل بالاستقبال", "1. ORDERED")</div>
                <div class="medlab-step-count">@(RecentOrders?.Count(o => (string)o.status == "Ordered") ?? 0)</div>
            </div>
        </div>

        <i class="fas fa-chevron-right text-muted opacity-50"></i>

        <!-- Step 2: Collected -->
        <div class="medlab-step active">
            <div class="medlab-step-num">2</div>
            <div>
                <div class="medlab-step-title">@Prefs.T("تم سحب العينات", "2. COLLECTED")</div>
                <div class="medlab-step-count">@(RecentOrders?.Count(o => (string)o.status == "Collected") ?? 0)</div>
            </div>
        </div>

        <i class="fas fa-chevron-right text-muted opacity-50"></i>

        <!-- Step 3: In Progress -->
        <div class="medlab-step active">
            <div class="medlab-step-num">3</div>
            <div>
                <div class="medlab-step-title">@Prefs.T("قيد التحليل بالأجهزة", "3. IN-PROCESS")</div>
                <div class="medlab-step-count">@(RecentOrders?.Count(o => (string)o.status == "InProgress") ?? 0)</div>
            </div>
        </div>

        <i class="fas fa-chevron-right text-muted opacity-50"></i>

        <!-- Step 4: Results In -->
        <div class="medlab-step active">
            <div class="medlab-step-num">4</div>
            <div>
                <div class="medlab-step-title">@Prefs.T("وارد من الأجهزة", "4. RESULTS IN")</div>
                <div class="medlab-step-count">@(RecentOrders?.Count(o => (string)o.status == "ResultReceived") ?? 0)</div>
            </div>
        </div>

        <i class="fas fa-chevron-right text-muted opacity-50"></i>

        <!-- Step 5: Validated -->
        <div class="medlab-step active">
            <div class="medlab-step-num">5</div>
            <div>
                <div class="medlab-step-title">@Prefs.T("معتمد ومسلّم", "5. VALIDATED")</div>
                <div class="medlab-step-count text-success">@ValidatedCount</div>
            </div>
        </div>
    </div>
</div>

<!-- MAIN TWO-COLUMN CLINICAL DASHBOARD LAYOUT -->
<div class="row g-3">
    <!-- LEFT COLUMN: SAMPLES ACTIVITY TABLE & ANALYZER TELEMETRY (8 Cols) -->
    <div class="col-xl-8 col-lg-7 col-12">
        <!-- Card 1: Recent Orders & Samples -->
        <div class="medlab-context-card mb-3">
            <div class="medlab-card-navy-header d-flex justify-content-between align-items-center">
                <span class="d-flex align-items-center gap-2">
                    <i class="fas fa-list-check"></i>
                    <span>@Prefs.T("أحدث عينات وطلبات اليوم", "TODAY'S LABORATORY SAMPLES & ORDERS")</span>
                </span>
                <a href="orders" class="text-white text-decoration-none small fw-semibold">
                    @Prefs.T("عرض كل الطلبات", "VIEW ALL") <i class="fas fa-arrow-right ms-1"></i>
                </a>
            </div>

            @if (IsLoading)
            {
                <div class="text-center py-4 text-muted">
                    <div class="spinner-border spinner-border-sm text-primary mb-2" role="status"></div>
                    <div>@Prefs.T("جاري تحديث بيانات المختبر...", "Loading laboratory feed...")</div>
                </div>
            }
            else if (RecentOrders == null || !RecentOrders.Any())
            {
                <div class="p-4 text-center text-muted">
                    <i class="fas fa-vial fa-2x mb-2 text-primary opacity-50"></i>
                    <div>@Prefs.T("لم يتم تسجيل أي طلبات للمختبر حتى الآن اليوم.", "No laboratory orders registered yet today.")</div>
                    <a href="orders" class="btn btn-primary btn-sm mt-2">
                        <i class="fas fa-plus me-1"></i> @Prefs.T("تسجيل أول طلب", "Create First Order")
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="medlab-table mb-0">
                        <thead>
                            <tr>
                                <th style="width: 80px;">@Prefs.T("الطلب", "ORDER #")</th>
                                <th style="width: 90px;">@Prefs.T("الوقت", "TIME")</th>
                                <th>@Prefs.T("اسم المريض", "PATIENT NAME")</th>
                                <th style="width: 100px;">@Prefs.T("الملف", "MRN")</th>
                                <th style="width: 110px;">@Prefs.T("الهاتف", "PHONE")</th>
                                <th style="width: 120px;" class="text-center">@Prefs.T("الحالة", "STATUS")</th>
                                <th style="width: 100px;" class="text-end">@Prefs.T("المبلغ", "AMOUNT")</th>
                                <th style="width: 60px;" class="text-center">@Prefs.T("تقرير", "VIEW")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in RecentOrders.Take(9))
                            {
                                long id = Convert.ToInt64(order.id);
                                string fullName = order.full_name_ar?.ToString() ?? "";
                                string mrn = order.mrn?.ToString() ?? "";
                                string phone = order.phone?.ToString() ?? "--";
                                string status = order.status?.ToString() ?? "";
                                var total = ToDecimal(order.total_amount);
                                <tr>
                                    <td>
                                        <a href="results?orderId=@id" class="fw-bold text-primary text-decoration-none font-monospace">
                                            #@id
                                        </a>
                                    </td>
                                    <td class="font-monospace text-muted" style="font-size: 11px;">
                                        @FormatDateTime(order.order_datetime, "HH:mm")
                                    </td>
                                    <td class="fw-bold text-medlab-navy">
                                        @fullName
                                    </td>
                                    <td class="font-monospace text-secondary" style="font-size: 11px;">
                                        @mrn
                                    </td>
                                    <td class="font-monospace text-muted" style="font-size: 11px;">
                                        @phone
                                    </td>
                                    <td class="text-center">
                                        <span class="badge-status @GetStatusClass(status)">
                                            @GetStatusDisplay(status)
                                        </span>
                                    </td>
                                    <td class="fw-bold text-end font-monospace text-medlab-navy">
                                        @total.ToString("N0")
                                    </td>
                                    <td class="text-center">
                                        <a href="results?orderId=@id" class="btn btn-outline-primary btn-sm py-0 px-2" title="@Prefs.T("عرض النتائج", "View Findings")" style="font-size: 10.5px; height: 24px; line-height: 22px;">
                                            <i class="fas fa-microscope"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Card 2: Connected Analyzers & Middleware Telemetry -->
        <div class="medlab-context-card">
            <div class="medlab-card-navy-header d-flex justify-content-between align-items-center">
                <span class="d-flex align-items-center gap-2">
                    <i class="fas fa-network-wired"></i>
                    <span>@Prefs.T("حالة الربط المباشر مع الأجهزة المخبرية", "ANALYZER CONNECTIVITY & MIDDLEWARE")</span>
                </span>
                <span class="badge bg-success bg-opacity-25 text-white" style="font-size: 10px;">
                    <i class="fas fa-signal me-1"></i> 3 / 3 ONLINE
                </span>
            </div>
            <div class="medlab-card-body p-2">
                <div class="row g-2">
                    <!-- Analyzer 1: Siemens Dimension EXL 200 -->
                    <div class="col-md-4 col-12">
                        <div class="border rounded p-2 bg-light bg-opacity-50" style="border-color: var(--medlab-border) !important;">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="fw-bold text-medlab-navy" style="font-size: 11.5px;">Siemens Dimension EXL</span>
                                <span class="medlab-pulse-dot online" title="Connected / Online"></span>
                            </div>
                            <div class="text-muted" style="font-size: 10.5px;">Clinical Chemistry &amp; Immunoassay</div>
                            <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top" style="font-size: 10.5px;">
                                <span class="font-monospace text-muted">ASTM 1394-91 / COM1</span>
                                <span class="badge bg-success bg-opacity-10 text-success fw-bold">ONLINE</span>
                            </div>
                        </div>
                    </div>

                    <!-- Analyzer 2: Sysmex XN-550 -->
                    <div class="col-md-4 col-12">
                        <div class="border rounded p-2 bg-light bg-opacity-50" style="border-color: var(--medlab-border) !important;">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="fw-bold text-medlab-navy" style="font-size: 11.5px;">Sysmex XN-550</span>
                                <span class="medlab-pulse-dot online" title="Connected / Online"></span>
                            </div>
                            <div class="text-muted" style="font-size: 10.5px;">Automated Hematology 5-Part Diff</div>
                            <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top" style="font-size: 10.5px;">
                                <span class="font-monospace text-muted">HL7 v2.5 / 192.168.1.50</span>
                                <span class="badge bg-success bg-opacity-10 text-success fw-bold">ONLINE</span>
                            </div>
                        </div>
                    </div>

                    <!-- Analyzer 3: Roche Cobas e411 -->
                    <div class="col-md-4 col-12">
                        <div class="border rounded p-2 bg-light bg-opacity-50" style="border-color: var(--medlab-border) !important;">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="fw-bold text-medlab-navy" style="font-size: 11.5px;">Roche Cobas e411</span>
                                <span class="medlab-pulse-dot online" title="Connected / Online"></span>
                            </div>
                            <div class="text-muted" style="font-size: 10.5px;">Immunology &amp; Hormones</div>
                            <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top" style="font-size: 10.5px;">
                                <span class="font-monospace text-muted">ASTM E1381 / COM3</span>
                                <span class="badge bg-success bg-opacity-10 text-success fw-bold">ONLINE</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- RIGHT COLUMN: CLINICAL CONTEXT PANELS (4 Cols) -->
    <div class="col-xl-4 col-lg-5 col-12">
        <!-- Panel 1: Department Specimen Distribution -->
        <div class="medlab-context-card">
            <div class="medlab-card-navy-header d-flex justify-content-between align-items-center">
                <span>@Prefs.T("توزيع العينات حسب القسم", "DEPARTMENT SPECIMENS")</span>
                <i class="fas fa-chart-pie"></i>
            </div>
            <div class="medlab-card-body">
                <!-- Hematology EDTA -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1" style="font-size: 11px;">
                        <span class="d-flex align-items-center gap-1 fw-semibold text-medlab-navy">
                            <span class="tube-indicator tube-edta"></span>
                            <span>@Prefs.T("أمراض الدم (CBC / EDTA)", "Hematology (EDTA)")</span>
                        </span>
                        <span class="fw-bold font-monospace">42%</span>
                    </div>
                    <div class="progress" style="height: 6px; background-color: #EDE9FE;">
                        <div class="progress-bar" role="progressbar" style="width: 42%; background-color: #8B5CF6;"></div>
                    </div>
                </div>

                <!-- Chemistry Serum -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1" style="font-size: 11px;">
                        <span class="d-flex align-items-center gap-1 fw-semibold text-medlab-navy">
                            <span class="tube-indicator tube-serum"></span>
                            <span>@Prefs.T("الكيمياء السريرية (Serum)", "Clinical Chemistry (Serum)")</span>
                        </span>
                        <span class="fw-bold font-monospace">38%</span>
                    </div>
                    <div class="progress" style="height: 6px; background-color: #FEE2E2;">
                        <div class="progress-bar" role="progressbar" style="width: 38%; background-color: #EF4444;"></div>
                    </div>
                </div>

                <!-- Coagulation Citrate -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1" style="font-size: 11px;">
                        <span class="d-flex align-items-center gap-1 fw-semibold text-medlab-navy">
                            <span class="tube-indicator tube-citrate"></span>
                            <span>@Prefs.T("التخثر والتجلط (Citrate)", "Coagulation (Citrate)")</span>
                        </span>
                        <span class="fw-bold font-monospace">12%</span>
                    </div>
                    <div class="progress" style="height: 6px; background-color: #E0F2FE;">
                        <div class="progress-bar" role="progressbar" style="width: 12%; background-color: #38BDF8;"></div>
                    </div>
                </div>

                <!-- Urinalysis & Body Fluids -->
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-1" style="font-size: 11px;">
                        <span class="d-flex align-items-center gap-1 fw-semibold text-medlab-navy">
                            <span class="tube-indicator tube-urine"></span>
                            <span>@Prefs.T("فحص الإدرار والسوائل", "Urinalysis & Fluids")</span>
                        </span>
                        <span class="fw-bold font-monospace">8%</span>
                    </div>
                    <div class="progress" style="height: 6px; background-color: #FEF3C7;">
                        <div class="progress-bar" role="progressbar" style="width: 8%; background-color: #FBBF24;"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Panel 2: Daily QC & Compliance -->
        <div class="medlab-context-card">
            <div class="medlab-card-navy-header d-flex justify-content-between align-items-center">
                <span>@Prefs.T("مراقبة الجودة وضبط الدقة (QC)", "DAILY QC & COMPLIANCE")</span>
                <i class="fas fa-check-double"></i>
            </div>
            <div class="medlab-card-body">
                <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom">
                    <div>
                        <div class="fw-bold text-medlab-navy" style="font-size: 11.5px;">@Prefs.T("قواعد ويستغارد (Westgard Rules)", "Westgard Rules Verification")</div>
                        <div class="text-muted" style="font-size: 10.5px;">Level 1 &amp; Level 2 Controls</div>
                    </div>
                    <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2 py-1">
                        <i class="fas fa-check-circle me-1"></i> PASSED
                    </span>
                </div>

                <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom">
                    <div>
                        <div class="fw-bold text-medlab-navy" style="font-size: 11.5px;">@Prefs.T("معايرة أجهزة السحب (Calibration)", "Analyzer Calibration")</div>
                        <div class="text-muted" style="font-size: 10.5px;">@Prefs.T("تم التحقق اليوم 08:00 ص", "Verified Today 08:00 AM")</div>
                    </div>
                    <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-2 py-1">
                        VALID
                    </span>
                </div>

                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="fw-bold text-medlab-navy" style="font-size: 11.5px;">@Prefs.T("تنبيهات الصيانة الدورية", "Preventive Maintenance")</div>
