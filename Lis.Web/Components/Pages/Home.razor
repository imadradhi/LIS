@page "/"
@inject IOrderService OrderService
@inject IBillingService BillingService
@inject NavigationManager NavManager
@inject UserPreferencesService Prefs
@implements IDisposable

<PageTitle>@Prefs.T("لوحة المؤشرات العامة - LIS Web", "General Dashboard - LIS Web")</PageTitle>

<!-- MDB HERO RIBBON HEADER (as in Image 2) -->
<div class="mdb-hero-ribbon d-flex justify-content-between align-items-start">
    <div class="text-white d-none d-md-block">
        <span class="badge bg-white bg-opacity-25 text-white mb-2 px-2 py-1" style="font-size: 11px;">
            <i class="fas fa-shield-alt me-1"></i> LIS Enterprise Edition
        </span>
    </div>
</div>

<!-- FLOATING DASHBOARD HEADER CARD (as in Image 2) -->
<div class="mdb-dashboard-header-card">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <!-- Title & Breadcrumbs -->
        <div>
            <h2 class="fw-bold mb-1" style="letter-spacing: -0.5px;">
                @Prefs.T("لوحة المؤشرات العامة", "General Dashboard")
                <span class="fs-5 text-secondary fw-normal ms-2">| @Prefs.T("نظرة إحصائية شاملة", "Overview & Analytics")</span>
            </h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small text-muted">
                    <li class="breadcrumb-item"><a href="" class="text-decoration-none text-muted">Home</a></li>
                    <li class="breadcrumb-item"><a href="" class="text-decoration-none text-muted">Analytics</a></li>
                    <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">General</li>
                </ol>
            </nav>
        </div>

        <!-- Header Actions: Customize, Export, Date Filters (as in Image 2) -->
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <button class="btn btn-outline-secondary btn-sm px-3 shadow-0" type="button" data-mdb-ripple-init>
                <i class="fas fa-sliders-h me-1 text-primary"></i> @Prefs.T("تخصيص", "CUSTOMIZE")
            </button>
            <button class="btn btn-outline-secondary btn-sm px-3 shadow-0" type="button" data-mdb-ripple-init>
                <i class="fas fa-download me-1 text-primary"></i> @Prefs.T("تصدير", "EXPORT")
            </button>

            <!-- Date Range Selectors -->
            <div class="d-flex align-items-center gap-1 bg-light border rounded px-2 py-1 ms-1" style="background: var(--bg-card-hover) !important; border-color: var(--border-color) !important;">
                <div class="text-muted small me-1" style="font-size: 11px;">Date</div>
                <select class="form-select form-select-sm border-0 bg-transparent py-0 ps-1 pe-3 shadow-none fw-semibold" style="font-size: 12.5px; width: auto;">
                    <option value="7">@Prefs.T("آخر 7 أيام", "Last 7 days")</option>
                    <option value="1">@Prefs.T("اليوم", "Today")</option>
                    <option value="30">@Prefs.T("آخر 30 يوم", "Last 30 days")</option>
                </select>
            </div>

            <div class="d-flex align-items-center gap-1 bg-light border rounded px-2 py-1" style="background: var(--bg-card-hover) !important; border-color: var(--border-color) !important;">
                <div class="text-muted small me-1" style="font-size: 11px;">Date</div>
                <span class="small fw-semibold me-1" style="font-size: 12px;">@DateTime.Today.ToString("dd/MM/yyyy")</span>
                <i class="far fa-calendar-alt text-muted small"></i>
            </div>
        </div>
    </div>
</div>

<!-- TOP ANALYTICS ROW: 2 LARGE CARDS (Matches Image 2 exactly) -->
<div class="row g-4 mb-4">
    <!-- CARD 1: Users & Sessions (حجم الفحوصات والعينات) -->
    <div class="col-xl-6 col-12">
        <div class="mdb-analytics-card h-100">
            <h6 class="text-center text-muted fw-bold mb-3" style="font-size: 13.5px; letter-spacing: 0.5px;">
                Users &amp; Sessions | حركة العينات والفحوصات
            </h6>

            <!-- 3 Metric Columns with Trend Badges -->
            <div class="row text-center mb-4 g-2">
                <div class="col-4 border-end border-secondary border-opacity-25">
                    <small class="text-muted d-block mb-1" style="font-size: 12px;">Users (الفحوصات)</small>
                    <h3 class="fw-bold mb-1">38.6K</h3>
                    <span class="trend-pill trend-up">
                        <i class="fas fa-caret-up"></i> 72.0%
                    </span>
                </div>
                <div class="col-4 border-end border-secondary border-opacity-25">
                    <small class="text-muted d-block mb-1" style="font-size: 12px;">Sessions (العينات)</small>
                    <h3 class="fw-bold mb-1">50.9K</h3>
                    <span class="trend-pill trend-up">
                        <i class="fas fa-caret-up"></i> 82.0%
                    </span>
                </div>
                <div class="col-4">
                    <small class="text-muted d-block mb-1" style="font-size: 12px;">New Users (طلبات جديدة)</small>
                    <h3 class="fw-bold mb-1">34.0K</h3>
                    <span class="trend-pill trend-down">
                        <i class="fas fa-caret-down"></i> 12.0%
                    </span>
                </div>
            </div>

            <!-- Chart Legends -->
            <div class="d-flex justify-content-center gap-3 mb-2 small text-muted">
                <span class="d-flex align-items-center gap-1">
                    <span style="width: 14px; height: 3px; background: #2563EB; display: inline-block;"></span> Users (الفحوصات)
                </span>
                <span class="d-flex align-items-center gap-1">
                    <span style="width: 14px; height: 3px; background: #00B4D8; display: inline-block;"></span> Sessions (العينات)
                </span>
            </div>

            <!-- Multi-line SVG Wave Chart (Smooth Bezier Curves matching Image 2) -->
            <div class="svg-chart-container">
                <svg viewBox="0 0 600 240" preserveAspectRatio="none">
                    <defs>
                        <linearGradient id="blueWaveGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                            <stop offset="0%" stop-color="#2563EB" stop-opacity="0.25" />
                            <stop offset="100%" stop-color="#2563EB" stop-opacity="0.0" />
                        </linearGradient>
                        <linearGradient id="cyanWaveGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                            <stop offset="0%" stop-color="#00B4D8" stop-opacity="0.2" />
                            <stop offset="100%" stop-color="#00B4D8" stop-opacity="0.0" />
                        </linearGradient>
                    </defs>
                    <!-- Grid Lines & Axis Values -->
                    <line x1="40" y1="20" x2="580" y2="20" stroke="#888888" stroke-dasharray="3,3" stroke-opacity="0.2" />
                    <text x="30" y="24" fill="#888888" font-size="10" text-anchor="end">950</text>
                    <line x1="40" y1="70" x2="580" y2="70" stroke="#888888" stroke-dasharray="3,3" stroke-opacity="0.2" />
                    <text x="30" y="74" fill="#888888" font-size="10" text-anchor="end">900</text>
                    <line x1="40" y1="120" x2="580" y2="120" stroke="#888888" stroke-dasharray="3,3" stroke-opacity="0.2" />
                    <text x="30" y="124" fill="#888888" font-size="10" text-anchor="end">850</text>
                    <line x1="40" y1="170" x2="580" y2="170" stroke="#888888" stroke-dasharray="3,3" stroke-opacity="0.2" />
                    <text x="30" y="174" fill="#888888" font-size="10" text-anchor="end">800</text>
                    <line x1="40" y1="210" x2="580" y2="210" stroke="#888888" stroke-opacity="0.3" />

                    <!-- Area Fills -->
                    <path d="M 50 180 Q 120 160 200 80 T 320 80 T 420 140 T 520 150 T 570 200 L 570 210 L 50 210 Z" fill="url(#blueWaveGrad)" />
                    
                    <!-- Line 1: Users (Deep Blue with squares/dots) -->
                    <path d="M 50 180 Q 120 160 200 80 T 320 80 T 420 140 T 520 150 T 570 200" fill="none" stroke="#2563EB" stroke-width="2.5" />
                    <circle cx="50" cy="180" r="3.5" fill="#2563EB" />
                    <rect x="196" y="76" width="7" height="7" fill="#2563EB" />
                    <rect x="316" y="76" width="7" height="7" fill="#2563EB" />
                    <circle cx="420" cy="140" r="3.5" fill="#2563EB" />
                    <circle cx="520" cy="150" r="3.5" fill="#2563EB" />
                    <circle cx="570" cy="200" r="3.5" fill="#2563EB" />

                    <!-- Line 2: Sessions (Cyan with dots) -->
                    <path d="M 50 160 Q 120 190 200 130 T 320 120 T 420 180 T 520 160 T 570 170" fill="none" stroke="#00B4D8" stroke-width="2" />
                    <circle cx="50" cy="160" r="3" fill="#00B4D8" />
                    <circle cx="200" cy="130" r="3" fill="#00B4D8" />
                    <circle cx="320" cy="120" r="3" fill="#00B4D8" />
                    <circle cx="420" cy="180" r="3" fill="#00B4D8" />
                    <circle cx="520" cy="160" r="3" fill="#00B4D8" />
                    <circle cx="570" cy="170" r="3" fill="#00B4D8" />

                    <!-- X-Axis Labels -->
                    <text x="50" y="230" fill="#888888" font-size="10" text-anchor="middle">20 Sep</text>
                    <text x="150" y="230" fill="#888888" font-size="10" text-anchor="middle">21 Sep</text>
                    <text x="250" y="230" fill="#888888" font-size="10" text-anchor="middle">22 Sep</text>
                    <text x="350" y="230" fill="#888888" font-size="10" text-anchor="middle">23 Sep</text>
                    <text x="450" y="230" fill="#888888" font-size="10" text-anchor="middle">24 Sep</text>
                    <text x="550" y="230" fill="#888888" font-size="10" text-anchor="middle">25 Sep</text>
                </svg>
            </div>
        </div>
    </div>

    <!-- CARD 2: Revenue & Conversion Rate (الإيرادات والتحصيل المالي) -->
    <div class="col-xl-6 col-12">
        <div class="mdb-analytics-card h-100">
            <h6 class="text-center text-muted fw-bold mb-3" style="font-size: 13.5px; letter-spacing: 0.5px;">
                Revenue &amp; Conversion Rate | الإيرادات ونسبة التحصيل
            </h6>

            <!-- 3 Metric Columns with Trend Badges -->
            <div class="row text-center mb-4 g-2">
                <div class="col-4 border-end border-secondary border-opacity-25">
                    <small class="text-muted d-block mb-1" style="font-size: 12px;">Revenue (الإيرادات)</small>
                    <h3 class="fw-bold mb-1 text-primary">@TotalIncome.ToString("N0") IQD</h3>
                    <span class="trend-pill trend-up">
                        <i class="fas fa-caret-up"></i> 21.6%
                    </span>
                </div>
                <div class="col-4 border-end border-secondary border-opacity-25">
                    <small class="text-muted d-block mb-1" style="font-size: 12px;">Transactions (الطلبات)</small>
                    <h3 class="fw-bold mb-1">@(TodayOrdersCount > 0 ? TodayOrdersCount : 88)</h3>
                    <span class="trend-pill trend-down">
                        <i class="fas fa-caret-down"></i> 22.8%
                    </span>
                </div>
                <div class="col-4">
                    <small class="text-muted d-block mb-1" style="font-size: 12px;">Conversion (التحصيل)</small>
                    <h3 class="fw-bold mb-1">98.2%</h3>
                    <span class="trend-pill trend-down">
                        <i class="fas fa-caret-down"></i> 1.7%
                    </span>
                </div>
            </div>

            <!-- Chart Legends -->
            <div class="d-flex justify-content-center gap-3 mb-2 small text-muted">
                <span class="d-flex align-items-center gap-1">
                    <span style="width: 14px; height: 3px; background: #10B981; display: inline-block;"></span> Conversion rate (%)
                </span>
                <span class="d-flex align-items-center gap-1">
                    <span style="width: 14px; height: 3px; background: #6366F1; display: inline-block;"></span> Transactions
                </span>
            </div>

            <!-- Dual-axis Chart (Wave Curve + Transaction Steps) -->
            <div class="svg-chart-container">
                <svg viewBox="0 0 600 240" preserveAspectRatio="none">
                    <defs>
                        <linearGradient id="greenWaveGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                            <stop offset="0%" stop-color="#10B981" stop-opacity="0.2" />
                            <stop offset="100%" stop-color="#10B981" stop-opacity="0.0" />
                        </linearGradient>
                    </defs>
                    <!-- Grid Lines & Axis Values -->
                    <line x1="40" y1="20" x2="580" y2="20" stroke="#888888" stroke-dasharray="3,3" stroke-opacity="0.2" />
                    <text x="30" y="24" fill="#888888" font-size="10" text-anchor="end">40K</text>
                    <text x="590" y="24" fill="#888888" font-size="10" text-anchor="start">4.0</text>

                    <line x1="40" y1="70" x2="580" y2="70" stroke="#888888" stroke-dasharray="3,3" stroke-opacity="0.2" />
                    <text x="30" y="74" fill="#888888" font-size="10" text-anchor="end">30K</text>
                    <text x="590" y="74" fill="#888888" font-size="10" text-anchor="start">3.0</text>

                    <line x1="40" y1="120" x2="580" y2="120" stroke="#888888" stroke-dasharray="3,3" stroke-opacity="0.2" />
                    <text x="30" y="124" fill="#888888" font-size="10" text-anchor="end">20K</text>
                    <text x="590" y="124" fill="#888888" font-size="10" text-anchor="start">2.0</text>

                    <line x1="40" y1="170" x2="580" y2="170" stroke="#888888" stroke-dasharray="3,3" stroke-opacity="0.2" />
                    <text x="30" y="174" fill="#888888" font-size="10" text-anchor="end">10K</text>
                    <text x="590" y="174" fill="#888888" font-size="10" text-anchor="start">1.0</text>

                    <line x1="40" y1="210" x2="580" y2="210" stroke="#888888" stroke-opacity="0.3" />

                    <!-- Line 1: Transactions (Indigo Line with Diamond Points) -->
                    <path d="M 50 140 L 150 120 L 250 40 L 350 110 L 450 130 L 550 200" fill="none" stroke="#6366F1" stroke-width="2.5" />
                    <polygon points="50,136 54,140 50,144 46,140" fill="#6366F1" />
                    <polygon points="150,116 154,120 150,124 146,120" fill="#6366F1" />
                    <polygon points="250,36 254,40 250,44 246,40" fill="#6366F1" />
                    <polygon points="350,106 354,110 350,114 346,110" fill="#6366F1" />
                    <polygon points="450,126 454,130 450,134 446,130" fill="#6366F1" />
                    <polygon points="550,196 554,200 550,204 546,200" fill="#6366F1" />

                    <!-- Line 2: Conversion (Emerald Line with Area) -->
                    <path d="M 50 190 Q 150 160 250 170 T 350 80 T 450 160 T 550 70" fill="none" stroke="#10B981" stroke-width="2" />
                    <circle cx="50" cy="190" r="3" fill="#10B981" />
                    <circle cx="150" cy="165" r="3" fill="#10B981" />
                    <circle cx="250" cy="170" r="3" fill="#10B981" />
                    <circle cx="350" cy="80" r="3" fill="#10B981" />
                    <circle cx="450" cy="160" r="3" fill="#10B981" />
                    <circle cx="550" cy="70" r="3" fill="#10B981" />

                    <!-- X-Axis Labels -->
                    <text x="50" y="230" fill="#888888" font-size="10" text-anchor="middle">20 Sep</text>
                    <text x="150" y="230" fill="#888888" font-size="10" text-anchor="middle">21 Sep</text>
                    <text x="250" y="230" fill="#888888" font-size="10" text-anchor="middle">22 Sep</text>
                    <text x="350" y="230" fill="#888888" font-size="10" text-anchor="middle">23 Sep</text>
                    <text x="450" y="230" fill="#888888" font-size="10" text-anchor="middle">24 Sep</text>
                    <text x="550" y="230" fill="#888888" font-size="10" text-anchor="middle">25 Sep</text>
                </svg>
            </div>
        </div>
    </div>
</div>

<!-- BOTTOM ROW: 3 METRIC CARDS WITH CHARTS (Matches Image 1: Total Shipments, Tasks, Daily Sales) -->
<div class="row g-4 mb-4">
    <!-- Card 1: Total Shipments (توزيع عينات الأقسام) -->
    <div class="col-xl-4 col-md-6 col-12">
        <div class="mdb-analytics-card h-100">
            <small class="text-muted d-block" style="font-size: 12px;">Total Specimens (توزيع العينات)</small>
            <div class="d-flex align-items-baseline gap-2 mb-3">
                <i class="fas fa-vial text-info fs-5"></i>
                <h2 class="fw-bold mb-0">@(TodayOrdersCount > 0 ? TodayOrdersCount : 354)</h2>
                <small class="text-muted">عينة فحص</small>
            </div>

            <!-- Horizontal Outlined Bar Chart (matching Image 1: pink, orange, yellow, cyan) -->
            <div class="py-2">
                <div class="d-flex align-items-center mb-2">
                    <span class="small text-muted font-monospace me-2" style="width: 32px; font-size: 11px;">EDTA</span>
                    <div class="flex-grow-1" style="height: 18px; border: 1.5px solid #EC4899; border-radius: 4px; background: rgba(236,72,153,0.1); width: 85%;"></div>
                </div>
                <div class="d-flex align-items-center mb-2">
                    <span class="small text-muted font-monospace me-2" style="width: 32px; font-size: 11px;">SERUM</span>
                    <div class="flex-grow-1" style="height: 18px; border: 1.5px solid #F97316; border-radius: 4px; background: rgba(249,115,22,0.1); width: 70%;"></div>
                </div>
                <div class="d-flex align-items-center mb-2">
                    <span class="small text-muted font-monospace me-2" style="width: 32px; font-size: 11px;">CITRA</span>
                    <div class="flex-grow-1" style="height: 18px; border: 1.5px solid #EAB308; border-radius: 4px; background: rgba(234,179,8,0.1); width: 55%;"></div>
                </div>
                <div class="d-flex align-items-center">
                    <span class="small text-muted font-monospace me-2" style="width: 32px; font-size: 11px;">URINE</span>
                    <div class="flex-grow-1" style="height: 18px; border: 1.5px solid #06B6D4; border-radius: 4px; background: rgba(6,182,212,0.1); width: 80%;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 2: Completed Tasks (النتائج المعتمدة) -->
    <div class="col-xl-4 col-md-6 col-12">
        <div class="mdb-analytics-card h-100">
            <small class="text-muted d-block" style="font-size: 12px;">Validated Results (النتائج المعتمدة)</small>
            <div class="d-flex align-items-baseline gap-2 mb-3">
                <i class="fas fa-check-double text-success fs-5"></i>
                <h2 class="fw-bold mb-0 text-success">@ValidatedCount</h2>
                <small class="text-muted">نتيجة معتمدة وجاهزة</small>
            </div>

            <!-- Bell Curve Wave Chart (matching Image 1) -->
            <div class="svg-chart-container" style="height: 100px;">
                <svg viewBox="0 0 300 100" preserveAspectRatio="none">
                    <defs>
                        <linearGradient id="bellGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                            <stop offset="0%" stop-color="#3B82F6" stop-opacity="0.3" />
                            <stop offset="100%" stop-color="#3B82F6" stop-opacity="0.0" />
                        </linearGradient>
                    </defs>
                    <line x1="10" y1="90" x2="290" y2="90" stroke="#888888" stroke-opacity="0.3" />
                    <path d="M 10 90 Q 70 90 90 75 T 120 90 Q 150 90 180 30 T 240 90 L 290 90 L 290 90 Z" fill="url(#bellGrad)" />
                    <path d="M 10 90 Q 70 90 90 75 T 120 90 Q 150 90 180 30 T 240 90 L 290 90" fill="none" stroke="#3B82F6" stroke-width="2.5" />
                    <circle cx="90" cy="75" r="4" fill="#3B82F6" />
                    <circle cx="180" cy="30" r="4" fill="#3B82F6" />
                </svg>
            </div>
        </div>
    </div>

    <!-- Card 3: Daily Sales (المبيعات النقدية اليومية) -->
    <div class="col-xl-4 col-12">
        <div class="mdb-analytics-card h-100">
            <small class="text-muted d-block" style="font-size: 12px;">Daily Cashier Sales (دخل الصندوق اليومي)</small>
            <div class="d-flex align-items-baseline gap-2 mb-3">
                <i class="fas fa-cash-register text-primary fs-5"></i>
                <h2 class="fw-bold mb-0 text-primary">@TotalIncome.ToString("N0")</h2>
                <small class="text-muted">د.ع</small>
            </div>

            <!-- Vertical Bars Chart (matching Image 1) -->
            <div class="d-flex align-items-end justify-content-between px-2 pt-2" style="height: 100px;">
                <div class="text-center" style="width: 14%;">
                    <div style="height: 35px; border: 1.5px solid #00B4D8; background: rgba(0,180,216,0.15); border-radius: 4px;"></div>
                    <small class="text-muted font-monospace" style="font-size: 10px;">Sun</small>
                </div>
                <div class="text-center" style="width: 14%;">
                    <div style="height: 55px; border: 1.5px solid #00B4D8; background: rgba(0,180,216,0.15); border-radius: 4px;"></div>
                    <small class="text-muted font-monospace" style="font-size: 10px;">Mon</small>
                </div>
                <div class="text-center" style="width: 14%;">
                    <div style="height: 45px; border: 1.5px solid #00B4D8; background: rgba(0,180,216,0.15); border-radius: 4px;"></div>
                    <small class="text-muted font-monospace" style="font-size: 10px;">Tue</small>
                </div>
                <div class="text-center" style="width: 14%;">
                    <div style="height: 85px; border: 1.5px solid #2563EB; background: rgba(37,99,235,0.3); border-radius: 4px;"></div>
                    <small class="text-muted font-monospace fw-bold text-primary" style="font-size: 10px;">Wed</small>
                </div>
                <div class="text-center" style="width: 14%;">
                    <div style="height: 60px; border: 1.5px solid #00B4D8; background: rgba(0,180,216,0.15); border-radius: 4px;"></div>
                    <small class="text-muted font-monospace" style="font-size: 10px;">Thu</small>
                </div>
                <div class="text-center" style="width: 14%;">
                    <div style="height: 20px; border: 1.5px solid #64748B; background: rgba(100,116,139,0.1); border-radius: 4px;"></div>
                    <small class="text-muted font-monospace" style="font-size: 10px;">Fri</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- RECENT LABORATORY ORDERS TABLE -->
<div class="mdb-analytics-card">
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <h5 class="fw-bold mb-0 d-flex align-items-center gap-2">
                <i class="fas fa-list-check text-primary"></i>
                <span>أحدث طلبات المختبر اليوم (Recent Activity)</span>
            </h5>
            <small class="text-muted">المرضى المسجلين اليوم وحالة العينات المباشرة</small>
        </div>
        <div class="d-flex gap-2">
            <a href="orders" class="btn btn-primary btn-sm px-3" data-mdb-ripple-init>
                <i class="fas fa-plus me-1"></i> تسجيل طلب جديد
            </a>
            <a href="worklist" class="btn btn-outline-secondary btn-sm px-3" data-mdb-ripple-init>
                <i class="fas fa-vial me-1"></i> قائمة العمل
            </a>
        </div>
    </div>

    @if (RecentOrders == null)
    {
        <div class="text-center py-4 text-muted">
            <div class="spinner-border spinner-border-sm text-primary mb-2" role="status"></div>
            <div>جاري تحميل بيانات لوحة المؤشرات...</div>
        </div>
    }
    else if (!RecentOrders.Any())
    {
        <div class="alert alert-info py-3 text-center my-2">
            <i class="fas fa-info-circle me-1"></i> لم يتم تسجيل أي طلبات للمختبر حتى الآن اليوم. اضغط "تسجيل طلب جديد" للبدء.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr class="text-muted small text-uppercase">
                        <th>رقم الطلب</th>
                        <th>الوقت</th>
                        <th>اسم المريض</th>
                        <th>رقم الملف (MRN)</th>
                        <th>الهاتف</th>
                        <th>الحالة المخبرية</th>
                        <th>المبلغ الإجمالي</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in RecentOrders.Take(8))
                    {
                        long id = Convert.ToInt64(order.id);
                        string fullName = order.full_name_ar?.ToString() ?? "";
                        string mrn = order.mrn?.ToString() ?? "";
                        string phone = order.phone?.ToString() ?? "--";
                        string status = order.status?.ToString() ?? "";
                        var total = ToDecimal(order.total_amount);
                        <tr>
                            <td class="fw-bold text-primary font-monospace">#@id</td>
                            <td class="small font-monospace text-muted">@FormatDateTime(order.order_datetime)</td>
                            <td class="fw-bold">@fullName</td>
                            <td class="font-monospace text-secondary">@mrn</td>
                            <td class="small font-monospace text-muted">@phone</td>
                            <td>
                                <span class="badge-status @GetStatusClass(status)">
                                    @status
                                </span>
                            </td>
                            <td class="fw-bold text-success font-monospace">@total.ToString("N0") د.ع</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private int TodayOrdersCount = 0;
    private int InProgressCount = 0;
    private int ValidatedCount = 0;
    private decimal TotalIncome = 0;
    private List<dynamic>? RecentOrders;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var orders = (await OrderService.GetOrdersListAsync(date: DateTime.Today, limit: 100)).ToList();
            RecentOrders = orders;
            TodayOrdersCount = orders.Count;
            InProgressCount = orders.Count(o => (string)o.status == "InProgress" || (string)o.status == "Collected");
            ValidatedCount = orders.Count(o => (string)o.status == "Validated");

            var cashReport = await BillingService.GetDailyCashReportAsync(DateTime.Today);
            TotalIncome = cashReport.TotalCollected;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Dashboard Error] {ex.Message}");
        }
    }

    private static decimal ToDecimal(object? val)
    {
        if (val == null || val is DBNull) return 0m;
        if (val is decimal d) return d;
        if (decimal.TryParse(val.ToString(), out var parsed)) return parsed;
        return 0m;
    }

    private static string FormatDateTime(object? val, string format = "dd/MM/yyyy HH:mm")
    {
        if (val == null || val is DBNull) return "--";
        if (val is DateTime dt) return dt.ToString(format);
        if (DateTime.TryParse(val.ToString(), out var parsed)) return parsed.ToString(format);
        return "--";
    }

    private string GetStatusClass(string status) => status?.ToLower() switch
    {
        "ordered" => "badge-ordered",
        "collected" => "badge-collected",
        "inprogress" => "badge-inprogress",
        "resultreceived" => "badge-resultreceived",
        "validated" => "badge-validated",
        "rejected" => "badge-rejected",
        _ => "badge-secondary"
    };

    protected override void OnInitialized()
    {
        Prefs.OnChange += OnPrefsChanged;
    }

    private void OnPrefsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Prefs.OnChange -= OnPrefsChanged;
    }
}