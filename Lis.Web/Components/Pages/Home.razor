@code {
    private int TodayOrdersCount = 0;
    private int InProgressCount = 0;
    private int ValidatedCount = 0;
    private decimal TotalIncome = 0;
    private List<dynamic>? RecentOrders;
    private bool IsLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardDataAsync();
    }

    private async Task ReloadData()
    {
        IsLoading = true;
        StateHasChanged();
        await LoadDashboardDataAsync();
    }

    private async Task LoadDashboardDataAsync()
    {
        try
        {
            var allOrders = (await OrderService.GetOrdersListAsync(limit: 100)).ToList();
            var todayOrders = allOrders.Where(o => {
                var dt = o.order_datetime as DateTime?;
                return dt.HasValue && dt.Value.Date == DateTime.Today;
            }).ToList();

            if (todayOrders.Any())
            {
                RecentOrders = todayOrders;
                TodayOrdersCount = todayOrders.Count;
                InProgressCount = todayOrders.Count(o => (string)o.status == "InProgress" || (string)o.status == "Collected");
                ValidatedCount = todayOrders.Count(o => (string)o.status == "Validated");
            }
            else
            {
                // Fallback to recent system records if no orders registered yet today
                RecentOrders = allOrders;
                TodayOrdersCount = allOrders.Count;
                InProgressCount = allOrders.Count(o => (string)o.status == "InProgress" || (string)o.status == "Collected");
                ValidatedCount = allOrders.Count(o => (string)o.status == "Validated");
            }

            var cashReport = await BillingService.GetDailyCashReportAsync(DateTime.Today);
            TotalIncome = cashReport.TotalCollected;
            if (TotalIncome == 0 && RecentOrders.Any())
            {
                TotalIncome = RecentOrders.Sum(o => ToDecimal(o.total_amount));
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Dashboard Error] {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private static decimal ToDecimal(object? val)
    {
        if (val == null || val is DBNull) return 0m;
        if (val is decimal d) return d;
        if (decimal.TryParse(val.ToString(), out var parsed)) return parsed;
        return 0m;
    }

    private static string FormatDateTime(object? val, string format = "dd/MM/yyyy HH:mm")
    {
        if (val == null || val is DBNull) return "--";
        if (val is DateTime dt) return dt.ToString(format);
        if (DateTime.TryParse(val.ToString(), out var parsed)) return parsed.ToString(format);
        return "--";
    }

    private string GetStatusClass(string status) => status?.ToLower() switch
    {
        "ordered" => "badge-ordered",
        "collected" => "badge-collected",
        "inprogress" => "badge-inprogress",
        "resultreceived" => "badge-resultreceived",
        "validated" => "badge-validated",
        "rejected" => "badge-rejected",
        _ => "badge-secondary"
    };

    private string GetStatusDisplay(string status) => status?.ToLower() switch
    {
        "ordered" => Prefs.T("مسجل", "Ordered"),
        "collected" => Prefs.T("تم السحب", "Collected"),
        "inprogress" => Prefs.T("قيد التحليل", "In Progress"),
        "resultreceived" => Prefs.T("وارد من الجهاز", "Result In"),
        "validated" => Prefs.T("معتمد ومكتمل", "Validated"),
        "rejected" => Prefs.T("مرفوض", "Rejected"),
        _ => status
    };

    protected override void OnInitialized()
    {
        Prefs.OnChange += OnPrefsChanged;
    }

    private void OnPrefsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Prefs.OnChange -= OnPrefsChanged;
    }
}
