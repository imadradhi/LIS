@inject UserPreferencesService Prefs
@inject AuthSessionService AuthSession
@inject IJSRuntime JS
@implements IDisposable

<div class="nav-medlab-container">
    <!-- Brand Logo -->
    <a href="" class="nav-medlab-brand" title="MedLab LIS">
        <i class="fas fa-flask"></i>
        <span>MedLab</span>
    </a>

    <!-- Nav Items -->
    <div class="nav-medlab-list">
        <NavLink class="nav-medlab-item" href="" Match="NavLinkMatch.All" title="@Prefs.T("لوحة المؤشرات", "Dashboard")">
            <i class="fas fa-chart-line"></i>
            <span>@Prefs.T("الرئيسية", "Dashboard")</span>
        </NavLink>

        <NavLink class="nav-medlab-item" href="orders" Match="NavLinkMatch.Prefix" title="@Prefs.T("المرضى والطلبات", "Patients")">
            <i class="fas fa-user-friends"></i>
            <span>@Prefs.T("المرضى", "Patients")</span>
        </NavLink>

        <NavLink class="nav-medlab-item" href="worklist" Match="NavLinkMatch.Prefix" title="@Prefs.T("العينات", "Samples")">
            <i class="fas fa-tint"></i>
            <span>@Prefs.T("العينات", "Samples")</span>
        </NavLink>

        <NavLink class="nav-medlab-item" href="catalog" Match="NavLinkMatch.Prefix" title="@Prefs.T("التحاليل", "Tests")">
            <i class="fas fa-vial"></i>
            <span>@Prefs.T("التحاليل", "Tests")</span>
        </NavLink>

        <NavLink class="nav-medlab-item" href="results" Match="NavLinkMatch.Prefix" title="@Prefs.T("النتائج والاعتماد", "Results")">
            <i class="fas fa-check-circle"></i>
            <span>@Prefs.T("النتائج", "Results")</span>
        </NavLink>

        <NavLink class="nav-medlab-item" href="instruments" Match="NavLinkMatch.Prefix" title="@Prefs.T("الأجهزة", "Instruments")">
            <i class="fas fa-desktop"></i>
            <span>@Prefs.T("الأجهزة", "Instruments")</span>
        </NavLink>

        <NavLink class="nav-medlab-item" href="billing" Match="NavLinkMatch.Prefix" title="@Prefs.T("التقارير والمالية", "Reports")">
            <i class="fas fa-chart-bar"></i>
            <span>@Prefs.T("التقارير", "Reports")</span>
        </NavLink>

        <NavLink class="nav-medlab-item" href="qc" Match="NavLinkMatch.Prefix" title="@Prefs.T("ضبط الجودة", "QC")">
            <i class="fas fa-chart-area"></i>
            <span>@Prefs.T("الجودة", "QC")</span>
        </NavLink>

        <NavLink class="nav-medlab-item" href="settings" Match="NavLinkMatch.Prefix" title="@Prefs.T("الإعدادات", "Settings")">
            <i class="fas fa-cog"></i>
            <span>@Prefs.T("الإعدادات", "Settings")</span>
        </NavLink>

        <button type="button" class="nav-medlab-item text-danger border-0 bg-transparent w-100 text-start mt-2" 
                @onclick="HandleLogout" title="@Prefs.T("تسجيل الخروج من النظام", "Sign Out")" style="cursor: pointer;">
            <i class="fas fa-arrow-right-from-bracket"></i>
            <span>@Prefs.T("خروج", "Sign Out")</span>
        </button>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        Prefs.OnChange += OnPrefsChanged;
    }

    private void OnPrefsChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleLogout()
    {
        bool confirmed = await JS.InvokeAsync<bool>("lisConfirm", Prefs.T("هل أنت متأكد من رغبتك في تسجيل الخروج من النظام السريري؟", "Are you sure you want to sign out from the clinical system?"));
        if (confirmed)
        {
            await AuthSession.LogoutAsync();
        }
    }

    public void Dispose()
    {
        Prefs.OnChange -= OnPrefsChanged;
    }
}
