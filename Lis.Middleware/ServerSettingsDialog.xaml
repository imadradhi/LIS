<Window x:Class="Lis.Middleware.ServerSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعدادات الاتصال بالسيرفر — Database Server Settings"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="LeftToRight"
        Background="{DynamicResource AppBackgroundBrush}">

    <Border Padding="24">
        <Border Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="22,18">

            <StackPanel>
                <!-- Header -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="{DynamicResource PrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="🗄️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Database Server Settings (PostgreSQL)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Configure server host, port, and credentials for Middleware connection" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,14"/>

                <!-- Server Host & Port Row -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Host / IP -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Server Host / IP:" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtServerHost" Height="36" FontSize="13.5" Padding="8,4" Text="192.168.0.2"/>
                    </StackPanel>

                    <!-- Port -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Port:" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtServerPort" Height="36" FontSize="13.5" Padding="8,4" Text="5432"/>
                    </StackPanel>
                </Grid>

                <!-- Database Name -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Database Name:" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtDatabaseName" Height="36" FontSize="13.5" Padding="8,4" Text="lis_db"/>
                </StackPanel>

                <!-- Username & Password Row -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Username -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Username:" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtUsername" Height="36" FontSize="13.5" Padding="8,4" Text="postgres"/>
                    </StackPanel>

                    <!-- Password -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Password:" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="TxtPassword" Height="36" FontSize="13.5" Padding="8,4"
                                     Background="{DynamicResource InputBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"/>
                    </StackPanel>
                </Grid>

                <!-- Status Feedback Banner -->
                <Border x:Name="BdrTestStatus" CornerRadius="8" Padding="12,10" Margin="0,0,0,14" Visibility="Collapsed">
                    <TextBlock x:Name="TxtTestStatus" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"/>
                </Border>

                <!-- Buttons Bar -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="BtnTest" Content="🔌 Test Connection"
                            Style="{DynamicResource SecondaryButtonStyle}" Padding="14,7" FontSize="12.5" FontWeight="SemiBold"
                            Click="BtnTest_Click"/>

                    <Button Grid.Column="2" x:Name="BtnSave" Content="💾 Save Settings"
                            Style="{DynamicResource SecondaryButtonStyle}" Padding="16,7" FontSize="12.5" FontWeight="Bold" Margin="0,0,8,0"
                            Click="BtnSave_Click"/>

                    <Button Grid.Column="3" Content="Close"
                            Style="{DynamicResource SecondaryButtonStyle}" Padding="14,7" FontSize="12.5"
                            Click="BtnCancel_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Border>
</Window>

